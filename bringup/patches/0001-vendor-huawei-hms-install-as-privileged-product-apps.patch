From f93717ca8e40f560ebf0a259d98e26aa4cd13518 Mon Sep 17 00:00:00 2001
From: desmond <h.liu@vu.nl>
Date: Mon, 7 Sep 2026 22:52:27 +0200
Subject: [PATCH] Install AppGallery and HMS Core as privileged product apps

The owner wants both treated as system components on a personal handset. This
reverses the placement decision this file used to argue for, and the header now
records that it was reversed deliberately rather than reading as though
priv-app had always been intended.

LOCAL_PRIVILEGED_MODULE alone is not the whole move: the JNI libraries are
installed as their own modules beside the APK, because
LOCAL_REPLACE_PREBUILT_APK_INSTALLED keeps each APK byte-identical and so
nothing extracts them. Their LOCAL_MODULE_PATH has to follow the APK to
priv-app, since setNativeLibraryPaths() derives nativeLibraryRootDir from the
package's own code path.

Privileged permissions come from the whitelist in the device tree at
permissions/privapp-permissions-huawei.xml, which must be installed to
/product: PermissionManagerService picks the whitelist by partition and
pkg.isProduct() only ever consults the map SystemConfig fills from
/product/etc/permissions.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01VrmYGsZmVgYKRTXPSLuvVG
---
 Android.mk | 34 +++++++++++++++++++++++++++++-----
 1 file changed, 29 insertions(+), 5 deletions(-)

diff --git a/Android.mk b/Android.mk
index 8367a7a..375c814 100644
--- a/Android.mk
+++ b/Android.mk
@@ -1,9 +1,31 @@
 LOCAL_PATH := $(call my-dir)
 
-# Huawei AppGallery and HMS Core, shipped as ordinary product apps. Installing
-# third-party Huawei-signed code as priv-app would grant platform package/user/
-# telephony/Wi-Fi/reset powers unrelated to the requested app-store/account
-# functionality.
+# Huawei AppGallery and HMS Core, shipped as privileged product apps.
+#
+# This file previously installed them as ordinary product apps, on the argument
+# that priv-app would hand third-party Huawei-signed code package/user/
+# telephony/Wi-Fi/reset powers its app-store and account features do not need.
+# That argument was sound but it was not the owner's; the owner wants both
+# treated as system components on a personal handset, and has said so.
+#
+# What actually changes: privileged permissions are granted from the
+# privapp-permissions whitelist in
+# device/xsh/k50sv1_64_bsp/permissions/privapp-permissions-huawei.xml. That
+# file has to be on /product, because PermissionManagerService selects the
+# whitelist by partition -- pkg.isProduct() reaches
+# SystemConfig.getProductPrivAppPermissions(), populated only from
+# /product/etc/permissions (SystemConfig.java:874). A copy on /system would be
+# parsed into the wrong map and silently ignored.
+#
+# The concrete gain is INSTALL_PACKAGES and DELETE_PACKAGES, both
+# signature|privileged, which let AppGallery install and update without the
+# per-install "unknown apps" prompt. Nine permissions each APK requests are
+# plain `signature` (MANAGE_APPOPS, MANAGE_DEVICE_ADMINS, CREATE_USERS,
+# INTERNAL_SYSTEM_WINDOW, STATUS_BAR_SERVICE, READ_FRAME_BUFFER, ...) and stay
+# denied: priv-app does not grant those, only the platform signature does, and
+# re-signing these APKs is not possible without breaking their v2/v3 blocks.
+# ro.control_privapp_permissions is `log` on this product, so a permission that
+# is requested but not whitelisted is logged and denied rather than fatal.
 #
 # LOCAL_REPLACE_PREBUILT_APK_INSTALLED keeps each APK BYTE-IDENTICAL to its
 # Huawei-signed input, and that is not a nicety here. Both APKs carry an APK
@@ -38,7 +60,7 @@ $(eval LOCAL_MODULE_TAGS := optional) \
 $(eval LOCAL_MODULE_CLASS := ETC) \
 $(eval LOCAL_MODULE_STEM := $(2)) \
 $(eval LOCAL_SRC_FILES := proprietary/product/priv-app/$(1)/lib/arm64/$(2)) \
-$(eval LOCAL_MODULE_PATH := $(TARGET_OUT_PRODUCT)/app/$(1)/lib/arm64) \
+$(eval LOCAL_MODULE_PATH := $(TARGET_OUT_PRODUCT)/priv-app/$(1)/lib/arm64) \
 $(eval include $(BUILD_PREBUILT))
 endef
 
@@ -70,6 +92,7 @@ LOCAL_MODULE_CLASS := APPS
 LOCAL_MODULE_SUFFIX := $(COMMON_ANDROID_PACKAGE_SUFFIX)
 LOCAL_CERTIFICATE := PRESIGNED
 LOCAL_PRODUCT_MODULE := true
+LOCAL_PRIVILEGED_MODULE := true
 LOCAL_DEX_PREOPT := false
 LOCAL_REQUIRED_MODULES := $(foreach f,$(appgallery_jni),huawei-AppGallery-$(f))
 include $(BUILD_PREBUILT)
@@ -82,6 +105,7 @@ LOCAL_MODULE_CLASS := APPS
 LOCAL_MODULE_SUFFIX := $(COMMON_ANDROID_PACKAGE_SUFFIX)
 LOCAL_CERTIFICATE := PRESIGNED
 LOCAL_PRODUCT_MODULE := true
+LOCAL_PRIVILEGED_MODULE := true
 LOCAL_DEX_PREOPT := false
 LOCAL_REQUIRED_MODULES := $(foreach f,$(hmscore_jni),huawei-HMSCore-$(f))
 include $(BUILD_PREBUILT)
-- 
