    "exit_code": 0
  },
  {
    "name": "search-package-isolated",
    "command": "dumpsys package com.google.android.googlequicksearchbox",
    "exit_code": 0
  },
  {
    "name": "restore-component-default",
    "command": "pm default-state --user 0 com.google.android.googlequicksearchbox/com.google.android.voiceinteraction.GsaVoiceInteractionService",
    "exit_code": 0
  },
  {
    "name": "restore-assistant",
    "command": "settings put secure assistant ''",
    "exit_code": 0
  },
  {
    "name": "restore-voice_recognition_service",
    "command": "settings put secure voice_recognition_service com.google.android.googlequicksearchbox/com.google.android.voicesearch.serviceapi.GoogleRecognitionService",
    "exit_code": 0
  },
  {
    "name": "restore-voice_interaction_service",
    "command": "settings put secure voice_interaction_service com.google.android.googlequicksearchbox/com.google.android.voiceinteraction.GsaVoiceInteractionService",
    "exit_code": 0
  },
  {
    "name": "restore-search-availability",
    "command": "am start -W -n com.google.android.googlequicksearchbox/.SearchActivity",
    "exit_code": 0
  },
  {
    "name": "search-package-restored",
