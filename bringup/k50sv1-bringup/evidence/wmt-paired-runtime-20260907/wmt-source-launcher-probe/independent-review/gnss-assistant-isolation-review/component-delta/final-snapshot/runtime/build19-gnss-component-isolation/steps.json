[
  {
    "name": "identity",
    "command": "cat /proc/sys/kernel/random/boot_id; getprop ro.build.version.incremental; cat /proc/sys/kernel/tainted",
    "exit_code": 0
  },
  {
    "name": "roles-before",
    "command": "cat /data/system/users/0/roles.xml",
    "exit_code": 0
  },
  {
    "name": "roles-live-before",
    "command": "dumpsys role",
    "exit_code": 0
  },
  {
    "name": "before-assistant",
    "command": "settings get secure assistant",
    "exit_code": 0
  },
  {
    "name": "before-voice_recognition_service",
    "command": "settings get secure voice_recognition_service",
    "exit_code": 0
  },
  {
    "name": "before-voice_interaction_service",
    "command": "settings get secure voice_interaction_service",
    "exit_code": 0
  },
  {
    "name": "search-package-before",
    "command": "dumpsys package com.google.android.googlequicksearchbox",
    "exit_code": 0
  },
  {
    "name": "pause-observed-component",
