From 8073ff9401b3f9d2222e05bc8a61d176a517c2c9 Mon Sep 17 00:00:00 2001
From: Huixiaqing Liu <huixiaqingliu@outlook.com>
Date: Mon, 7 Sep 2026 09:05:19 +0200
Subject: [PATCH 18/25] fstab: exclude calibration stores from vold trim in
 every tier

---
 rootdir/etc/fstab.mt6755      | 11 ++++++-----
 sepolicy/nvram/vendor/file.te | 19 +++----------------
 2 files changed, 9 insertions(+), 21 deletions(-)

diff --git a/rootdir/etc/fstab.mt6755 b/rootdir/etc/fstab.mt6755
index 0e355dd..c5a0fc5 100644
--- a/rootdir/etc/fstab.mt6755
+++ b/rootdir/etc/fstab.mt6755
@@ -72,17 +72,18 @@
 # MTK radio/calibration data filesystems. Never auto-format these identity and
 # calibration stores: an unreadable filesystem must fail visibly and be
 # restored from the verified backup, not be silently replaced with an empty one.
-# nvdata also deliberately omits online `discard`; policy refuses vold FITRIM
-# for the same reason, so both trim paths follow one invariant.
+# Omit online discard and set fs_mgr notrim for all three stores. Android Q
+# vold reads this fstab flag before adding idle-maintenance trim targets, so
+# they remain excluded in both permissive and enforcing diagnostic modes.
 # `nofail` is what keeps that visible instead of fatal: without it a mount
 # failure makes fs_mgr_mount_all return FS_MGR_MNTALL_FAIL and init's
 # queue_fs_event() then queues NO trigger at all -- not `nonencrypted`, not
 # `encryption_failed` -- so a corrupt calibration partition would leave the
 # handset with no framework and nothing naming the cause. Same mechanism as the
 # userdata note above; this is not the old FDE path, which this file removed.
-/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/protect1  /mnt/vendor/protect_f ext4  noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc  wait,check,nofail
-/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/protect2  /mnt/vendor/protect_s ext4  noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc  wait,check,nofail
-/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvdata    /mnt/vendor/nvdata    ext4  noatime,nosuid,nodev,noauto_da_alloc,commit=1             wait,check,nofail
+/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/protect1  /mnt/vendor/protect_f ext4  noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc  wait,check,nofail,notrim
+/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/protect2  /mnt/vendor/protect_s ext4  noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc  wait,check,nofail,notrim
+/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvdata    /mnt/vendor/nvdata    ext4  noatime,nosuid,nodev,noauto_da_alloc,commit=1             wait,check,nofail,notrim
 
 # Removable storage
 /devices/mtk-msdc.0/11240000.msdc1*                             auto                  auto  defaults                                    voldmanaged=sdcard1:auto,encryptable=userdata
diff --git a/sepolicy/nvram/vendor/file.te b/sepolicy/nvram/vendor/file.te
index 892aa5e..170547d 100644
--- a/sepolicy/nvram/vendor/file.te
+++ b/sepolicy/nvram/vendor/file.te
@@ -25,19 +25,6 @@ type mtk_camera_nvram_file, file_type, data_file_type, mtk_nvram_storage_file, m
 # sepolicy/attributes/attributes.te. Each storage type joins it directly in its
 # own declaration, including the six types above.
 
-# DELIBERATELY LEFT DENIED: vold on /mnt/vendor/nvdata and /mnt/vendor/protect_f.
-#
-#   avc: denied { ioctl } path="/mnt/vendor/nvdata"   ioctlcmd=5879 scontext=u:r:vold:s0
-#   avc: denied { ioctl } path="/mnt/vendor/protect_f" ioctlcmd=5879 scontext=u:r:vold:s0
-#   (plus the open/read that precede them)
-#
-# 0x5879 is the low half of FITRIM (0xC0185879). This is vold's idle-maintenance
-# pass walking /proc/mounts and trimming every mounted filesystem. Granting it
-# would work and would silence the log, and it is still the wrong answer here:
-# these two partitions hold the IMEI, the RF calibration and the protect keys,
-# there is no factory server to restore them from, and scope.md's flash policy
-# exists precisely to keep every write path away from them. Two small,
-# almost-static filesystems gain nothing from a trim.
-#
-# vold's IdleMaint just logs and continues on EACCES, so the cost of leaving
-# this denied is the log line. Everything else on the device still trims.
+# The fstab notrim flag excludes nvdata/protect from vold's maintenance list
+# in every tier. Keep vold's FITRIM/open access ungranted as a separate boundary
+# for unexpected requests; routine maintenance must not rely on a denied ioctl.
-- 
