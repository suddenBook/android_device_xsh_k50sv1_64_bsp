From 45b0003fc0bfac5cda23c036aa7589122712d65e Mon Sep 17 00:00:00 2001
From: Huixiaqing Liu <huixiaqingliu@outlook.com>
Date: Mon, 7 Sep 2026 08:06:55 +0200
Subject: [PATCH 09/25] sepolicy: allow Power HAL to verify camera hint
 ownership

---
 sepolicy/power/hal_power_default.te | 17 ++++++-----------
 1 file changed, 6 insertions(+), 11 deletions(-)

diff --git a/sepolicy/power/hal_power_default.te b/sepolicy/power/hal_power_default.te
index 7840a9a..882c36d 100644
--- a/sepolicy/power/hal_power_default.te
+++ b/sepolicy/power/hal_power_default.te
@@ -103,14 +103,9 @@ get_prop(hal_power_default, mtk_thermal_config_prop)
 # unaudited path into the radio stack is exactly the boundary crossing the
 # /dev/wmtWifi note above rejects.
 
-# NOT GRANTED: hal_power_default x <caller domain>:dir getattr.
-# libpowerhal formats "/proc/%d" and "/proc/%d/comm" to name the process behind
-# a perf hint, so it stats the caller's proc dir; observed twice as
-# `mtkPowerManager` on /proc/<camerahalserver>. That lookup exists to match a
-# process name against the per-application boost table in
-# power_whitelist_cfg.xml, and this build ships that table DELIBERATELY EMPTY
-# (see configs/power_whitelist_cfg.xml). Nothing else consumes the name -- the
-# AOSP POWER_HINT_* scenarios in powerscntbl.xml are keyed by hint, not by
-# caller. Granting it would mean `allow hal_power_default domain:dir getattr`,
-# because the caller can be any client, and that is a wide grant to buy a log
-# line. Revisit only if a real per-application entry is ever added.
+# perfUserScnCheckAll stats /proc/<camera-provider-pid> to check the owner of
+# an active performance request. On any stat error it disables and resets the
+# request, independently of power_whitelist_cfg.xml. The service also needs
+# readproc in init because /proc uses hidepid=2. Allow metadata for the observed
+# camera provider only; this does not grant reading its proc files.
+allow hal_power_default hal_camera_default:dir getattr;
-- 
