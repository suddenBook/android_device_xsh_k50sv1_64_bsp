From e577ac2ed26c1977abd2179eba4ec60d39a31172 Mon Sep 17 00:00:00 2001
From: Huixiaqing Liu <huixiaqingliu@outlook.com>
Date: Mon, 7 Sep 2026 07:47:34 +0200
Subject: [PATCH 02/25] sepolicy: label physical WLAN network attributes with
 sysfs_net

---
 sepolicy/connectivity/genfs_contexts | 5 +++++
 1 file changed, 5 insertions(+)
 create mode 100644 sepolicy/connectivity/genfs_contexts

diff --git a/sepolicy/connectivity/genfs_contexts b/sepolicy/connectivity/genfs_contexts
new file mode 100644
index 0000000..1c09798
--- /dev/null
+++ b/sepolicy/connectivity/genfs_contexts
@@ -0,0 +1,5 @@
+# Physical WLAN interfaces live below the platform device, outside AOSP's
+# /devices/virtual/net label. Use the standard type for the entire net subtree
+# so its existing network clients can read type/address/mtu without generic
+# sysfs access. The surrounding Wi-Fi driver controls keep their own labels.
+genfscon sysfs /devices/soc/180f0000.wifi/net u:object_r:sysfs_net:s0
-- 
2.55.0

