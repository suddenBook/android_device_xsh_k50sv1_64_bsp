From 2fe5ba1184109db5b2c102a7ebe5e865dbb9fb6d Mon Sep 17 00:00:00 2001
From: Huixiaqing Liu <huixiaqingliu@outlook.com>
Date: Mon, 7 Sep 2026 08:15:49 +0200
Subject: [PATCH 14/25] sepolicy: document isolated modem version diagnostics

---
 sepolicy/radio/mtkrild.te | 15 ++++-----------
 1 file changed, 4 insertions(+), 11 deletions(-)

diff --git a/sepolicy/radio/mtkrild.te b/sepolicy/radio/mtkrild.te
index 53e0a4c..dc74b4c 100644
--- a/sepolicy/radio/mtkrild.te
+++ b/sepolicy/radio/mtkrild.te
@@ -69,14 +69,7 @@ get_prop(mtkrild, mtk_radio_config_prop)
 # domain.te:525, which does compile. See sepolicy/vendor/property.te.
 set_prop(mtkrild, mtk_ril_cdma_prop)
 
-# DELIBERATELY LEFT DENIED, so that a future session does not "fix" it:
-#   avc:  denied  { set } for property=gsm.version.ril-impl
-#         scontext=u:r:mtkrild:s0 tcontext=u:object_r:radio_prop:s0
-#         tclass=property_service
-# hardware/ril/libril/ril.cpp:72 writes it from RIL_register. AOSP grants
-# radio_prop:property_service set only to hal_telephony_server
-# (public/hal_telephony.te:23) and radio (public/radio.te:20); mtkrild is
-# neither. Closing it would mean either giving a vendor daemon the whole
-# radio_prop namespace or promoting mtkrild to hal_telephony_server -- and the
-# value is dead either way: frameworks declares it once, at
-# TelephonyProperties.java:39 as PROPERTY_RIL_IMPL, and never reads it.
+# The modem library's implementation-version diagnostic is rewritten by
+# extract-files.sh to vendor.ril.impl, covered by mtk_vendor_radio_prop above.
+# The framework-facing RIL proxy still owns gsm.version.ril-impl. Do not grant
+# this vendor modem daemon the broad AOSP radio_prop namespace for diagnostics.
-- 
