From 5b0376c78d2d06f2ef4c1792a13a421d56cd6250 Mon Sep 17 00:00:00 2001
From: Huixiaqing Liu <huixiaqingliu@outlook.com>
Date: Mon, 7 Sep 2026 08:18:13 +0200
Subject: [PATCH 15/25] sepolicy: correct the observed fuel gauge socket
 protocol

---
 sepolicy/safety/fuelgauged.te | 31 ++++++++-----------------------
 1 file changed, 8 insertions(+), 23 deletions(-)

diff --git a/sepolicy/safety/fuelgauged.te b/sepolicy/safety/fuelgauged.te
index 51fedc0..707c651 100644
--- a/sepolicy/safety/fuelgauged.te
+++ b/sepolicy/safety/fuelgauged.te
@@ -12,28 +12,13 @@ allow fuelgauged self:netlink_route_socket { nlmsg_read nlmsg_write };
 
 r_dir_file(fuelgauged, sysfs_batteryinfo)
 
-# REVIEWED, kept, AND NOW INSTRUMENTED: the netlink_route_socket grant above
-# includes nlmsg_write, the ability to send route-modifying netlink messages --
-# more than a fuel-gauge daemon should plausibly need, and Stock grants
-# fuelgauged no netlink_route at all. The live check was inconclusive rather
-# than negative: on the handset fuelgauged holds only unix sockets open, but a
-# periodic poller can create and close a netlink socket between samples.
-# Narrowing on that would be guessing.
-#
-# The auditallow below settles it and does not need Tier 2 -- auditallow logs
-# GRANTED accesses under permissive too, which is how WI-067 was closed from
-# three Tier-1 captures (E-150).
-#
-# FIRST READING, PARTIAL: zero records over 14 minutes of the session-17 image
-# including a full boot, with fuelgauged running the whole time (E-152). That is
-# suggestive and NOT yet enough -- this daemon is a periodic poller and the note
-# above is explicitly about a socket it might create and close between samples.
-# Do not narrow on fourteen minutes. Soak a boot-to-idle window of hours, and
-# note that the mnld half of the same experiment produced nothing across boot
-# and six records the instant its feature was used.
-#
-# THEN: if create never fires, delete both netlink_route grants; if create fires
-# but nlmsg_write does not, keep create_socket_perms and drop nlmsg_write. Then
-# delete this block.
+# The route grant remains under review. Build19's live FD is NETLINK_FGD (26),
+# not NETLINK_ROUTE (0): libfgauge's init_socket calls socket(AF_NETLINK,
+# SOCK_DGRAM, 26), matching the battery driver. The former "only unix sockets"
+# observation was incomplete. No route create/write audit appeared during the
+# reviewed boot and idle interval; charge/discharge transitions remain untested.
+# auditallow records granted accesses in permissive too. Remove the route
+# grants after covering the remaining battery lifecycle, or retain only the
+# operations actually observed; nlmsg_write is broader than gauge telemetry.
 auditallow fuelgauged self:netlink_route_socket create;
 auditallow fuelgauged self:netlink_route_socket nlmsg_write;
-- 
