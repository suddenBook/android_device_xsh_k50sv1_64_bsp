From 806bdae8b1d403dfcc6785a0bb8cf34bc294b28b Mon Sep 17 00:00:00 2001
From: Huixiaqing Liu <huixiaqingliu@outlook.com>
Date: Mon, 7 Sep 2026 07:47:34 +0200
Subject: [PATCH 03/25] sepolicy: correct wfca credential and DAC diagnosis
 comments

---
 sepolicy/vowifi/wfca.te | 24 +++++++-----------------
 1 file changed, 7 insertions(+), 17 deletions(-)

diff --git a/sepolicy/vowifi/wfca.te b/sepolicy/vowifi/wfca.te
index 7b271e5..54ee2f4 100644
--- a/sepolicy/vowifi/wfca.te
+++ b/sepolicy/vowifi/wfca.te
@@ -27,7 +27,8 @@ allow wfca self:packet_socket { create read setopt };
 # The IMS application channel to the modem.
 allow wfca mtk_ccci_ims_device:chr_file rw_file_perms;
 
-# It drops from root to its own uid/gids after opening the modem node.
+# Legacy startup may set uid/gids; build19 retains uid 0 after opening the
+# modem node. Do not describe this process as having dropped root.
 allow wfca self:global_capability_class_set { setgid setuid };
 
 # Binding a raw socket and setting SO_MARK on it both need these.
@@ -58,19 +59,8 @@ get_prop(wfca, mtk_ims_prop)
 get_prop(wfca, mtk_ims_feature_prop)
 get_prop(wfca, mtk_vendor_radio_prop)
 
-# NO `dontaudit wfca self:capability dac_override`, and it DID appear:
-#
-#   avc: denied { dac_override } for comm="wfca" capability=1
-#        scontext=u:r:wfca:s0 tcontext=u:r:wfca:s0 tclass=capability
-#
-# once per boot, and it is deliberately NOT granted. Stock `dontaudit`s it,
-# which is not the same as allowing it -- Stock's compiled policy has no
-# `allow wfca self:capability dac_override` either, so Stock runs this daemon
-# WITHOUT the capability under enforcing and WFC works there. Silencing it here
-# would have hidden that fact rather than established it, which is why this
-# tree does not dontaudit.
-#
-# What it means: wfca is root and touched something whose mode it does not
-# satisfy. Under enforcing the request fails and root's other privileges carry
-# it through, exactly as on Stock. If a real failure ever traces back to this,
-# the fix is a mode or ownership change in init.wfca.rc, not a capability.
+# No dac_override grant or suppression. Build19's boot denial accompanies
+# O_RDWR FDs for /sys/power/wake_{lock,unlock}, mode 0660 radio:wakelock, while
+# wfca lacks the wakelock group. init.wfca.rc supplies that supplementary group;
+# verify the denial is gone after restarting with the corrected credentials.
+# UID 0 does not bypass a denied capability under Enforcing.
-- 
