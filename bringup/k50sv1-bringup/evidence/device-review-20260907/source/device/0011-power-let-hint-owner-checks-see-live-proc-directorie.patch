From 5c541ea4bc9caaa0aec9e3d3a87fb19ac1a95f5f Mon Sep 17 00:00:00 2001
From: Huixiaqing Liu <huixiaqingliu@outlook.com>
Date: Mon, 7 Sep 2026 08:09:41 +0200
Subject: [PATCH 11/25] power: let hint owner checks see live proc directories

---
 .../vendor.mediatek.hardware.mtkpower@1.0-service.rc  | 11 +++--------
 1 file changed, 3 insertions(+), 8 deletions(-)

diff --git a/rootdir/etc/init/vendor.mediatek.hardware.mtkpower@1.0-service.rc b/rootdir/etc/init/vendor.mediatek.hardware.mtkpower@1.0-service.rc
index 04e3592..132f395 100644
--- a/rootdir/etc/init/vendor.mediatek.hardware.mtkpower@1.0-service.rc
+++ b/rootdir/etc/init/vendor.mediatek.hardware.mtkpower@1.0-service.rc
@@ -1,11 +1,6 @@
 service power-hal-1-0 /vendor/bin/hw/vendor.mediatek.hardware.mtkpower@1.0-service
     class hal
     user system
-    group system wifi
-
-# Stock's `on property:vold.decrypt=trigger_shutdown_framework / setprop
-# vendor.powerhal.init 0` is deliberately not here. vold.decrypt is written
-# only from inside the FDE flow (vold/cryptfs.cpp: 1733, 1765, 1770, 1825,
-# 1945, 1948, 2660, 2798, 2900, 3414, 3427) and userdata is no longer
-# encrypted (rootdir/etc/fstab.mt6755), so the trigger can never fire again.
-# It was the last surviving vold.decrypt trigger in this tree.
+    # perfUserScnCheckAll stats hint owners in /proc. With hidepid=2 it
+    # mistakes live camera processes for dead owners without readproc.
+    group system wifi readproc
-- 
2.55.0

