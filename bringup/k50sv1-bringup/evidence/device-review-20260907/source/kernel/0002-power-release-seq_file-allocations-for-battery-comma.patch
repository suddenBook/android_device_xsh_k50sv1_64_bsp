From 8453fe16804ad4682e524c92216111ffbe1d1ad6 Mon Sep 17 00:00:00 2001
From: Huixiaqing Liu <huixiaqingliu@outlook.com>
Date: Mon, 7 Sep 2026 08:01:27 +0200
Subject: [PATCH 2/8] power: release seq_file allocations for battery command
 nodes

---
 drivers/power/mediatek/battery_common.c       | 6 ++++++
 drivers/power/mediatek/battery_common_fg_20.c | 6 ++++++
 2 files changed, 12 insertions(+)

diff --git a/drivers/power/mediatek/battery_common.c b/drivers/power/mediatek/battery_common.c
index be9f1e3281f..009bd69251c 100644
--- a/drivers/power/mediatek/battery_common.c
+++ b/drivers/power/mediatek/battery_common.c
@@ -4685,6 +4685,8 @@ static int proc_utilization_open(struct inode *inode, struct file *file)
 static const struct file_operations battery_cmd_proc_fops = {
 	.open = proc_utilization_open,
 	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
 	.write = battery_cmd_write,
 };
 
@@ -4763,12 +4765,16 @@ static ssize_t discharging_cmd_write(struct file *file, const char *buffer, size
 static const struct file_operations discharging_cmd_proc_fops = {
 	.open = proc_utilization_open,
 	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
 	.write = discharging_cmd_write,
 };
 
 static const struct file_operations current_cmd_proc_fops = {
 	.open = proc_utilization_open_cur_stop,
 	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
 	.write = current_cmd_write,
 };
 
diff --git a/drivers/power/mediatek/battery_common_fg_20.c b/drivers/power/mediatek/battery_common_fg_20.c
index 6bb607968d4..4e7939f2d99 100644
--- a/drivers/power/mediatek/battery_common_fg_20.c
+++ b/drivers/power/mediatek/battery_common_fg_20.c
@@ -4334,6 +4334,8 @@ static int proc_utilization_open(struct inode *inode, struct file *file)
 static const struct file_operations battery_cmd_proc_fops = {
 	.open = proc_utilization_open,
 	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
 	.write = battery_cmd_write,
 };
 
@@ -4504,12 +4506,16 @@ static ssize_t safety_timer_cmd_write(struct file *file, const char *buffer,
 static const struct file_operations discharging_cmd_proc_fops = {
 	.open = proc_utilization_open,
 	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
 	.write = discharging_cmd_write,
 };
 
 static const struct file_operations current_cmd_proc_fops = {
 	.open = proc_utilization_open_cur_stop,
 	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
 	.write = current_cmd_write,
 };
 
