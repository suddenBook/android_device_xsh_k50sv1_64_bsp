diff --git a/drivers/misc/mediatek/connectivity/source/common/common_main/core/stp_core.c b/drivers/misc/mediatek/connectivity/source/common/common_main/core/stp_core.c
index 34efba6b8d748d2f1e998746887b074ca062ba88..160f5aee9d033906e02dbf6ee1bacf989b26f927 100644
--- a/drivers/misc/mediatek/connectivity/source/common/common_main/core/stp_core.c
+++ b/drivers/misc/mediatek/connectivity/source/common/common_main/core/stp_core.c
@@ -56,6 +56,8 @@ static FUNCTION_STATUS sys_check_function_status;
 /* kernel lib */
 /* INT32                g_block_tx = 0; */
 static mtkstp_context_struct stp_core_ctx = { 0 };
+static DEFINE_MUTEX(g_stp_lifecycle_lock);
+static bool g_stp_resources_initialized;
 
 #define STP_PSM_CORE(x)           ((x).psm)
 #define STP_SET_PSM_CORE(x, v)     ((x).psm = (v))
@@ -143,6 +145,7 @@ static VOID stp_trace32_dump(VOID);
 static VOID stp_sdio_trace32_dump(VOID);
 static LONG stp_parser_dmp_num(PUINT8 str);
 static INT32 wmt_parser_data(PUINT8 buffer, UINT32 length, UINT8 type);
+static VOID stp_deinit_locked(VOID);
 
 INT32 __weak mtk_wcn_consys_stp_btif_logger_ctrl(enum _ENUM_BTIF_DBG_ID_ flag)
 {
@@ -1484,6 +1487,17 @@ INT32 mtk_wcn_stp_init(const mtkstp_callback * const cb_func)
 	INT32 ret = 0;
 	INT32 i = 0;
 
+	if (!cb_func)
+		return -EINVAL;
+	mutex_lock(&g_stp_lifecycle_lock);
+	if (g_stp_resources_initialized) {
+		mutex_unlock(&g_stp_lifecycle_lock);
+		return -EBUSY;
+	}
+	STP_SET_PSM_CORE(stp_core_ctx, NULL);
+	STP_SET_BTM_CORE(stp_core_ctx, NULL);
+	g_mtkstp_dbg = NULL;
+
 	/* Function pointer to point to the currently used transmission interface
 	 */
 	sys_if_tx = cb_func->cb_if_tx;
@@ -1518,6 +1532,7 @@ INT32 mtk_wcn_stp_init(const mtkstp_callback * const cb_func)
 	stp_core_ctx.tx_timer.timeoutHandler = stp_tx_timeout_handler;
 	stp_core_ctx.tx_timer.timeroutHandlerData = 0;
 	osal_timer_create(&stp_core_ctx.tx_timer);
+	g_stp_resources_initialized = true;
 
 	STP_SET_BT_STK(stp_core_ctx, 0);
 	STP_SET_ENABLE(stp_core_ctx, 0);
@@ -1553,8 +1568,6 @@ INT32 mtk_wcn_stp_init(const mtkstp_callback * const cb_func)
 
 	if (!g_mtkstp_dbg) {
 		STP_ERR_FUNC("g_mtkstp_dbg initialization fail!\n");
-		stp_btm_deinit(STP_BTM_CORE(stp_core_ctx));
-		STP_SET_BTM_CORE(stp_core_ctx, NULL);
 		ret = (-3);
 		goto ERROR;
 	}
@@ -1565,9 +1578,10 @@ INT32 mtk_wcn_stp_init(const mtkstp_callback * const cb_func)
 	goto RETURN;
 
 ERROR:
-	stp_psm_deinit(STP_PSM_CORE(stp_core_ctx));
+	stp_deinit_locked();
 
 RETURN:
+	mutex_unlock(&g_stp_lifecycle_lock);
 	return ret;
 
 }
@@ -1582,23 +1596,58 @@ RETURN:
 * RETURNS
 *  INT32    0 = success, others = failure
 *****************************************************************************/
-INT32 mtk_wcn_stp_deinit(VOID)
+static VOID stp_deinit_locked(VOID)
 {
 	INT32 i = 0;
 
+	if (!g_stp_resources_initialized)
+		return;
+
+	/*
+	 * External producers and WMT workers must already be quiescent. BTM can
+	 * still call WMT, PSM, debug and transport code until its thread returns.
+	 */
+	if (STP_BTM_CORE(stp_core_ctx))
+		stp_btm_stop_thread();
+	if (STP_PSM_CORE(stp_core_ctx)) {
+		stp_psm_deinit(STP_PSM_CORE(stp_core_ctx));
+		STP_SET_PSM_CORE(stp_core_ctx, NULL);
+	}
+
+	/* The joined BTM retry handler can no longer rearm this timer. */
+	osal_timer_stop_sync(&stp_core_ctx.tx_timer);
+	if (g_mtkstp_dbg) {
+		stp_dbg_deinit(g_mtkstp_dbg);
+		g_mtkstp_dbg = NULL;
+	}
+	/* Debug timeout callbacks enqueue BTM operations: stop them before this. */
+	if (STP_BTM_CORE(stp_core_ctx)) {
+		stp_btm_deinit(STP_BTM_CORE(stp_core_ctx));
+		STP_SET_BTM_CORE(stp_core_ctx, NULL);
+	}
+
 	sys_if_tx = NULL;
+	sys_rx_has_pending_data = NULL;
+	sys_tx_has_pending_data = NULL;
+	sys_rx_thread_get = NULL;
 	sys_event_set = NULL;
 	sys_event_tx_resume = NULL;
 	sys_check_function_status = NULL;
-
-	stp_dbg_deinit(g_mtkstp_dbg);
-	stp_btm_deinit(STP_BTM_CORE(stp_core_ctx));
-	stp_psm_deinit(STP_PSM_CORE(stp_core_ctx));
+	STP_SET_READY(stp_core_ctx, 0);
+	STP_SET_ENABLE(stp_core_ctx, 0);
 
 	for (i = 0; i < MTKSTP_MAX_TASK_NUM; i++)
 		osal_unsleepable_lock_deinit(&stp_core_ctx.ring[i].mtx);
 
 	stp_ctx_lock_deinit(&stp_core_ctx);
+	g_stp_resources_initialized = false;
+}
+
+INT32 mtk_wcn_stp_deinit(VOID)
+{
+	mutex_lock(&g_stp_lifecycle_lock);
+	stp_deinit_locked();
+	mutex_unlock(&g_stp_lifecycle_lock);
 	return 0;
 }
 
