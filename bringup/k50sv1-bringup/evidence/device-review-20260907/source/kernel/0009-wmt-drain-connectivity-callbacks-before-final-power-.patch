diff --git a/drivers/misc/mediatek/connectivity/source/common/common_main/core/wmt_lib.c b/drivers/misc/mediatek/connectivity/source/common/common_main/core/wmt_lib.c
index 20e828016af187e966d63adb79a554f11e058c70..781500cf8eed63c83da850d1c3fd331ed9d9c91e 100644
--- a/drivers/misc/mediatek/connectivity/source/common/common_main/core/wmt_lib.c
+++ b/drivers/misc/mediatek/connectivity/source/common/common_main/core/wmt_lib.c
@@ -112,6 +112,7 @@ static bool g_wmt_utc_timer_initialized;
 static bool g_wmt_core_initialized;
 static bool g_wmt_resources_initialized;
 static bool g_wmt_platform_initialized;
+static bool g_wmt_deinit_prepared;
 #if CFG_WMT_PS_SUPPORT
 static bool g_wmt_ps_initialized;
 #endif
@@ -342,6 +343,7 @@ INT32 wmt_lib_init(VOID)
 	/* create->init->start */
 	/* 1. create: static allocation with zero initialization */
 	pDevWmt = &gDevWmt;
+	g_wmt_deinit_prepared = false;
 	osal_memset(&gDevWmt, 0, sizeof(gDevWmt));
 	if (wmt_detect_get_chip_type() == WMT_CHIP_TYPE_SOC) {
 		iRet = wmt_conf_read_file();
@@ -532,16 +534,16 @@ INT32 wmt_lib_init(VOID)
 }
 
 
-INT32 wmt_lib_deinit(VOID)
+INT32 wmt_lib_deinit_prepare(VOID)
 {
 	INT32 iRet;
 	P_DEV_WMT pDevWmt;
-	INT32 i;
 	INT32 iResult;
 	ULONG flags;
-	bool op_pool_initialized;
 	bool assert_work_initialized;
-	struct vendor_patch_table *table = &(gDevWmt.patch_table);
+
+	if (g_wmt_deinit_prepared)
+		return 0;
 
 	/* Also covers cleanup after a partially completed wmt_lib_init. */
 	wmt_export_platform_bridge_unregister();
@@ -553,7 +555,6 @@ INT32 wmt_lib_deinit(VOID)
 	/* Serialize closure with checkout, enqueue and its worker wakeup. */
 	mutex_lock(&g_wmt_op_pool_lock);
 	g_wmt_op_pool_stopping = true;
-	op_pool_initialized = g_wmt_op_pool_initialized;
 	mutex_unlock(&g_wmt_op_pool_lock);
 
 	/* No delayed assertion can be published after its work is joined. */
@@ -599,9 +600,6 @@ INT32 wmt_lib_deinit(VOID)
 
 	/* Includes pre-submit borrowers and senders still copying completed data. */
 	wait_event(g_wmt_op_pool_idle, atomic_read(&g_wmt_ops_checked_out) == 0);
-	mutex_lock(&g_wmt_op_pool_lock);
-	g_wmt_op_pool_initialized = false;
-	mutex_unlock(&g_wmt_op_pool_lock);
 
 	osal_op_history_deinit(&pDevWmt->wmtd_op_history);
 	osal_op_history_deinit(&pDevWmt->worker_op_history);
@@ -612,6 +610,28 @@ INT32 wmt_lib_deinit(VOID)
 		g_wmt_idc_initialized = false;
 	}
 #endif
+	/* STP callbacks can still run: retain their WMT state, locks and platform. */
+	g_wmt_deinit_prepared = true;
+	return iResult;
+}
+
+INT32 wmt_lib_deinit_finish(VOID)
+{
+	P_DEV_WMT pDevWmt = &gDevWmt;
+	struct vendor_patch_table *table = &pDevWmt->patch_table;
+	INT32 iRet;
+	INT32 i;
+	INT32 iResult = 0;
+	bool op_pool_initialized;
+
+	/* The caller must run stp_drv_exit() between prepare and finish. */
+	if (!g_wmt_deinit_prepared)
+		return -EBUSY;
+	mutex_lock(&g_wmt_op_pool_lock);
+	op_pool_initialized = g_wmt_op_pool_initialized;
+	g_wmt_op_pool_initialized = false;
+	mutex_unlock(&g_wmt_op_pool_lock);
+
 #if CFG_WMT_PS_SUPPORT
 	if (g_wmt_ps_initialized) {
 		iRet = wmt_lib_ps_deinit();
@@ -2743,6 +2763,33 @@ INT32 wmt_lib_try_pwr_off(VOID)
 	return 0;
 }
 
+INT32 wmt_lib_power_off_for_exit(VOID)
+{
+	P_OSAL_OP pOp;
+	MTK_WCN_BOOL ret;
+
+	/* A reset that is already running must finish before the final power-off. */
+	stp_btm_stop_thread();
+	if (wmt_lib_get_drv_status(WMTDRV_TYPE_WMT) == DRV_STS_POWER_OFF)
+		return 0;
+	pOp = wmt_lib_get_free_op();
+	if (!pOp)
+		return -ESHUTDOWN;
+	pOp->signal.timeoutValue = MAX_FUNC_OFF_TIME;
+	pOp->op.opId = WMT_OPID_PWR_OFF;
+
+	wmt_lib_host_awake_get();
+	if (DISABLE_PSM_MONITOR()) {
+		wmt_lib_put_op_to_free_queue(pOp);
+		wmt_lib_host_awake_put();
+		return -EIO;
+	}
+	ret = wmt_lib_put_act_op(pOp);
+	ENABLE_PSM_MONITOR();
+	wmt_lib_host_awake_put();
+	return ret ? 0 : -EIO;
+}
+
 P_WMT_PATCH_INFO wmt_lib_get_patch_info(VOID)
