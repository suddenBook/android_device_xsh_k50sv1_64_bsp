diff --git a/drivers/misc/mediatek/connectivity/source/common/common_main/core/btm_core.c b/drivers/misc/mediatek/connectivity/source/common/common_main/core/btm_core.c
index d1cbcae396ae465651187a6356df130e017f9d39..48a9c24347a1cfa6b87cdd8b2a6c471af6b800fa 100644
--- a/drivers/misc/mediatek/connectivity/source/common/common_main/core/btm_core.c
+++ b/drivers/misc/mediatek/connectivity/source/common/common_main/core/btm_core.c
@@ -65,6 +65,8 @@ do { \
 
 MTKSTP_BTM_T stp_btm_i;
 MTKSTP_BTM_T *stp_btm = &stp_btm_i;
+/* Ownership also covers failure after embedded resources were initialized. */
+static bool g_btm_initialized;
 
 const PINT8 g_btm_op_name[] = {
 	"STP_OPID_BTM_RETRY",
@@ -601,6 +603,10 @@ MTKSTP_BTM_T *stp_btm_init(VOID)
 	INT32 i = 0x0;
 	INT32 ret = -1;
 
+	if (g_btm_initialized)
+		return stp_btm;
+	stp_btm->pCurOP = NULL;
+	stp_btm->gDumplogflag = 0;
 	osal_unsleepable_lock_init(&stp_btm->wq_spinlock);
 	osal_event_init(&stp_btm->STPd_event);
 	stp_btm->wmt_notify = wmt_lib_btm_cb;
@@ -616,6 +622,7 @@ MTKSTP_BTM_T *stp_btm_init(VOID)
 
 	stp_btm_init_trigger_assert_timer(stp_btm);
 	osal_op_history_init(&stp_btm->op_history, 16);
+	g_btm_initialized = true;
 
 	/*Generate PSM thread, to servie STP-CORE for packet retrying and core dump receiving */
 	stp_btm->BTMd.pThreadData = (PVOID) stp_btm;
@@ -638,29 +645,35 @@ MTKSTP_BTM_T *stp_btm_init(VOID)
 	return stp_btm;
 
 ERR_EXIT1:
-	osal_op_history_deinit(&stp_btm->op_history);
+	stp_btm_deinit(stp_btm);
 
 	return NULL;
 
 }
 
-INT32 stp_btm_deinit(MTKSTP_BTM_T *stp_btm)
+INT32 stp_btm_stop_thread(VOID)
 {
+	if (!g_btm_initialized)
+		return STP_BTM_OPERATION_SUCCESS;
+	/* BTM may still call WMT, PSM and debug code until this join returns. */
+	return osal_thread_destroy(&stp_btm->BTMd);
+}
 
-	INT32 ret = -1;
-
-	STP_BTM_PR_INFO("btm deinit\n");
-
+INT32 stp_btm_deinit(MTKSTP_BTM_T *stp_btm)
+{
 	if (!stp_btm)
 		return STP_BTM_OPERATION_FAIL;
+	if (!g_btm_initialized)
+		return STP_BTM_OPERATION_SUCCESS;
 
+	STP_BTM_PR_INFO("btm deinit\n");
+	stp_btm_stop_thread();
+	/* All callers that can rearm the assertion timer have now been joined. */
+	osal_timer_stop_sync(&stp_btm->trigger_assert_timer);
 	osal_op_history_deinit(&stp_btm->op_history);
-
-	ret = osal_thread_destroy(&stp_btm->BTMd);
-	if (ret < 0) {
-		STP_BTM_PR_ERR("osal_thread_destroy FAILS\n");
-		return STP_BTM_OPERATION_FAIL;
-	}
+	stp_btm->wmt_notify = NULL;
+	stp_btm->pCurOP = NULL;
+	g_btm_initialized = false;
 
 	return STP_BTM_OPERATION_SUCCESS;
 }
