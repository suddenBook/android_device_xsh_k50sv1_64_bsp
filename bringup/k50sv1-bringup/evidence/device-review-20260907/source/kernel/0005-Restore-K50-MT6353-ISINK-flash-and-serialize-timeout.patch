+static void __exit constant_flashlight_exit(void)
+{
+	constant_flashlight_release(NULL);
+}
+module_exit(constant_flashlight_exit);
+
+MODULE_DESCRIPTION("K50 MT6353 ISINK main flash");
+MODULE_LICENSE("GPL v2");
