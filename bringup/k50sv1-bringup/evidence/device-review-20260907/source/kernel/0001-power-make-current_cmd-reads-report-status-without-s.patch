From b7b026a8e3b9796fb115a0405f95ce09c6196aa4 Mon Sep 17 00:00:00 2001
From: Huixiaqing Liu <huixiaqingliu@outlook.com>
Date: Mon, 7 Sep 2026 08:00:36 +0200
Subject: [PATCH 1/8] power: make current_cmd reads report status without
 stopping charging

---
 drivers/power/mediatek/battery_common.c       | 12 +++---------
 drivers/power/mediatek/battery_common_fg_20.c | 12 +++---------
 2 files changed, 6 insertions(+), 18 deletions(-)

diff --git a/drivers/power/mediatek/battery_common.c b/drivers/power/mediatek/battery_common.c
index 9b6f19a6885..be9f1e3281f 100644
--- a/drivers/power/mediatek/battery_common.c
+++ b/drivers/power/mediatek/battery_common.c
@@ -4725,15 +4725,9 @@ static ssize_t current_cmd_write(struct file *file, const char *buffer, size_t c
 
 static int current_cmd_read(struct seq_file *m, void *v)
 {
-	unsigned int charging_enable = false;
-
-	cmd_discharging = 1;
-	charging_enable = false;
-	adjust_power = -1;
-
-	battery_charging_control(CHARGING_CMD_ENABLE, &charging_enable);
-
-	battery_log(BAT_LOG_CRTI, "[current_cmd_write] cmd_discharging=%d\n", cmd_discharging);
+	/* Reading status must not execute the writable charging-control command. */
+	seq_printf(m, "usb_current_unlimited=%d cmd_discharging=%d\n",
+		   get_usb_current_unlimited(), READ_ONCE(cmd_discharging));
 
 	return 0;
 }
diff --git a/drivers/power/mediatek/battery_common_fg_20.c b/drivers/power/mediatek/battery_common_fg_20.c
index 620bc7e4fbb..6bb607968d4 100644
--- a/drivers/power/mediatek/battery_common_fg_20.c
+++ b/drivers/power/mediatek/battery_common_fg_20.c
@@ -4377,15 +4377,9 @@ static ssize_t current_cmd_write(struct file *file, const char *buffer, size_t c
 
 static int current_cmd_read(struct seq_file *m, void *v)
 {
-	unsigned int charging_enable = false;
-
-	cmd_discharging = 1;
-	charging_enable = false;
-	adjust_power = -1;
-
-	battery_charging_control(CHARGING_CMD_ENABLE, &charging_enable);
-
-	battery_log(BAT_LOG_CRTI, "[current_cmd_write] cmd_discharging=%d\n", cmd_discharging);
+	/* Reading status must not execute the writable charging-control command. */
+	seq_printf(m, "usb_current_unlimited=%d cmd_discharging=%d\n",
+		   get_usb_current_unlimited(), READ_ONCE(cmd_discharging));
 
 	return 0;
 }
-- 
