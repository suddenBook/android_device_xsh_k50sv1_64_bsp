diff --git a/prebuilt/common/etc/fonts_customization.xml b/prebuilt/common/etc/fonts_customization.xml
index 0c9a7fb3..31a08917 100644
--- a/prebuilt/common/etc/fonts_customization.xml
+++ b/prebuilt/common/etc/fonts_customization.xml
@@ -21,4 +21,44 @@
     </family>
     <alias name="rubik-medium" to="rubik" weight="500" />
     <alias name="rubik-bold" to="rubik" weight="700" />
+    <!-- k50sv1_64_bsp: HarmonyOS Sans.
+         The .ttf files are installed to /product/fonts by
+         device/xsh/k50sv1_64_bsp/fonts/Android.mk, and the Styles entry that
+         selects the family is device/xsh/k50sv1_64_bsp/rro/HarmonyOSSansFont.
+         This family has to be declared HERE and not in the device tree,
+         because SystemFonts.java:313 reads exactly one hardcoded path,
+         /product/etc/fonts_customization.xml, and base_rules.mk:510 emits an
+         install rule for every parsed module, so a second writer of that path
+         is a ckati "overriding commands" error rather than an override.
+
+         HarmonyOS Sans is a VARIABLE font with a wght axis spanning 40 to 900,
+         so one file covers 400, 500 and 700 through <axis stylevalue>, which
+         FontListParser.readFont() supports and FontCustomizationParser
+         delegates to. The regular face is the SC cut, which is a strict
+         superset of the Latin-only file (full ASCII, Latin-1 Supplement and
+         Cyrillic, same Greek coverage, plus 20,991 CJK ideographs), so Chinese
+         renders in HarmonyOS Sans too. Italic is Latin-only; there is no SC
+         italic, so italic CJK falls back to Noto. -->
+    <family customizationType="new-named-family" name="harmonyos">
+        <font weight="400" style="normal">HarmonyOSSans-Regular.ttf
+            <axis tag="wght" stylevalue="400" />
+        </font>
+        <font weight="400" style="italic">HarmonyOSSans-Italic.ttf
+            <axis tag="wght" stylevalue="400" />
+        </font>
+        <font weight="500" style="normal">HarmonyOSSans-Regular.ttf
+            <axis tag="wght" stylevalue="500" />
+        </font>
+        <font weight="500" style="italic">HarmonyOSSans-Italic.ttf
+            <axis tag="wght" stylevalue="500" />
+        </font>
+        <font weight="700" style="normal">HarmonyOSSans-Regular.ttf
+            <axis tag="wght" stylevalue="700" />
+        </font>
+        <font weight="700" style="italic">HarmonyOSSans-Italic.ttf
+            <axis tag="wght" stylevalue="700" />
+        </font>
+    </family>
+    <alias name="harmonyos-medium" to="harmonyos" weight="500" />
+    <alias name="harmonyos-bold" to="harmonyos" weight="700" />
 </fonts-modification>
