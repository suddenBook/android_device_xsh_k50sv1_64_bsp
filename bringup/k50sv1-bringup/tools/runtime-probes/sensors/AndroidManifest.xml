<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.k50.sensorprobe">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="29" />
    <application android:label="K50 sensor probe" android:allowBackup="false">
        <activity android:name=".SensorProbeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
