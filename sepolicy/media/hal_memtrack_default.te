# The standard memtrack HAL periodically reads this one Mali accounting file
# for framework GPU-memory reporting. Do not expose the surrounding mali0
# debugfs tree or grant the extra ioctl/map/watch permissions in r_file_perms.
allow hal_memtrack_default debugfs_mtk_mali_gpu_memory:file {
    getattr
    open
    read
};

# The vendor memtrack implementation combines Mali's allocation total with
# ION's per-client summary. Both inputs are read-only accounting leaves; do not
# grant access to the surrounding debugfs trees.
allow hal_memtrack_default debugfs_mtk_ion_clients_summary:file {
    getattr
    open
    read
};
