# libged is linked directly by the Mali EGL/gralloc stack.  These domains all
# either hold a live read-only /proc/ged FD or are explicit Stock EGL startup
# clients; appdomain is required because applications load libGLES_mali.so.
# mediaswcodec is here because the Codec2 software decoders still allocate
# through gralloc: observed as `oid.avc.decoder` doing read/open plus ioctl
# 0x6765 on /proc/ged, which is inside the range already granted below.
# isolated_app (the WebView/renderer sandbox, private/app_neverallows.te:7) and
# ephemeral_app never load the Mali EGL stack, so they are excluded rather than
# inheriting a proprietary GPU ioctl surface through the appdomain attribute.
allow {
    appdomain
    -isolated_app
    -ephemeral_app
    bootanim
    cameraserver
    hal_camera_default
    hal_graphics_allocator_default
    hal_graphics_composer_default
    mediacodec
    mediaswcodec
    mediaserver
    surfaceflinger
    system_server
} proc_ged:file r_file_perms;

allowxperm {
    appdomain
    -isolated_app
    -ephemeral_app
    bootanim
    cameraserver
    hal_camera_default
    hal_graphics_allocator_default
    hal_graphics_composer_default
    mediacodec
    mediaswcodec
    mediaserver
    surfaceflinger
    system_server
} proc_ged:file ioctl {
    0x6700-0x670e
    0x6764-0x676a
};

# Persistent live FDs prove these three processes submit read-only CMDQ
# requests.  Do not broaden this to every GED or media client.
allow {
    hal_graphics_composer_default
    mediacodec
    surfaceflinger
} mtk_cmdq_device:chr_file { ioctl open read };

# sw_sync timeline producers. Splitting /dev/sw_sync out of graphics_device
# (media/file.te) removes the access the composer previously inherited from
# system/sepolicy/public/hal_graphics_composer.te:23, so it is restated here
# for the two processes that actually hold the node open on the handset.
# Stock grants sw_sync_device rw to mtk_hal_camera, mtk_hal_mms and mediacodec
# as well; none of those three has it open here, so they are left out.
allow {
    hal_graphics_composer_default
    mtk_hal_mms
} mtk_sw_sync_device:chr_file rw_file_perms;

# The proprietary composer uses vendor Binder for its MTK extension service
# and listens for hotplug uevents.
vndbinder_use(hal_graphics_composer_default)
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket {
    bind
    create
    read
    setopt
};

set_prop(hal_graphics_composer_default, mtk_hwc_runtime_prop)
get_prop(surfaceflinger, mtk_hwc_runtime_prop)

# proc_ged is granted r_file_perms, NOT rw. Stock's compiled policy has
#   (allow appdomain proc_ged (file (ioctl read write getattr lock append map open)))
# and the same for surfaceflinger, mediacodec, mtk_hal_gpu and mtk_hal_camera,
# i.e. it hands every application write access to a proprietary GPU driver
# node. The GED interface this stack uses is ioctl-driven; the write path is
# ged_log. No write denial appears in the tier 1 capture
# (work/k50sv1-bringup/evidence/tier1-avc-20260823-postfix/) and the handset
# renders, so the write is not granted on Stock's say-so alone. If
# "avc: denied { write } ... path=/proc/ged" ever shows up, add write+append to
# the specific domain that raised it, not to appdomain.
