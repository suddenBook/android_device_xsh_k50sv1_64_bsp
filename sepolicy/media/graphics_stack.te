# The passthrough graphics mapper loads gralloc.mt6755.so ->
# libgralloc_extra.so -> libged.so in the client process. The four GED imports
# in libgralloc_extra are GE_ALLOC/GET/SET/QUERY (0x6764/65/66/69), which explains
# ordinary app access. A DT_NEEDED entry in libGLES_mali alone proves no call.
# The isolated and ephemeral app exclusions remain the graphics sandbox bound.
#
# SELinux checks the outer ioctl value. This restriction requires ged_main.c
# to reject a payload ui32FunctionID that differs from that value. Before that
# driver fix, both native and compat entry points could dispatch QUERY_INFO
# with an allowed GE_ALLOC outer command. Reducing allowxperm alone did not
# enforce the advertised separation. Both installed libged ABIs send equal
# full command values; retain that userspace contract in the driver.
#
# Keep the existing ranges pending sustained graphics/thermal coverage. The
# shipped consumers identified for the first range are hwcomposer, the GPU HAL
# and libMtkOmxVdecEx; no ordinary app consumer was found. App graphics metadata
# needs the second range. The policy is not a substitute for validating each
# driver's command arguments.
allow {
    appdomain
    -isolated_app
    -ephemeral_app
    bootanim
    cameraserver
    hal_camera_default
    hal_graphics_allocator_default
    hal_graphics_composer_default
    mediacodec
    mediaswcodec
    mediaserver
    surfaceflinger
    system_server
} proc_ged:file r_file_perms;

allowxperm {
    appdomain
    -isolated_app
    -ephemeral_app
} proc_ged:file ioctl {
    0x6764-0x676a
};

allowxperm {
    bootanim
    cameraserver
    hal_camera_default
    hal_graphics_allocator_default
    hal_graphics_composer_default
    mediacodec
    mediaswcodec
    mediaserver
    surfaceflinger
    system_server
} proc_ged:file ioctl {
    0x6700-0x670e
    0x6764-0x676a
};

# Persistent live FDs prove these three processes submit read-only CMDQ
# requests.  Do not broaden this to every GED or media client.
allow {
    hal_graphics_composer_default
    mediacodec
    surfaceflinger
} mtk_cmdq_device:chr_file { ioctl open read };

# sw_sync timeline producers. Splitting /dev/sw_sync out of graphics_device
# (media/file.te) removes the access the composer previously inherited from
# system/sepolicy/public/hal_graphics_composer.te:23, so it is restated here
# for the two processes that actually hold the node open on the handset.
# Stock grants sw_sync_device rw to mtk_hal_camera, mtk_hal_mms and mediacodec
# as well; none of those three has it open here, so they are left out.
allow {
    hal_graphics_composer_default
    mtk_hal_mms
} mtk_sw_sync_device:chr_file rw_file_perms;

# The proprietary composer uses vendor Binder for its MTK extension service
# and listens for hotplug uevents.
vndbinder_use(hal_graphics_composer_default)
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket {
    bind
    create
    read
    setopt
};

set_prop(hal_graphics_composer_default, mtk_hwc_runtime_prop)
get_prop(surfaceflinger, mtk_hwc_runtime_prop)

# The composer runs MTK PQ in its own process, and both of these fire the first
# time a camera preview builds a decoupled display buffer queue -- roughly two
# minutes into a boot, and only if someone opens the camera. That is why an
# early-boot AVC sweep never saw them and HANDOFF claimed a clean allowlist for
# five sessions (evidence/E-149.md). Measured in the same millisecond as
#   hwcomposer [DBQ] (q2) Buffer queue is created with size(3)
#   PQ [PQSessionManager] m_PQSupport = 2 ... [PQConfig] PQService is ready
#
# IMapper. media/clients.te:7 already makes the composer a client of
# vendor.mediatek.hardware.pq, that interface hands back a hidl_memory, and
# libhidlmemory's mapMemory() must look up android.hidl.memory::IMapper before
# it can map one. A DIRECT allow is the AOSP idiom for a domain that only MAPS
# shared memory it did not allocate: system/sepolicy/public/hal_drm.te:7,
# hal_cas.te:6 and hal_neuralnetworks.te:6 are all a bare allow, the type is
# declared bare at public/hwservice.te:66 with no hal_attribute_hwservice closed
# set, and private/app_neverallows.te annotates it "Designed for use by any
# domain". public/domain.te:1317 restricts coredomain_hwservice `add`, not
# `find`.
#
# Do NOT "make it consistent" with mtk_hal_mms below, which reaches the same
# interface through hal_client_domain(mtk_hal_mms, hal_allocator). That macro
# additionally grants IAllocator find and a binder edge to hal_allocator_default,
# a coredomain -- and no IAllocator denial has ever been recorded from the
# composer, because it allocates nothing. If one appears, THEN switch to the
# macro.
allow hal_graphics_composer_default hidl_memory_hwservice:hwservice_manager find;

# boot_mode. The same libdpframework::PQConfig check that media/mtk_hal_mms.te:26
# already grants, in a second process; identical node, identical two
# permissions. The node has its own label (radio/file.te:45,
# radio/genfs_contexts:6) and five other domains read it. The parent dirs stay
# generic sysfs, which public/domain.te:248 lets every domain search.
allow hal_graphics_composer_default sysfs_mtk_boot_mode:file {
    open
    read
};

# proc_ged is granted r_file_perms, NOT rw. Stock's compiled policy has
#   (allow appdomain proc_ged (file (ioctl read write getattr lock append map open)))
# and the same for surfaceflinger, mediacodec, mtk_hal_gpu and mtk_hal_camera,
# i.e. it hands every application write access to a proprietary GPU driver
# node. The GED interface this stack uses is ioctl-driven; ged_write in the
# current driver is a no-op. No write denial appears in the tier 1 capture
# (work/k50sv1-bringup/evidence/tier1-avc-20260823-postfix/) and the handset
# renders, so the write is not granted on Stock's say-so alone. If
# "avc: denied { write } ... path=/proc/ged" ever shows up, add write+append to
# the specific domain that raised it, not to appdomain.
