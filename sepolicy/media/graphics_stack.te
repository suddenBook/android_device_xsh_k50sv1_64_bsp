# libged.so is the only library in the image that opens /proc/ged, and it has
# exactly one ioctl() call site (inside ged_bridge_call), so every GED command
# in this build passes through it.
#
# WHY appdomain. NOT because "applications load libGLES_mali.so" -- that was
# the old reason here and it is disprovable: libGLES_mali.so lists libged.so in
# DT_NEEDED but imports no ged_* symbol at all (readelf --dyn-syms shows zero
# UND ged_* in either the 32- or 64-bit build), so the NEEDED tag is vestigial.
# gralloc.mt6755.so is the same, NEEDED but no imports.
# The real path is the passthrough mapper. manifest.xml:65-67 declares
#   <name>android.hardware.graphics.mapper</name>
#   <transport arch="32+64">passthrough</transport>  @2.0::IMapper/default
# and a passthrough HAL loads in-process, so ANY app that maps a GraphicBuffer
# pulls gralloc.mt6755.so -> libgralloc_extra.so -> libged.so into its own
# address space. libgralloc_extra.so imports ged_ge_alloc / ged_ge_get /
# ged_ge_set / ged_ge_query, which are 0x6764 / 0x6765 / 0x6766 / 0x6769.
# That is the evidenced reason ordinary apps reach this node, and it is why the
# 0x6764-0x676a half cannot be dropped from appdomain.
# mediaswcodec is the same story from the Codec2 side: observed as
# `oid.avc.decoder` doing read/open plus ioctl 0x6765, which is ged_ge_get
# reached through gralloc -- static and dynamic evidence agreeing exactly.
# isolated_app (the WebView/renderer sandbox, private/app_neverallows.te:7) and
# ephemeral_app never map vendor graphics buffers, so they are excluded rather
# than inheriting a proprietary GPU ioctl surface through the attribute.
#
# WHY THE RANGE IS KEPT RATHER THAN ENUMERATED. Disassembling libged.so and
# tracing all 25 ged_bridge_call sites accounts for 20 of the 22 granted
# values as real compiled commands, and 9 of those have a caller shipped in
# this image:
#   0x6700 ged_log_connect       hwcomposer.mt6755.so
#   0x6701 ged_log_tpt_print     hwcomposer.mt6755.so
#   0x6705 ged_query_info        hwcomposer.mt6755.so, mtk_hal_gpu service
#   0x6707 ged_dvfs_probe        vendor.mediatek.hardware.gpu@1.0-service
#   0x670e ged_hint_force_mdp    libMtkOmxVdecEx.so (mediacodec/mediaswcodec)
#   0x6764/0x6765/0x6766/0x6769  ged_ge_{alloc,get,set,query}, libgralloc_extra
# The two that could not be proven, 0x670c and 0x6768, are isolated single
# gaps in an otherwise contiguous enum (0x6700..0x670e, 0x6764..0x676a), each
# flanked by proven neighbours -- the shape of commands this build's userspace
# happens not to exercise, not of unjustified breadth. Trimming two values out
# of 22 would buy ~9% of the xperm surface at the risk of a black screen on a
# DVFS or vsync path that only appears under sustained GPU or thermal load,
# which no capture here has covered. Not worth it: these apps already hold
# gpu_device rw. Revisit only with a long capture under GPU/thermal stress
# watching for ioctlcmd=670c or 6768, or with MediaTek's GED driver source,
# which is not present in this tree or the factory image.
allow {
    appdomain
    -isolated_app
    -ephemeral_app
    bootanim
    cameraserver
    hal_camera_default
    hal_graphics_allocator_default
    hal_graphics_composer_default
    mediacodec
    mediaswcodec
    mediaserver
    surfaceflinger
    system_server
} proc_ged:file r_file_perms;

allowxperm {
    appdomain
    -isolated_app
    -ephemeral_app
    bootanim
    cameraserver
    hal_camera_default
    hal_graphics_allocator_default
    hal_graphics_composer_default
    mediacodec
    mediaswcodec
    mediaserver
    surfaceflinger
    system_server
} proc_ged:file ioctl {
    0x6700-0x670e
    0x6764-0x676a
};

# Persistent live FDs prove these three processes submit read-only CMDQ
# requests.  Do not broaden this to every GED or media client.
allow {
    hal_graphics_composer_default
    mediacodec
    surfaceflinger
} mtk_cmdq_device:chr_file { ioctl open read };

# sw_sync timeline producers. Splitting /dev/sw_sync out of graphics_device
# (media/file.te) removes the access the composer previously inherited from
# system/sepolicy/public/hal_graphics_composer.te:23, so it is restated here
# for the two processes that actually hold the node open on the handset.
# Stock grants sw_sync_device rw to mtk_hal_camera, mtk_hal_mms and mediacodec
# as well; none of those three has it open here, so they are left out.
allow {
    hal_graphics_composer_default
    mtk_hal_mms
} mtk_sw_sync_device:chr_file rw_file_perms;

# The proprietary composer uses vendor Binder for its MTK extension service
# and listens for hotplug uevents.
vndbinder_use(hal_graphics_composer_default)
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket {
    bind
    create
    read
    setopt
};

set_prop(hal_graphics_composer_default, mtk_hwc_runtime_prop)
get_prop(surfaceflinger, mtk_hwc_runtime_prop)

# proc_ged is granted r_file_perms, NOT rw. Stock's compiled policy has
#   (allow appdomain proc_ged (file (ioctl read write getattr lock append map open)))
# and the same for surfaceflinger, mediacodec, mtk_hal_gpu and mtk_hal_camera,
# i.e. it hands every application write access to a proprietary GPU driver
# node. The GED interface this stack uses is ioctl-driven; the write path is
# ged_log. No write denial appears in the tier 1 capture
# (work/k50sv1-bringup/evidence/tier1-avc-20260823-postfix/) and the handset
# renders, so the write is not granted on Stock's say-so alone. If
# "avc: denied { write } ... path=/proc/ged" ever shows up, add write+append to
# the specific domain that raised it, not to appdomain.
