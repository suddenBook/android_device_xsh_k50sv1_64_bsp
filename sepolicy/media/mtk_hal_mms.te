type mtk_hal_mms, domain;
type mtk_hal_mms_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(mtk_hal_mms)
hal_server_domain(mtk_hal_mms, hal_mtk_mms)
# No hwbinder_use() here: hal_server_domain() above joins halserverdomain, and
# system/sepolicy/private/halserverdomain.te:6 already applies hwbinder_use()
# to that attribute. Verified in the linked policy: vendor domains land in the
# UNVERSIONED halserverdomain typeattributeset, so the platform rule reaches them.

# The idle on-demand service holds these nodes read-only.  Vcodec is opened by
# the hardware JPEG path and requires bidirectional ioctl buffers.
allow mtk_hal_mms ion_device:chr_file r_file_perms;
allow mtk_hal_mms mtk_cmdq_device:chr_file r_file_perms;
allow mtk_hal_mms video_device:chr_file rw_file_perms;
# No graphics_device (/dev/mtk_disp_mgr) rule: the only graphics node this
# service holds open on the handset is /dev/sw_sync, which is now its own type
# and is granted in media/graphics_stack.te. The display manager belongs to the
# composer and to PQ.

# libJpgEncPipe names this exact JPEG bridge.  This avoids Stock's grant to the
# generic proc type.
allow mtk_hal_mms proc_mtk_jpeg:file r_file_perms;
allowxperm mtk_hal_mms proc_mtk_jpeg:file ioctl { 0x780b-0x780f };

hal_client_domain(mtk_hal_mms, hal_allocator)
hal_client_domain(mtk_hal_mms, hal_graphics_allocator)

# This concrete service also consumes PQ and its non-sensitive tuning
# properties. Keep memberships that expand to typeattribute beside the domain
# declaration instead of relying on cross-file lexical order.
hal_client_domain(mtk_hal_mms, hal_mtk_pq)
get_prop(mtk_hal_mms, mtk_pq_config_prop)
get_prop(mtk_hal_mms, mtk_pq_ro_prop)

# No direct /dev/mali0 or /dev/MTK_SMI access: neither the ELF path strings,
# Stock policy nor live FDs support such a grant.  Buffer FDs arrive over HIDL.
