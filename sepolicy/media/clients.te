# GPU extension consumers proven by Stock policy and the graphics/media stack.
hal_client_domain(surfaceflinger, hal_mtk_gpu)
hal_client_domain(mediaserver, hal_mtk_gpu)

# PQ consumers with live Binder references or direct libdpframework linkage.
hal_client_domain(surfaceflinger, hal_mtk_pq)
hal_client_domain(hal_graphics_composer_default, hal_mtk_pq)
hal_client_domain(hal_camera_default, hal_mtk_pq)
hal_client_domain(mediacodec, hal_mtk_pq)

# MMS consumers in the graphics and media stack.
hal_client_domain(surfaceflinger, hal_mtk_mms)
hal_client_domain(hal_camera_default, hal_mtk_mms)
hal_client_domain(mediacodec, hal_mtk_mms)

# App RenderThreads use GPUAUX's remote MMS path to convert private YUV
# buffers. Match the stock app client set for HwBinder calls and transfers
# of source and destination buffer FDs through the existing MMS HAL rules.
hal_client_domain(ephemeral_app, hal_mtk_mms)
hal_client_domain(platform_app, hal_mtk_mms)
hal_client_domain(priv_app, hal_mtk_mms)
hal_client_domain(system_app, hal_mtk_mms)
hal_client_domain(untrusted_app, hal_mtk_mms)
hal_client_domain(untrusted_app_27, hal_mtk_mms)
hal_client_domain(untrusted_app_25, hal_mtk_mms)

# NO hal_mtk_codecservice clients at all any more, and the HAL itself is now a
# closed loop.
#
# mediacodec was a client for exactly one reason: it hosted libMtkOmxApeDec,
# which linked the client stub. That decoder has been dropped (see
# configs/media_codecs_mediatek_audio.xml), and a sweep of every shipped blob
# now finds the only linkers of vendor.mediatek.hardware.mtkcodecservice@1.1.so
# to be the HAL's own -impl.so and the service binary. `lshal` shows the
# interface declared and never registered, which is correct for a lazy service
# nothing asks for.
#
# mediaserver and system_server were client grants copied from Stock without
# evidence, and one of them was impossible: the stub exists only as a 32-bit
# /vendor/lib object and the service binary is ELF 32-bit, so 64-bit
# system_server could never have loaded it. mediaserver is 32-bit and so not
# impossible, but it maps no /vendor library whatsoever at runtime.
#
# All of it is now removed: the four blobs (service, -impl.so, interface stub,
# rc), the VINTF declaration, mtk_hal_codecservice.te, the exec and hwservice
# labels, the two binder_call lines and the hal_attribute. Removing the blob
# without the VINTF entry would have left a declared HAL nothing can serve, so
# it was one commit.
#
# Provenance for the "no client" claim, independently reconfirmed: a
# binary-inclusive grep for "mtkcodecservice" over the whole built image returns
# only the four files themselves plus their labels and the manifest entry. The
# same grep over the STOCK dump additionally returns vendor/lib/
# libMtkOmxApeDec.so -- the one real client, which this tree deliberately does
# not extract. lshal listed the interface in the not-registered column after 10 h
# of uptime and there was no init.svc property for it, so the lazy service had
# never once been asked for.

# PQ client libraries read the same non-sensitive tuning switches locally.
# Only the PQ service can modify the writable property group.
get_prop({
    surfaceflinger
    hal_graphics_composer_default
    hal_camera_default
    mediacodec
}, mtk_pq_config_prop)

get_prop({
    surfaceflinger
    hal_graphics_composer_default
    hal_camera_default
    mediacodec
}, mtk_pq_ro_prop)

# Hardware identity and the M4U control node are read directly by the shipped
# media stack.  Keep both on dedicated types instead of generic sysfs/proc.
allow {
    hal_audio_default
    hal_camera_default
    mediacodec
} sysfs_mtk_devinfo:file r_file_perms;

# M4U (the multimedia IOMMU) is driven by ioctl, not by reads. Both command
# sets below are taken from Stock's own compiled policy,
# factory_image_unpacked/vendor/etc/selinux/vendor_sepolicy.cil, which is the
# authoritative description of what these exact blobs ask the driver for:
#     (allow mediacodec proc_m4u (file (ioctl read getattr lock map open)))
#     (allowx mediacodec proc_m4u (ioctl file (0x670a)))
#     (allowx mediacodec proc_m4u (ioctl file (0x670b)))
#     (allowx mediacodec proc_m4u (ioctl file (0x671a)))
#     (allowx mediacodec proc_m4u (ioctl file (0x6732)))
#     (allow mtk_hal_camera proc_m4u (file (ioctl read getattr lock map open)))
#     (allowx mtk_hal_camera proc_m4u
#             (ioctl file (((range 0x6704 0x6705)) 0x670b 0x671d 0x6732)))
# Taking that list is not "trusting Stock": it is an enumerated interface, four
# and five command numbers wide, not a range or a wildcard, and each domain gets
# only its own set. That is the standard this tree holds proc_m4u to.
#
# proc_ged is deliberately NOT held to it, and the difference is evidence, not
# laziness -- see media/graphics_stack.te for the working. An earlier revision
# of this comment said Stock's appdomain grant on proc_ged "is exactly the kind
# of blanket grant this tree exists to avoid" while graphics_stack.te granted
# appdomain the identical range four files away. Two things were wrong with
# that. Stock's grant is 0x6700-0x670e AND 0x6764-0x676a, not just the first
# range; and 20 of those 22 values were subsequently proven to be real compiled
# GED commands, 9 of them with a caller shipped in this image. The honest
# statement is that proc_ged is a wide grant this tree keeps on purpose,
# narrowed where it could be (r_file_perms not rw, isolated_app and
# ephemeral_app excluded) but not in its command numbers.
#
# mediacodec previously had no ioctl permission at all, which was not a
# theoretical gap: reproduced on the handset by running screenrecord,
#   avc: denied { ioctl } comm="MtkOmxVencEncod" path="/proc/m4u"
#        ioctlcmd=671a scontext=u:r:mediacodec:s0 tclass=file
# and hal_camera_default had one command number out of five.
allow mediacodec proc_mtk_m4u:file { getattr ioctl lock map open read };
allowxperm mediacodec proc_mtk_m4u:file ioctl { 0x670a 0x670b 0x671a 0x6732 };

allow hal_camera_default proc_mtk_m4u:file { getattr ioctl lock map open read };
allowxperm hal_camera_default proc_mtk_m4u:file ioctl { 0x6704 0x6705 0x670b 0x671d 0x6732 };

# libbwc raises the EMI/SMI bandwidth profile for the duration of a video
# session. Stock grants mediacodec { ioctl read write getattr lock append map
# open } on this node plus dir search; only the four that a text sysfs
# attribute can use are granted here.
# libbwc's EMI/SMI bandwidth reservation. The camera provider needs it for the
# same reason mediacodec does, and it fails the same way: `E/BWC: fail to open
# mem_bw_ctrl driver file`, then an unprioritised profile and dropped frames
# under concurrent capture+encode, with no error reaching the application. DAC
# is not the barrier -- the node is media:media 0664 and camerahalserver is in
# group 1013, which the existence of the AVC already proves.
allow { mediacodec hal_camera_default } sysfs_mtk_concurrency_scenario:file { getattr open read write };

# libbwc also switches the SMI (Smart Multimedia Interface) profile during an
# encode session, and it opens /dev/MTK_SMI to do it. This is the second half
# of the fix recorded in rootdir/etc/init/zz_vendor.media.omx.rc: that file
# added the "media" supplementary group so the DAC check on the node
# (media:media 0660) passes, but the SELinux half was never granted --
# mtk_smi_device was reachable only from hal_camera_default. The rc comment's
# claim that "the node is already labelled and allowed" is true of the label
# and false of the rule, which permissive tier 1 hides.
#   E/BWC: Open SMI(/dev/MTK_SMI) driver file failed.:Permission denied
# Stock's compiled policy:
#   (allow mediacodec MTK_SMI_device (chr_file (ioctl read open)))
allow mediacodec mtk_smi_device:chr_file { ioctl open read };

# NOT granted to mediacodec, deliberately:
#   graphics_device (/dev/mtk_disp_mgr) -- Stock grants it, but the node is
#     system:graphics 0660 and mediacodec runs uid mediacodec gid camera with
#     groups { system drmrpc mediadrm media }, so the DAC check fails first.
#     Only the composer and PQ hold it open on the handset.
#   mtk_sw_sync_device -- Stock grants rw, but /dev/sw_sync is system:graphics
#     0664: mediacodec cannot open it for write, and a timeline consumer works
#     on the fence fd, not on the producer node.
#   gpu_device, ion_device, video_device -- already granted by
#     system/sepolicy/vendor/mediacodec.te:28-31, no device rule needed.
