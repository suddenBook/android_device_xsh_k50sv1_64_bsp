type mtk_hal_pq, domain;
type mtk_hal_pq_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(mtk_hal_pq)
hal_server_domain(mtk_hal_pq, hal_mtk_pq)
# No hwbinder_use() here: hal_server_domain() above joins halserverdomain, and
# system/sepolicy/private/halserverdomain.te:6 already applies hwbinder_use()
# to that attribute. Verified in the linked policy: vendor domains land in the
# UNVERSIONED halserverdomain typeattributeset, so the platform rule reaches them.

# PQ is one of only two processes holding /dev/mtk_disp_mgr open on the handset
# (the other is the composer). It configures the display pipeline, which is a
# write: Stock's compiled policy has
#   (allow mtk_hal_pq graphics_device (chr_file (ioctl read write open)))
# The previous read-only grant was inferred from an idle FD listing, which
# cannot show the open mode.
allow mtk_hal_pq graphics_device:chr_file { getattr ioctl open read write };

# NO fwk_sensor_hwservice grant. AAL is the ambient-light-adaptive display
# path and this chassis has no light sensor, so there is nothing for the probe
# to find; and the grant could not have worked in any case. It is half of a
# pair: fwk_sensor_hwservice is served by system_server, so ISensorManager also
# needs binder_call(mtk_hal_pq, system_server), which this tree does not grant
# and should not. gnss/mnld.te:33-35 and vendor/hal_camera_default.te:26-32
# both grant the pair and say why it is mandatory. Completing it here would be
# widening policy to reach a sensor that does not exist; the `find` alone just
# succeeded and then failed on the first transaction.

hal_client_domain(mtk_hal_pq, hal_allocator)

set_prop(mtk_hal_pq, mtk_pq_config_prop)
get_prop(mtk_hal_pq, mtk_pq_ro_prop)

# NOT GRANTED: nvdata. Stock gives PQ read/write over the whole NVRAM tree
#   (allow mtk_hal_pq nvdata_file (dir (write add_name search)))
#   (allow mtk_hal_pq nvdata_file (file (create getattr open read setattr write)))
#   (allow mtk_hal_pq nvram_data_file (file (... unlink rename ...)))
# for panel calibration records. This board has no PQ record to read:
# /mnt/vendor/nvdata/APCFG/APRDCL on the handset contains exactly
#   AUXADC  FILE_VER  HWMON_ACC  MD_SBP
# and PQ takes its tuning from /vendor/etc instead (vendor_configs_file, which
# every vendor domain can already read). Do not add nvdata access here without
# first showing a record that PQ actually opens.
