type mtk_hal_pq, domain;
type mtk_hal_pq_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(mtk_hal_pq)
hal_server_domain(mtk_hal_pq, hal_mtk_pq)
# No hwbinder_use() here: hal_server_domain() above joins halserverdomain, and
# system/sepolicy/private/halserverdomain.te:6 already applies hwbinder_use()
# to that attribute. Verified in the linked policy: vendor domains land in the
# UNVERSIONED halserverdomain typeattributeset, so the platform rule reaches them.

# PQ is one of only two processes holding /dev/mtk_disp_mgr open on the handset
# (the other is the composer). It configures the display pipeline, which is a
# write: Stock's compiled policy has
#   (allow mtk_hal_pq graphics_device (chr_file (ioctl read write open)))
# The previous read-only grant was inferred from an idle FD listing, which
# cannot show the open mode.
allow mtk_hal_pq graphics_device:chr_file { getattr ioctl open read write };

# AAL probes the framework sensor manager.  With the truthful device sensor
# contract this returns no light sensor; no sensor device access is granted.
allow mtk_hal_pq fwk_sensor_hwservice:hwservice_manager find;

hal_client_domain(mtk_hal_pq, hal_allocator)

set_prop(mtk_hal_pq, mtk_pq_config_prop)
get_prop(mtk_hal_pq, mtk_pq_ro_prop)
