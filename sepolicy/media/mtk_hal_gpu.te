type mtk_hal_gpu, domain;
type mtk_hal_gpu_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(mtk_hal_gpu)
hal_server_domain(mtk_hal_gpu, hal_mtk_gpu)
hwbinder_use(mtk_hal_gpu)

# libged keeps this node open read-only and performs the documented GED ioctl
# families.  Debugfs GED controls and /dev/mali0 are deliberately not exposed.
allow mtk_hal_gpu proc_ged:file r_file_perms;
allowxperm mtk_hal_gpu proc_ged:file ioctl {
    0x6700-0x670e
    0x6764-0x676a
};

# gralloc_extra's diagnostic entry point can inspect an ION allocation supplied
# by a client.  It does not require allocation or write access to /dev/ion.
allow mtk_hal_gpu ion_device:chr_file r_file_perms;
allow mtk_hal_gpu hal_graphics_allocator_default:fd use;
