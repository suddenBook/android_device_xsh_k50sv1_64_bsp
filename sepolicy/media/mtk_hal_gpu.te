type mtk_hal_gpu, domain;
type mtk_hal_gpu_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(mtk_hal_gpu)
hal_server_domain(mtk_hal_gpu, hal_mtk_gpu)
# No hwbinder_use() here: hal_server_domain() above joins halserverdomain, and
# system/sepolicy/private/halserverdomain.te:6 already applies hwbinder_use()
# to that attribute. Verified in the linked policy: vendor domains land in the
# UNVERSIONED halserverdomain typeattributeset, so the platform rule reaches them.

# libged keeps this node open read-only and performs the documented GED ioctl
# families.  Debugfs GED controls and /dev/mali0 are deliberately not exposed.
allow mtk_hal_gpu proc_ged:file r_file_perms;
allowxperm mtk_hal_gpu proc_ged:file ioctl {
    0x6700-0x670e
    0x6764-0x676a
};

# gralloc_extra's diagnostic entry point can inspect an ION allocation supplied
# by a client.  It does not require allocation or write access to /dev/ion.
allow mtk_hal_gpu ion_device:chr_file r_file_perms;
allow mtk_hal_gpu hal_graphics_allocator_default:fd use;

# NOT GRANTED: graphics_device. Stock has
#   (allow mtk_hal_gpu graphics_device (chr_file (ioctl read write getattr lock append map open)))
# but on the live handset the only two processes holding /dev/mtk_disp_mgr open
# are the composer and PQ; this service is not among them. Stock's rule is a
# multi-SKU leftover -- the same file also grants it debugfs_ged, which this
# tree refuses outright.
