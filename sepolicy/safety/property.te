type mtk_thermal_config_prop, property_type;
type mtk_wmt_prop, property_type;

# Thermal safety and the battery/SPM helpers. THREE explicit thermal entries,
# not one `ctl.thermal` prefix: property_contexts is longest-prefix, so a bare
# ctl.thermal would silently swallow ctl.thermal_manager and
# ctl.thermalloadalgod as well and hide the fact that all three were covered by
# accident. See nvram/vendor/property.te for why none has a setter.
type ctl_mtk_thermal_prop, property_type;
type ctl_mtk_thermal_manager_prop, property_type;
type ctl_mtk_thermalloadalgod_prop, property_type;
type ctl_mtk_fuelgauged_prop, property_type;
type ctl_mtk_spm_loader_prop, property_type;
type ctl_mtk_wmt_loader_prop, property_type;
type ctl_mtk_wmt_launcher_prop, property_type;
