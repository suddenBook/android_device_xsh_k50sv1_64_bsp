type mtk_thermal, domain;
type mtk_thermal_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(mtk_thermal)

allow mtk_thermal proc_mtk_thermal:dir r_dir_perms;
allow mtk_thermal proc_mtk_thermal:file rw_file_perms;
allow mtk_thermal proc_mtk_cooler:dir search;

# Thermal policy changes are sent to the modem through the dedicated OEM RIL
# endpoint; no other radio sockets are exposed.
allow mtk_thermal mtk_ril_oem_socket:sock_file write;
allow mtk_thermal mtkrild:unix_stream_socket connectto;

allow mtk_thermal mtk_thermal_data_file:dir search;
allow mtk_thermal mtk_thermal_data_file:file rw_file_perms;

set_prop(mtk_thermal, mtk_thermal_config_prop)

# The thermal coordinator sends policy changes to the local SPA server.
allow mtk_thermal mtk_thermalloadalgod:unix_stream_socket connectto;

allow hal_thermal_default proc_mtk_thermal_zone:dir search;
allow hal_thermal_default proc_mtk_thermal_zone:file r_file_perms;

# IThermal::getCpuUsages() reads /proc/stat. AOSP's public/hal_thermal.te is
# four lines and grants only the binder pair, so this is an AOSP gap rather than
# a board fact -- but it is a HAL domain, and public/app_neverallows.te's
# proc_stat neverallow is scoped to all_untrusted_apps, so nothing forbids it.
# Denied, getCpuUsages() returns an empty list to
# HardwarePropertiesManagerService and every consumer of `dumpsys
# hardware_properties` gets nothing, with no error raised anywhere.
allow hal_thermal_default proc_stat:file r_file_perms;

# NOT GRANTED, and specifically not as r_dir_file(mtk_thermal, sysfs_net):
# /vendor/bin/thermal does carry seven interface operstate paths --
#   /sys/class/net/{wlan0,p2p0,ap0,ccmni,ccemni0,ccemni1,ccemni2}/operstate
# -- but that rule would grant the wrong type and still miss the right one.
# Measured on the handset:
#   * wlan0 and p2p0 resolve through /sys/class/net/<if> (a symlink, which this
#     3.18 kernel leaves on the generic sysfs type) to
#     /sys/devices/soc/180f0000.wifi/net/<if>/operstate, which is sysfs, NOT
#     sysfs_net -- no genfscon covers /devices/soc. A real capture shows it:
#       avc: denied { open } for path="/sys/devices/soc/180f0000.wifi/net/
#            p2p0/type" tcontext=u:object_r:sysfs:s0 tclass=file
#   * only ccmni* live under /devices/virtual/net (AOSP genfs_contexts:129) and
#     so are sysfs_net -- but the names the binary hardcodes are the bare
#     "ccmni" and "ccemni0..2", none of which exist here. The real interfaces
#     are ccmni0..ccmni17, and "ccemni" is not a typo of ours: it is the string
#     in the blob, for some other MTK board.
# So the audited rule would open the ccmni* attributes the daemon never asks
# for and leave the wlan0/p2p0 reads it does ask for still denied. Closing
# those properly means either allow mtk_thermal sysfs:file r_file_perms -- the
# whole generic sysfs, far too broad -- or a genfscon for
# /devices/soc/180f0000.wifi/net, which would move the type out from under
# every other reader of those files. Neither is worth doing without a denial:
# the 303-record permissive capture has no mtk_thermal AVC of any kind, and the
# daemon holds no operstate fd open on the live handset.

# NOT GRANTED, pending evidence: Stock's compiled policy wires the whole media
# stack into the thermal subsystem --
#   (allow mtk_hal_camera  proc_thermal (file (getattr open read write)))
#   (allow mtk_hal_camera  proc_mtktz / proc_mtkcooler (dir (search)) (file (open read write)))
#   (allow mtk_hal_audio   proc_thermal / proc_mtktz / proc_mtkcooler (dir (search)))
#   (allow mediacodec      proc_thermal / proc_mtktz / proc_mtkcooler ...)
#   (allow mtk_hal_power   proc_thermal / proc_mtktz / proc_mtkcooler ... )
#   (allow {those} thermal_manager_data_file (dir/file ...))
#   (allow mtk_hal_camera mtk_thermal_config_prop (property_service (set)))
# none of which is reproduced here. Checked before declining:
#   - work/k50sv1-bringup/evidence/tier1-avc-20260823-postfix/ contains only
#     priv_app and system_app denials, nothing from a media or thermal domain;
#   - on the live handset no process holds /proc/driver/thermal, /proc/mtktz,
#     /proc/mtkcooler or /data/vendor/.tp open outside the three thermal
#     daemons below.
# Thermal throttling here is owned by thermal/thermal_manager/thermalloadalgod
# plus AOSP's hal_thermal_default, and the media stack does not need to read the
# zone temperatures to work. If a real AVC appears, grant the single node the
# denial names -- do not import Stock's whole block.
