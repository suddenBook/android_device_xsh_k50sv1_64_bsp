# Membership of mtk_nvram_storage_file (declared in nvram/vendor/attributes).
#
# The member types are declared across connectivity/, nvram/vendor/ and radio/.
# Collecting every assignment in the LAST directory of BOARD_VENDOR_SEPOLICY_DIRS
# (BoardConfig.mk: ... radio vendor safety) removes the previous dependency on
# that list's exact order -- alphabetising it used to break the build with an
# undefined-type error on the forward references.
typeattribute mtk_nvdata_file        mtk_nvram_storage_file;
typeattribute mtk_accel_nvram_file   mtk_nvram_storage_file;
typeattribute mtk_bt_nvram_file      mtk_nvram_storage_file;
typeattribute mtk_gps_nvram_file     mtk_nvram_storage_file;
typeattribute mtk_audio_nvram_file   mtk_nvram_storage_file;
typeattribute mtk_camera_nvram_file  mtk_nvram_storage_file;
typeattribute mtk_wlan_nvram_file    mtk_nvram_storage_file;
typeattribute mtk_modem_nvdata_file  mtk_nvram_storage_file;
typeattribute mtk_modem_config_file  mtk_nvram_storage_file;
typeattribute mtk_protect_f_file     mtk_nvram_storage_file;
typeattribute mtk_protect_s_file     mtk_nvram_storage_file;
