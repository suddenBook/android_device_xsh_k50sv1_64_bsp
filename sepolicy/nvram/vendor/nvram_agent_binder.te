type nvram_agent_binder, domain;
type nvram_agent_binder_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(nvram_agent_binder)
# No hwbinder_use() here: the hal_server_domain() call below joins
# halserverdomain, and
# system/sepolicy/private/halserverdomain.te:6 already applies hwbinder_use()
# to that attribute. Verified in the linked policy: vendor domains land in the
# UNVERSIONED halserverdomain typeattributeset, so the platform rule reaches them.
hal_server_domain(nvram_agent_binder, hal_mtk_nvram)

# INvram supports reads, writes and explicit full backup/restore operations.
allow nvram_agent_binder self:global_capability_class_set { chown fowner fsetid };

# THIS DOMAIN IS APP-REACHABLE, WHICH IS WHY IT IS NARROWER THAN nvram_daemon.
# Its one client grant is hal_client_domain(radio, hal_mtk_nvram) and `radio` is
# appdomain (system/sepolicy/private/radio.te), so com.android.phone and
# com.mediatek.ims can drive INvram over HwBinder into this process.
#
# AP calibration keeps the full width: losing an accel/bt/gps/audio/camera/wlan
# record costs a recalibration.
allow nvram_agent_binder mtk_nvram_ap_cal_file:dir create_dir_perms;
allow nvram_agent_binder mtk_nvram_ap_cal_file:file create_file_perms;
allow nvram_agent_binder mtk_nvram_ap_cal_file:lnk_file { getattr read unlink };

# The modem/identity records and the nvdata tree structure get READ AND WRITE
# WITHOUT create, unlink, rename or rmdir. An app-reachable path may rewrite a
# record in place; it may not add one, remove one, or restructure the tree.
# mtk_nvdata_file is in this set on purpose -- it labels the /mnt/vendor/nvdata
# mount root plus dm/, APCFG/{,APRDCL,APRDEB}, media/ and the AllFile / AllMap /
# BackupFlag / RestoreFlag metadata, so create_dir_perms on it is "restructure
# the nvdata tree", which nvram/vendor/clients.te refuses to every HAL.
#
# Backed by measurement, not by preference: across three boots of
# eng.desmon.20260831.162649, one of them the first boot after a
# userdata/metadata/cache wipe, the auditallow rules below produced ZERO
# records (E-150). Nothing here removes an operation this daemon was observed
# using. See attributes/attributes.te for the full reasoning and for why
# nvram_daemon deliberately keeps the union.
allow nvram_agent_binder { mtk_nvram_identity_file mtk_nvdata_file }:dir
    { getattr open read search };
allow nvram_agent_binder { mtk_nvram_identity_file mtk_nvdata_file }:file
    rw_file_perms;
allow nvram_agent_binder { mtk_nvram_identity_file mtk_nvdata_file }:lnk_file
    { getattr read };

# Kept, retargeted at what is still granted. If AP calibration ever really
# needs a create this names it; and if the identity set needs one, it arrives
# as a DENIAL instead, which is the point.
auditallow nvram_agent_binder mtk_nvram_ap_cal_file:dir { create rmdir rename };
auditallow nvram_agent_binder mtk_nvram_ap_cal_file:file { create unlink rename };
auditallow nvram_agent_binder mtk_nvram_ap_cal_file:lnk_file unlink;
auditallow nvram_agent_binder mtk_nvram_identity_file:file write;

allow nvram_agent_binder block_device:dir search;
allow nvram_agent_binder mtk_nvram_block_device:blk_file rw_file_perms;
allow nvram_agent_binder mtk_nvdata_block_device:blk_file rw_file_perms;
allow nvram_agent_binder mtk_proinfo_block_device:blk_file rw_file_perms;
# No *_block_device:lnk_file rule: the /dev/block/platform/.../by-name/*
# aliases are always labelled block_device. ueventd applies the by-name
# file_contexts entry to the *device node* via
# SelabelLookupFileContextBestMatch (system/core/init/devices.cpp:263) and then
# creates the symlink with no fscreatecon, so the link inherits its parent
# directory. Reading it is already covered by the platform's
# block_device:lnk_file rule.

allow nvram_agent_binder proc_cmdline:file r_file_perms;
allow nvram_agent_binder sysfs_dt_firmware_android:dir search;
allow nvram_agent_binder sysfs_mtk_boot_mode:file r_file_perms;
allow nvram_agent_binder mnt_vendor_file:dir search;
get_prop(nvram_agent_binder, mtk_nvram_ready_prop)
