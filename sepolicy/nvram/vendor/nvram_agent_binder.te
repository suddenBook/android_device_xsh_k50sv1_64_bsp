type nvram_agent_binder, domain;
type nvram_agent_binder_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(nvram_agent_binder)
hwbinder_use(nvram_agent_binder)
hal_server_domain(nvram_agent_binder, hal_mtk_nvram)

# INvram supports reads, writes and explicit full backup/restore operations.
allow nvram_agent_binder self:capability { chown fowner fsetid };
allow nvram_agent_binder mtk_nvram_storage_file:dir create_dir_perms;
allow nvram_agent_binder mtk_nvram_storage_file:file create_file_perms;
allow nvram_agent_binder mtk_nvram_storage_file:lnk_file { getattr read unlink };

allow nvram_agent_binder block_device:dir search;
allow nvram_agent_binder mtk_nvram_block_device:blk_file rw_file_perms;
allow nvram_agent_binder mtk_nvdata_block_device:blk_file rw_file_perms;
allow nvram_agent_binder mtk_proinfo_block_device:blk_file rw_file_perms;
allow nvram_agent_binder mtk_proinfo_block_device:chr_file rw_file_perms;
allow nvram_agent_binder {
    mtk_nvram_block_device
    mtk_nvdata_block_device
    mtk_proinfo_block_device
}:lnk_file { getattr read };

allow nvram_agent_binder proc_cmdline:file r_file_perms;
allow nvram_agent_binder sysfs_dt_firmware_android:dir search;
allow nvram_agent_binder sysfs_mtk_boot_mode:file r_file_perms;
allow nvram_agent_binder mnt_vendor_file:dir search;
get_prop(nvram_agent_binder, mtk_nvram_ready_prop)
