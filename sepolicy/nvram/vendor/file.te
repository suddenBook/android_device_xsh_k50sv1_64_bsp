# Fixed GPT resources not already owned by the radio policy.  The dedicated
# nvram partition type is declared and labeled by sepolicy/radio.
type mtk_nvdata_block_device, dev_type;
type mtk_proinfo_block_device, dev_type;
type mtk_adc_calibration_device, dev_type;

# NVRAM metadata and the physically present calibration categories.
type mtk_nvdata_file, file_type, data_file_type;
type mtk_accel_nvram_file, file_type, data_file_type;
type mtk_bt_nvram_file, file_type, data_file_type;
type mtk_gps_nvram_file, file_type, data_file_type;
type mtk_audio_nvram_file, file_type, data_file_type;
type mtk_camera_nvram_file, file_type, data_file_type;

# All storage types which the two trusted NVRAM providers must be able to
# migrate, back up and restore.  Types declared by radio/connectivity are
# intentionally reused instead of shadowed here.
attribute mtk_nvram_storage_file;
typeattribute mtk_nvdata_file mtk_nvram_storage_file;
typeattribute mtk_accel_nvram_file mtk_nvram_storage_file;
typeattribute mtk_bt_nvram_file mtk_nvram_storage_file;
typeattribute mtk_gps_nvram_file mtk_nvram_storage_file;
typeattribute mtk_audio_nvram_file mtk_nvram_storage_file;
typeattribute mtk_camera_nvram_file mtk_nvram_storage_file;
typeattribute mtk_wlan_nvram_file mtk_nvram_storage_file;
