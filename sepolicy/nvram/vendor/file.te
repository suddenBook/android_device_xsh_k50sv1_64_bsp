# Fixed GPT resources not already owned by the radio policy.  The dedicated
# nvram partition type is declared and labeled by sepolicy/radio.
type mtk_nvdata_block_device, dev_type;
type mtk_proinfo_block_device, dev_type;
type mtk_adc_calibration_device, dev_type;

# NVRAM metadata and the physically present calibration categories.
type mtk_nvdata_file, file_type, data_file_type, mtk_nvram_storage_file;
# DELIBERATELY CONSUMER-LESS, like ctl_mtk_ccci_rpcd_prop and the four unused
# mtk_ril_*_socket types. It has zero non-comment references: every sibling in
# this file has exactly one grant in clients.te, and this one has none, because
# HWMON_ACC appears in only three shipped blobs -- nvram_daemon and
# libcustom_nvram.so 32/64 -- all of which already reach it through
# mtk_nvram_storage_file. hal_sensors_default is deliberately kept off
# /mnt/vendor beyond `dir search` (vendor/hal_sensors_default.te), so there is
# no second claimant. The label exists so the accelerometer calibration record
# is not indistinguishable from the rest of nvdata if one is ever needed.
type mtk_accel_nvram_file, file_type, data_file_type, mtk_nvram_storage_file, mtk_nvram_ap_cal_file;
type mtk_bt_nvram_file, file_type, data_file_type, mtk_nvram_storage_file, mtk_nvram_ap_cal_file;
type mtk_gps_nvram_file, file_type, data_file_type, mtk_nvram_storage_file, mtk_nvram_ap_cal_file;
type mtk_audio_nvram_file, file_type, data_file_type, mtk_nvram_storage_file, mtk_nvram_ap_cal_file;
type mtk_camera_nvram_file, file_type, data_file_type, mtk_nvram_storage_file, mtk_nvram_ap_cal_file;

# mtk_nvram_storage_file is declared centrally in
# sepolicy/attributes/attributes.te. Each storage type joins it directly in its
# own declaration, including the six types above.

# The fstab notrim flag excludes nvdata/protect from vold's maintenance list
# in every tier. Keep vold's FITRIM/open access ungranted as a separate boundary
# for unexpected requests; routine maintenance must not rely on a denied ioctl.
