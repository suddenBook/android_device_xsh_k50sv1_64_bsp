type nvram_daemon, domain;
type nvram_daemon_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(nvram_daemon)

# The boot-time migrator owns NVRAM file modes and backup metadata.
allow nvram_daemon self:global_capability_class_set { chown fowner fsetid };

allow nvram_daemon mtk_nvram_storage_file:dir create_dir_perms;
allow nvram_daemon mtk_nvram_storage_file:file create_file_perms;
allow nvram_daemon mtk_nvram_storage_file:lnk_file { getattr read unlink };
# Measure the destructive half so the attribute can be narrowed with evidence
# instead of a guess; see attributes/attributes.te for why it is still this
# wide. One boot's worth of records is the whole cost.
auditallow nvram_daemon mtk_nvram_storage_file:dir { create rmdir rename };
auditallow nvram_daemon mtk_nvram_storage_file:file { create unlink rename };
auditallow nvram_daemon mtk_nvram_storage_file:lnk_file unlink;

allow nvram_daemon block_device:dir search;
allow nvram_daemon mtk_nvram_block_device:blk_file rw_file_perms;
allow nvram_daemon mtk_nvdata_block_device:blk_file rw_file_perms;
allow nvram_daemon mtk_proinfo_block_device:blk_file rw_file_perms;
# No *_block_device:lnk_file rule: the /dev/block/platform/.../by-name/*
# aliases are always labelled block_device. ueventd applies the by-name
# file_contexts entry to the *device node* via
# SelabelLookupFileContextBestMatch (system/core/init/devices.cpp:263) and then
# creates the symlink with no fscreatecon, so the link inherits its parent
# directory. Reading it is already covered by the platform's
# block_device:lnk_file rule.

# Only the verified MIR3DA accelerometer calibration callback is active.
allow nvram_daemon mtk_accelerometer_device:chr_file r_file_perms;

# AUXADC is a real battery/charger calibration interface, not an ALS/PS sensor.
allow nvram_daemon mtk_adc_calibration_device:chr_file rw_file_perms;

allow nvram_daemon proc_cmdline:file r_file_perms;
allow nvram_daemon sysfs_dt_firmware_android:dir search;
allow nvram_daemon sysfs_dt_firmware_android:file r_file_perms;
allow nvram_daemon sysfs_mtk_boot_mode:file r_file_perms;

allow nvram_daemon mnt_vendor_file:dir search;
set_prop(nvram_daemon, mtk_nvram_ready_prop)
get_prop(nvram_daemon, mtk_radio_config_prop)
