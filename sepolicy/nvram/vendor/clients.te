# Stock exposes the HIDL service to the phone process.  No other retained blob
# links the vendor NVRAM HIDL interface; camera/audio/Wi-Fi/BT use libnvram
# directly and therefore receive only their category files below.
hal_client_domain(radio, hal_mtk_nvram)

# Relabeling nvdata's real directory hierarchy requires explicit traversal for
# the existing radio and connectivity domains.
allow {
    ccci_fsd
    ccci_mdinit
    rild
    mtkrild
    wlan_assistant
    hal_camera_default
    hal_audio_default
    hal_wifi_default
    hal_bluetooth_default
} mtk_nvdata_file:dir search;

# libnvram validates the common FILE_VER record before opening a category
# file.  It is metadata, not a calibration payload.
allow {
    hal_camera_default
    hal_audio_default
    hal_wifi_default
    hal_bluetooth_default
} mtk_nvdata_file:file r_file_perms;

# libnvram resolves its record paths through the nvdata tree and follows any
# symlink it meets on the way. `allow domain dev_type:lnk_file r_file_perms`
# (public/domain.te:64) covers device nodes only, not file_type, so a symlink
# under /mnt/vendor/nvdata is unreadable without this. Stock grants
# nvdata_file:lnk_file read to essentially every libnvram client.
allow {
    ccci_fsd
    ccci_mdinit
    rild
    mtkrild
    wlan_assistant
    mnld
    hal_camera_default
    hal_audio_default
    hal_wifi_default
    hal_bluetooth_default
    nvram_daemon
    nvram_agent_binder
} mtk_nvdata_file:lnk_file r_file_perms;

allow {
    hal_camera_default
    hal_audio_default
    hal_wifi_default
    hal_bluetooth_default
} mnt_vendor_file:dir search;

allow hal_camera_default mtk_camera_nvram_file:file { getattr open read write };
allow hal_audio_default mtk_audio_nvram_file:file { getattr open read write };
allow hal_wifi_default mtk_wlan_nvram_file:file { getattr open read write };
allow hal_bluetooth_default mtk_bt_nvram_file:file { getattr open read write };

# libnvram/libnvram_sec resolve the fixed eMMC layout and encryption mode even
# when a client opens only one category record.
allow {
    hal_camera_default
    hal_audio_default
    hal_wifi_default
    hal_bluetooth_default
} proc_cmdline:file r_file_perms;
allow {
    hal_camera_default
    hal_audio_default
    hal_wifi_default
    hal_bluetooth_default
} sysfs_dt_firmware_android:dir search;
allow {
    hal_camera_default
    hal_audio_default
    hal_wifi_default
    hal_bluetooth_default
} sysfs_dt_firmware_android:file r_file_perms;
allow {
    hal_camera_default
    hal_audio_default
    hal_wifi_default
    hal_bluetooth_default
} sysfs_mtk_boot_mode:file r_file_perms;

get_prop(hal_audio_default, mtk_radio_config_prop)
allow hal_audio_default sysfs_mtk_ccci:dir search;
allow hal_audio_default sysfs_mtk_ccci:file r_file_perms;

get_prop(hal_bluetooth_default, mtk_wmt_prop)

get_prop({
    rild
    mtkrild
    wlan_assistant
    hal_camera_default
    hal_audio_default
    hal_wifi_default
    hal_bluetooth_default
}, mtk_nvram_ready_prop)

# NOT GRANTED: mtk_nvdata_file:dir { write add_name create }. Stock lets
# libnvram CREATE a missing record in place --
#   (allow mtk_hal_camera nvdata_file (dir (write create add_name search)))
#   (allow mtk_hal_audio  nvdata_file (dir (add_name open remove_name write)))
# -- which is how a blank nvdata partition self-provisions on a factory line.
# Here every record that this build reads already exists on the partition, and
# the whole point of the per-category types above is that a HAL can rewrite its
# own calibration blob without being able to add or remove entries in the
# directory. Only revisit this if the device is ever built to bring up a
# freshly-erased nvdata.
