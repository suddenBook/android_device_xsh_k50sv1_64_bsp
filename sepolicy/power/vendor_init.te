# vendor_init property writes.
#
# /vendor/build.prop -- which the build appends device/xsh/k50sv1_64_bsp/vendor.prop
# to (build/make/core/Makefile:489) -- and every setprop in a /vendor rc file are
# evaluated in the vendor_init context, not init:
#   system/core/init/subcontext.cpp:56-58   {"/vendor", kVendorContext="u:r:vendor_init:s0"}
#   system/core/init/property_service.cpp:656-663, 726
#       LoadProperties() picks that context by path prefix and then calls
#       CheckPermissions(), which is a real selinux_check_access() on
#       <type>:property_service:set.
#
# The set_prop(vendor_init, ...) rule(s) below are INERT on this product:
# public/vendor_init.te:193-215 expands here and already grants vendor_init every
# property_type. They are kept for the day PRODUCT_SHIPPING_API_LEVEL is raised
# above 27 -- full explanation at sepolicy/gnss/vendor_init.te.

# rootdir/etc/init/vendor.mediatek.hardware.mtkpower@1.0-service.rc:7
#   setprop vendor.powerhal.init 0
set_prop(vendor_init, mtk_powerhal_prop)

# No set_prop(vendor_init, mtk_netdagent_config_prop): that type is gone with
# the one dead property it labelled.
