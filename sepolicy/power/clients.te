# These vendor stack processes have direct, verified HIDL power calls.  The
# existing AOSP system_server and surfaceflinger power relationships remain in
# platform policy.
hal_client_domain(hal_audio_default, hal_power)
hal_client_domain(hal_camera_default, hal_power)
hal_client_domain(hal_graphics_composer_default, hal_power)
hal_client_domain(mediacodec, hal_power)

# libperfctl's in-process clients reach /proc/perfmgr/perf_ioctl directly.
#
# appdomain is deliberately NOT in this set, and was removed after review.
# Three reasons, in order of weight:
#   1. No AVC in any capture on this handset names proc_mtk_power_perf_ioctl or
#      /proc/perfmgr/perf_ioctl from an app domain. The set was inherited from
#      Stock, which is the practice this tree exists to reject.
#   2. It cannot work anyway: init.mt6755.rc chowns the node system:system 0660,
#      so an app (uid 10xxx) fails the DAC check before SELinux is consulted.
#      The rule was simultaneously dead and a standing grant.
#   3. What it would grant is CPU frequency and core pinning to every installed
#      app -- including untrusted_app -- the moment those modes change.
# If a named app-domain AVC ever appears, add that one domain here.
allow {
    bootanim
    cameraserver
    mediaserver
    surfaceflinger
    system_server
} proc_mtk_power_perf_ioctl:file { getattr ioctl open read };

allowxperm {
    bootanim
    cameraserver
    mediaserver
    surfaceflinger
    system_server
} proc_mtk_power_perf_ioctl:file ioctl {
    0x6701
    0x6703
    0x670f-0x6710
};

# SurfaceFlinger additionally uses the compositor-specific command.
allowxperm surfaceflinger proc_mtk_power_perf_ioctl:file ioctl 0x6705;
