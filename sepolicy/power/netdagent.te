type netdagent, domain;
type netdagent_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(netdagent)
hwbinder_use(netdagent)
add_hwservice(netdagent, mtk_netdagent_hwservice)
create_pty(netdagent)

# netdagent spawns ip/tc/iptables, and AOSP transitions those to its own
# constrained netutils_wrapper domain. Both halves of that were denied on this
# handset at every boot until this rule pair was restored:
#
#   avc: denied { use } for comm="iptables-wrappe" path="/dev/pts/0"
#        scontext=u:r:netutils_wrapper:s0 tcontext=u:r:netdagent:s0 tclass=fd
#   avc: denied { read write } for comm="iptables-wrappe" path="/dev/pts/0"
#        scontext=u:r:netutils_wrapper:s0
#        tcontext=u:object_r:netdagent_devpts:s0 tclass=chr_file
#
# 30 of them in one boot, i.e. every firewall command netdagent issues.
#
# An earlier revision deleted these two rules and argued at length that they
# were unreachable because "no platform domain_auto_trans to netutils_wrapper
# exists; the only ones are in device/qcom/sepolicy". That is wrong.
# system/sepolicy/private/netutils_wrapper.te:31-35 is
#
#     domain_auto_trans({ domain -coredomain -appdomain },
#                       netutils_wrapper_exec, netutils_wrapper)
#
# -- a platform-wide transition for every non-core, non-app domain, which is
# exactly what netdagent is. It spans five lines, which is why a single-line
# grep missed it. create_pty(netdagent) above is load-bearing for the same
# reason: the pty in the denials is netdagent's.
#
# The transition is AOSP's, so nothing needs adding by hand. Only the two
# permissions that let the child use the fd it inherits:
allow netutils_wrapper netdagent:fd use;
allow netutils_wrapper netdagent_devpts:chr_file { read write };

# libpowerhal uses the priority firewall commands for network boost.  The
# retained rilproxy (rild domain) uses set_plmn_iface_rule for the ordinary
# modem data path.  Do not expose this operator helper to shell, applications,
# or unrelated vendor domains.
allow hal_power_default mtk_netdagent_hwservice:hwservice_manager find;
binder_call(hal_power_default, netdagent)
allow rild mtk_netdagent_hwservice:hwservice_manager find;
binder_call(rild, netdagent)

# netdagent is a private operator helper, not a HAL, so it is registered with a
# bare add_hwservice() instead of hal_attribute()/hal_attribute_hwservice().
# That means it does not get the closed client/server neverallow those macros
# generate, and nothing would stop a later rule handing this priority-firewall
# interface to another domain. State the invariant explicitly instead.
neverallow {
    domain
    -netdagent
    -hal_power_default
    -rild
} mtk_netdagent_hwservice:hwservice_manager { add find };

# Direct interface setup is limited to the datagram and route-netlink calls in
# libifcutils_mtk.
allow netdagent self:udp_socket { create ioctl };
allowxperm netdagent self:udp_socket ioctl {
    SIOCGIFFLAGS
    SIOCSIFFLAGS
};
allow netdagent self:netlink_route_socket {
    bind
    connect
    create
    getattr
    nlmsg_read
    nlmsg_write
    read
    setopt
    write
};
allow netdagent self:global_capability_class_set net_admin;

allow netdagent proc_mtk_netdagent_arp:file { getattr open read };

set_prop(netdagent, mtk_netdagent_prop)
get_prop(netdagent, mtk_netdagent_config_prop)
get_prop(netdagent, hwservicemanager_prop)
