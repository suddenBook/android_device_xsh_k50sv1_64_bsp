# Both MTK power interface families are served from hal_power_default and use
# AOSP's existing HAL client/server contract. lshal on the handset shows exactly
# these four instances: mtkpower@1.0::IMtkPerf/default, mtkpower@1.0::IMtkPower/
# default, power@2.0::IPower/default and power@2.1::IPower/default.
# vendor.mediatek.hardware.power::IPerf is never registered and was removed.
vendor.mediatek.hardware.mtkpower::IMtkPerf   u:object_r:hal_power_hwservice:s0
vendor.mediatek.hardware.mtkpower::IMtkPower  u:object_r:hal_power_hwservice:s0
vendor.mediatek.hardware.power::IPower        u:object_r:hal_power_hwservice:s0

vendor.mediatek.hardware.netdagent::INetdagent u:object_r:mtk_netdagent_hwservice:s0
