# The executable is intentionally mapped to AOSP hal_power_default: one
# process publishes android.hardware.power@1.3 and both MTK power families.

# Board configuration retains the standard read-only vendor_configs label;
# only private persistent state needs a device type.
allow hal_power_default mtk_powerhal_data_file:dir {
    add_name
    getattr
    open
    read
    remove_name
    search
    write
};
allow hal_power_default mtk_powerhal_data_file:file {
    append
    create
    getattr
    open
    read
    rename
    setattr
    unlink
    write
};

# Exact core-hint kernel controls present on the captured kernel.
allow hal_power_default proc_mtk_power_perf_ioctl:file {
    getattr
    ioctl
    open
    read
    write
};
allowxperm hal_power_default proc_mtk_power_perf_ioctl:file ioctl 0x670a;

allow hal_power_default {
    proc_mtk_power_ppm
    proc_mtk_power_hps
    proc_mtk_power_perfmgr
}:file { getattr open read write };

allow hal_power_default proc_mtk_power_info:file r_file_perms;
dontaudit hal_power_default proc_mtk_power_fliper:file getattr;

allow hal_power_default sysfs_mtk_power_cpu_info:file { getattr open read };
allow hal_power_default {
    sysfs_mtk_power_cpu_control
    sysfs_mtk_power_storage_control
}:file { getattr open read write };

# libpowerhal's Wi-Fi hint path writes an event to the dedicated WMT node. Its
# fallback private wlan0 ioctl is intentionally not granted: AOSP forbids a
# Power HAL from owning network sockets or NET_ADMIN, and falsely making this
# process a Wi-Fi HAL would collapse two HAL security boundaries. Tier 1 will
# retain the denial as AVC evidence while the real Wi-Fi HAL owns wlan0.
allow hal_power_default mtk_wmt_wifi_device:chr_file { open write };

set_prop(hal_power_default, mtk_powerhal_prop)
set_prop(hal_power_default, mtk_thermal_config_prop)
