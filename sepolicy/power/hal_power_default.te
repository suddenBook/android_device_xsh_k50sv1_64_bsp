# The executable is intentionally mapped to AOSP hal_power_default: one
# process publishes android.hardware.power@1.3 and both MTK power families.
# The MTK families sit on their own attribute so they are not reachable by
# every hal_power_client; see power/hwservice.te.
hal_server_domain(hal_power_default, hal_mtk_power)

# Board configuration retains the standard read-only vendor_configs label;
# only private persistent state needs a device type.
allow hal_power_default mtk_powerhal_data_file:dir {
    add_name
    getattr
    open
    read
    remove_name
    search
    write
};
allow hal_power_default mtk_powerhal_data_file:file {
    append
    create
    getattr
    open
    read
    rename
    setattr
    unlink
    write
};
# libpowerhal also binds a UNIX socket inside its own state directory. Stock's
# compiled policy has the whole create_file_perms set on
#   (allow mtk_hal_power mtk_powerhal_data_file (sock_file (...)))
# and a sock_file needs create/unlink, not just write.
allow hal_power_default mtk_powerhal_data_file:sock_file create_file_perms;

# Exact core-hint kernel controls present on the captured kernel.
allow hal_power_default proc_mtk_power_perf_ioctl:file {
    getattr
    ioctl
    open
    read
    write
};
allowxperm hal_power_default proc_mtk_power_perf_ioctl:file ioctl 0x670a;

allow hal_power_default {
    proc_mtk_power_ppm
    proc_mtk_power_hps
    proc_mtk_power_perfmgr
}:file { getattr open read write };

allow hal_power_default proc_mtk_power_info:file r_file_perms;

# libpowerhal stats /proc/fliper during init to decide whether the legacy
# fliper path is available. The node *does* exist on this kernel (verified on
# the handset), so the stat must succeed -- the previous dontaudit hid a probe
# that would silently return the wrong answer in enforcing. Only getattr is
# ever requested:
#   avc: denied { getattr } for comm="mtkPowerManager" path="/proc/fliper"
allow hal_power_default proc_mtk_power_fliper:file getattr;

# libpowerhal reads this integer once while mapping its existing GPU hint
# levels. This neither exposes the rest of GED debugfs nor changes any power
# table, governor threshold, or screen-on policy.
allow hal_power_default debugfs_mtk_ged_gpu_freq_count:file {
    open
    read
};

# scaling_available_frequencies is read as sysfs_devices_system_cpu through
# public/domain.te:210; no rule is needed and sysfs_mtk_power_cpu_info is gone.
allow hal_power_default {
    sysfs_mtk_power_cpu_control
    sysfs_mtk_power_storage_control
}:file { getattr open read write };

# NOT GRANTED: mtk_wmt_wifi_device (/dev/wmtWifi).
#
# libpowerhal's Wi-Fi hint path would write an event to the WMT node. The
# previous revision allowed { open write } here while the comment above it
# argued that making the Power HAL a Wi-Fi HAL "would collapse two HAL security
# boundaries" -- but /dev/wmtWifi IS the Wi-Fi function's power switch: writing
# it turns the combo chip's WLAN function on and off. Granting the write is the
# boundary collapse the comment was refusing.
#
# Nothing is lost. On the handset /dev/wmtWifi has no openers at all, the Wi-Fi
# hint is an optimisation, and connectivity/wlan_assistant.te now carries a
# neverallow keeping the node to the real Wi-Fi HAL and the calibration loader.
# If a denial ever shows up here, the fix is a HIDL call into the Wi-Fi HAL,
# not a second writer on the node.

set_prop(hal_power_default, mtk_powerhal_prop)
# Read, not write. The Power HAL consumes vendor.thermal.manager.data; the
# thermal daemons own it. Granting set here is the same boundary crossing this
# file refuses two rules below for /dev/wmtWifi and mtk_ril_oem_socket, and no
# AVC in any capture asks for it.
get_prop(hal_power_default, mtk_thermal_config_prop)

# NOT GRANTED: mtk_ril_oem_socket. Stock has
#   (allow mtk_hal_power rild_oem_socket (sock_file (write)))
# so its power HAL can push hints straight into the RIL. Here the only writer
# of that socket is mtk_thermal (safety/thermal.te), which is the process that
# genuinely has something to tell the modem. Giving the Power HAL a second,
# unaudited path into the radio stack is exactly the boundary crossing the
# /dev/wmtWifi note above rejects.

# perfUserScnCheckAll stats /proc/<camera-provider-pid> to check the owner of
# an active performance request. On any stat error it disables and resets the
# request, independently of power_whitelist_cfg.xml. The service also needs
# readproc in init because /proc uses hidepid=2. Allow metadata for the observed
# camera provider only; this does not grant reading its proc files.
allow hal_power_default hal_camera_default:dir getattr;
