# Netdagent is not a general networking HAL.  Its private HIDL endpoint is
# exposed only to the power HAL in netdagent.te.
type mtk_netdagent_hwservice, hwservice_manager_type;

# MTK's private power/perf extension interfaces. AOSP's own
# android.hardware.power@1.0-1.3::IPower stays on hal_power_hwservice via
# system/sepolicy/private/hwservice_contexts -- only the vendor.mediatek.*
# instances move here, so the standard Power HAL contract is untouched.
type mtk_hal_power_hwservice, hwservice_manager_type;

binder_call(hal_mtk_power_client, hal_mtk_power_server)
binder_call(hal_mtk_power_server, hal_mtk_power_client)
hal_attribute_hwservice(hal_mtk_power, mtk_hal_power_hwservice)

# The client set was empty by design, on the reasoning that `lshal --types=b`
# showed all four MTK instances with an empty client column and that
# libperfctl's in-process clients use the /proc/perfmgr ioctl path rather than
# HIDL. hal_attribute_hwservice() expands to
#   neverallow { domain -hal_mtk_power_client -hal_mtk_power_server }
#           mtk_hal_power_hwservice:hwservice_manager find;
# so the prediction was that a real consumer would show up as a named AVC on
# tier 1 and need exactly one hal_client_domain() line. That is what happened.
# Three appeared in one boot:
#
#   interface=vendor.mediatek.hardware.power::IPower      sid=u:r:hal_camera_default:s0
#   interface=vendor.mediatek.hardware.mtkpower::IMtkPower sid=u:r:hal_audio_default:s0
#   interface=vendor.mediatek.hardware.mtkpower::IMtkPower sid=u:r:mediacodec:s0
#
# All three are legitimate: the MTK camera, audio and codec stacks raise perf
# hints through libpowerhalwrap, which binds these interfaces. Denying them
# does not fail safe -- it silently drops the boost, which on this part is the
# difference between a codec session that keeps up and one that drops frames.
# `lshal`'s empty client column was measuring the wrong thing: it lists
# registered clients at the instant it runs, and these are transient binds.
hal_client_domain(hal_camera_default, hal_mtk_power)
hal_client_domain(hal_audio_default, hal_mtk_power)
hal_client_domain(mediacodec, hal_mtk_power)
