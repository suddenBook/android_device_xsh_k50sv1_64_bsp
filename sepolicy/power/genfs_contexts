# Power HAL ioctl endpoint.  This type is also shared with the proven
# libperfctl clients, each with a constrained ioctl command set.
genfscon proc /perfmgr/perf_ioctl u:object_r:proc_mtk_power_perf_ioctl:s0

# PPM core/frequency constraints used by the shipped power tables.
genfscon proc /ppm/policy/userlimit_min_cpu_core u:object_r:proc_mtk_power_ppm:s0
genfscon proc /ppm/policy/userlimit_min_cpu_freq u:object_r:proc_mtk_power_ppm:s0
genfscon proc /ppm/policy/userlimit_max_cpu_core u:object_r:proc_mtk_power_ppm:s0
genfscon proc /ppm/policy/userlimit_max_cpu_freq u:object_r:proc_mtk_power_ppm:s0
genfscon proc /ppm/policy_status                 u:object_r:proc_mtk_power_ppm:s0
genfscon proc /ppm/root_cluster                  u:object_r:proc_mtk_power_ppm:s0
genfscon proc /ppm/mode                          u:object_r:proc_mtk_power_ppm:s0

# HPS controls which are present on this kernel.
genfscon proc /hps/num_limit_power_serv u:object_r:proc_mtk_power_hps:s0
genfscon proc /hps/num_base_perf_serv   u:object_r:proc_mtk_power_hps:s0
genfscon proc /hps/up_threshold         u:object_r:proc_mtk_power_hps:s0
genfscon proc /hps/down_threshold       u:object_r:proc_mtk_power_hps:s0

# Legacy perfserv controls retained by the current power table implementation.
genfscon proc /perfmgr/legacy/perfserv_core u:object_r:proc_mtk_power_perfmgr:s0
genfscon proc /perfmgr/legacy/perfserv_freq u:object_r:proc_mtk_power_perfmgr:s0

# Netdagent only parses ARP entries; it has no blanket /proc/net access.
genfscon proc /net/arp u:object_r:proc_mtk_netdagent_arp:s0

# Read-only topology/frequency discovery.
genfscon sysfs /devices/system/cpu/possible u:object_r:sysfs_mtk_power_cpu_info:s0
genfscon sysfs /devices/system/cpu/cpu0/cpufreq/scaling_available_frequencies u:object_r:sysfs_mtk_power_cpu_info:s0
genfscon sysfs /devices/system/cpu/cpu1/cpufreq/scaling_available_frequencies u:object_r:sysfs_mtk_power_cpu_info:s0
genfscon sysfs /devices/system/cpu/cpu4/cpufreq/scaling_available_frequencies u:object_r:sysfs_mtk_power_cpu_info:s0

# Writable cpufreq controls which exist on the captured board.
genfscon sysfs /devices/system/cpu/cpu0/cpufreq/scaling_min_freq u:object_r:sysfs_mtk_power_cpu_control:s0
genfscon sysfs /devices/system/cpu/cpu0/cpufreq/scaling_max_freq u:object_r:sysfs_mtk_power_cpu_control:s0
genfscon sysfs /devices/system/cpu/cpu1/cpufreq/scaling_min_freq u:object_r:sysfs_mtk_power_cpu_control:s0
genfscon sysfs /devices/system/cpu/cpu1/cpufreq/scaling_max_freq u:object_r:sysfs_mtk_power_cpu_control:s0
genfscon sysfs /devices/system/cpu/cpu4/cpufreq/scaling_min_freq u:object_r:sysfs_mtk_power_cpu_control:s0
genfscon sysfs /devices/system/cpu/cpu4/cpufreq/scaling_max_freq u:object_r:sysfs_mtk_power_cpu_control:s0
genfscon sysfs /devices/system/cpu/cpufreq/interactive/hispeed_freq u:object_r:sysfs_mtk_power_cpu_control:s0
genfscon sysfs /devices/system/cpu/cpufreq/interactive/min_sample_time u:object_r:sysfs_mtk_power_cpu_control:s0
genfscon sysfs /devices/system/cpu/cpufreq/interactive/above_hispeed_delay u:object_r:sysfs_mtk_power_cpu_control:s0

# Canonical sysfs backing path for /sys/block/mmcblk0/queue/read_ahead_kb.
genfscon sysfs /devices/mtk-msdc.0/11230000.msdc0/mmc_host/mmc0/mmc0:0001/block/mmcblk0/queue/read_ahead_kb u:object_r:sysfs_mtk_power_storage_control:s0
