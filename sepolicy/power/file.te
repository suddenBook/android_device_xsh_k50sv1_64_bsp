# Persistent state for the board-specific power service.
type mtk_powerhal_data_file, file_type, data_file_type;

# Read-only GED capability count used while libpowerhal builds its GPU-level
# map. Do not label the whole /ged tree.
type debugfs_mtk_ged_gpu_freq_count, fs_type, debugfs_type;

# Only the live, core-hint nodes are split out of procfs and sysfs.  Keeping
# them in separate types prevents the power HAL from inheriting access to the
# rest of the MTK performance/debug surfaces.
type proc_mtk_power_perf_ioctl, fs_type, proc_type;
type proc_mtk_power_ppm, fs_type, proc_type;
type proc_mtk_power_info, fs_type, proc_type;
type proc_mtk_power_hps, fs_type, proc_type;
type proc_mtk_power_perfmgr, fs_type, proc_type;
type proc_mtk_power_fliper, fs_type, proc_type;
# proc_net_type is NOT optional on a type that replaces part of /proc/net.
# AOSP declares proc_net with it (system/sepolicy/public/file.te:44), and it
# is the attribute every legitimate /proc/net grant hangs off: domain.te:26,
# shell.te:134, dumpstate.te:176, init.te:307, vendor_init.te:157, netd.te:49,
# system_server.te:850, wificond.te:24, hal_wifi*, hal_telephony.te:38,
# dhcp.te:18, clatd.te:7, ppp.te:8, mdnsd.te:12, netutils_wrapper.te:9,
# platform_app.te:50 and app.te:185. Omitting it silently took /proc/net/arp
# away from all of them -- `adb shell cat /proc/net/arp` and the bugreport
# /proc/net dump both stopped working. netdagent's own narrow grant in
# power/netdagent.te is unaffected, so no blanket access comes back with it.
type proc_mtk_netdagent_arp, fs_type, proc_type, proc_net_type;

type sysfs_mtk_power_cpu_control, fs_type, sysfs_type;

# Relabelling scaling_min_freq/scaling_max_freq and the interactive governor
# knobs out of sysfs_devices_system_cpu is what lets only the Power HAL and
# vendor_init WRITE them. It also silently removed the READ that
# system/sepolicy/public/domain.te:210 grants every domain on that tree --
# scaling_max_freq in particular is read by system_server, dumpstate,
# incidentd (private/incidentd.te:35), perfprofd (public/perfprofd.te:17) and
# routinely by apps. Put the read back; keep the write private.
# isolated_app is excluded because private/isolated_app.te:127-133 neverallows
# it any sysfs_type read outside sysfs_devices_system_cpu,
# sysfs_transparent_hugepage and sysfs_usb -- the build fails otherwise. That
# is a real, unavoidable consequence of relabelling: an isolated_app (WebView
# renderer, sandboxed service) can no longer read scaling_max_freq. Accepted;
# the alternative is granting the Power HAL write on the whole
# sysfs_devices_system_cpu tree, which is far broader.
allow { domain -isolated_app } sysfs_mtk_power_cpu_control:file r_file_perms;
type sysfs_mtk_power_storage_control, fs_type, sysfs_type;
type sysfs_mtk_io_scheduler, fs_type, sysfs_type;
