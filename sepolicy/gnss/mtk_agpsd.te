type mtk_agpsd, domain;
type mtk_agpsd_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(mtk_agpsd)
net_domain(mtk_agpsd)

# Live Stock evidence shows this as the daemon's sole persistent hardware FD.
allow mtk_agpsd mtk_agps_serial_device:chr_file rw_file_perms;

allow mtk_agpsd mtk_agps_data_file:dir create_dir_perms;
allow mtk_agpsd mtk_agps_data_file:file create_file_perms;
allow mtk_agpsd mtk_agps_data_file:sock_file create_file_perms;

# secgps.conf is shared with MNL under the board-owned GPS directory. Vendor
# configuration and CA files keep the standard read-only vendor_configs label.
allow mtk_agpsd mtk_gps_data_file:dir create_dir_perms;
allow mtk_agpsd mtk_gps_data_file:file create_file_perms;

get_prop(mtk_agpsd, mtk_gnss_runtime_prop)
get_prop(mtk_agpsd, mtk_gnss_ro_prop)
