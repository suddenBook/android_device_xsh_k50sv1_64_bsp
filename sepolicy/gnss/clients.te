# The clean Android framework owns all currently live LBS HIDL references.  Do
# not reintroduce Stock's lbs_dbg, meta, platform-app or arbitrary app clients.
hal_client_domain(system_server, hal_mtk_lbs)

# The phone process is a legacy direct client. Keep its discovery/call edge
# one-way rather than adding radio to the bidirectional HAL client attribute.
allow radio mtk_hal_lbs_hwservice:hwservice_manager find;
