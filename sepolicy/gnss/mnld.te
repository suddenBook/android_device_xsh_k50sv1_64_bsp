type mnld, domain;
type mnld_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(mnld)
net_domain(mnld)
hwbinder_use(mnld)
wakelock_use(mnld)

allow mnld mtk_gnss_device:chr_file rw_file_perms;

allow mnld mtk_gps_data_file:dir create_dir_perms;
allow mnld mtk_gps_data_file:file create_file_perms;

# The legacy MNL/AGPS exchange creates socket files below the private SUPL
# directory, but mnld does not own arbitrary AGPS configuration files.
allow mnld mtk_agps_data_file:dir create_dir_perms;
allow mnld mtk_agps_data_file:sock_file create_file_perms;

# Only the two GPS calibration records referenced by this exact MT6755 binary.
allow mnld mnt_vendor_file:dir search;
allow mnld mtk_modem_nvdata_file:dir search;
allow mnld mtk_gps_nvram_file:file r_file_perms;
allow mnld mtk_nvdata_file:dir search;
allow mnld mtk_nvdata_file:file r_file_perms;

allow mnld proc_cmdline:file r_file_perms;
allow mnld sysfs_dt_firmware_android:dir search;
allow mnld sysfs_dt_firmware_android:file r_file_perms;
allow mnld sysfs_mtk_boot_mode:file r_file_perms;

# MPE may consume the one truthful accelerometer through the framework sensor
# manager.  No light/proximity/magnetometer/gyro node access is granted.
allow mnld fwk_sensor_hwservice:hwservice_manager find;
binder_call(mnld, system_server)
binder_call(system_server, mnld)

set_prop(mnld, mtk_gnss_runtime_prop)
get_prop(mnld, mtk_gnss_ro_prop)
get_prop(mnld, mtk_wmt_prop)
get_prop(mnld, mtk_nvram_ready_prop)

# REVIEWED, kept, AND NOW INSTRUMENTED: net_domain(mnld) above is broad -- it
# brings in the whole public/net.te socket set plus netd access -- and the SUPL
# data path belongs to mtk_agpsd, not to mnld. It is not narrowed on inference,
# because the live handset shows mnld holding a dozen sockets whose families
# could not be attributed from /proc and there is no AVC to argue from either
# way.
#
# The auditallow below is what settles it, and it does NOT need Tier 2:
# auditallow logs GRANTED accesses and fires under permissive as well. That is
# the same instrument that closed WI-067 from three Tier-1 captures (E-150)
# after the nvram note had spent four sessions waiting for an enforcing boot.
#
# `create` only, deliberately. It is a bounded, once-per-socket event, so a
# GNSS daemon cannot flood the log with it, and it is the only permission that
# answers the question -- if mnld never creates an INET socket, the whole
# net_domain() call can be replaced by the specific classes it does use.
#
# READ THE FIRST BOOT AFTER THIS FLASHES. If nothing fires across a boot plus a
# GPS fix, replace net_domain(mnld) with those classes and delete this block.
auditallow mnld self:tcp_socket create;
auditallow mnld self:udp_socket create;
