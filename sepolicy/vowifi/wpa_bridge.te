# Android 10 suppresses the per-interface socket when its global interface
# name and config both resolve to "wlan0". init.wmt.rc's -O option creates it at
# /data/vendor/wifi/sock. Extraction rewrites MAL's complete legacy pathnames
# to that same equal-or-shorter path, so no vendor process writes core Wi-Fi
# data and no bind mount or init mounton exception is needed.
#
# MAL sends only STATUS, SIGNAL_POLL and BSS queries. The directory is
# 0770 wifi:wifi and mtkmal carries AID_WIFI.

# The control connection is AF_UNIX SOCK_DGRAM in both directions: the client
# binds its own <name>_ctrlconn node in the same directory and sendto()s the
# server's node, and the server replies to the client's node.
# create_file_perms (not a create/unlink/write subset) matches AOSP's
# hal_wifi_supplicant_default grant on this type: the client chmod()s the
# ctrlconn node after bind. Do not grant generic vendor_data_file.
#
# The first rule is the traversal. mtkmal reaches /data/vendor/wifi/sock by
# pathname, and it used to get `search` on the parent from public/domain.te's
# blanket vendor_data_file grant; connectivity/file.te now gives that directory
# its own type, which the blanket rule does not cover, so it has to be stated.
# Without it the control connection fails with no symptom other than MAL's
# "Can't connect to wpa server side" -- which is also what the pre-existing
# Android 10 supplicant behaviour looks like (trap 33), so it would be easy to
# misread.
allow mtkmal mtk_wifi_vendor_data_file:dir search;
allow mtkmal wpa_data_file:dir { open getattr search write add_name remove_name };
allow mtkmal wpa_data_file:sock_file create_file_perms;
allow mtkmal hal_wifi_supplicant_default:unix_dgram_socket sendto;
allow hal_wifi_supplicant_default mtkmal:unix_dgram_socket sendto;

# hal_wifi_supplicant_default is a halserverdomain, so check anything added
# here against system/sepolicy/public/hal_neverallows.te first: that file
# forbids halserverdomain { tcp_socket udp_socket rawip_socket } and
# { net_admin net_raw } outside a short exempt list. unix_dgram_socket is in
# neither neverallow, and hal_wifi_supplicant_server is on the exempt list for
# both anyway.
