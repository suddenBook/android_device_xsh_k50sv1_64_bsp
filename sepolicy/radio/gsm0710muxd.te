type gsm0710muxd, domain;
type gsm0710muxd_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(gsm0710muxd)
create_pty(gsm0710muxd)

# The daemon starts as root, creates/chowns its PTYs and then drops to radio.
allow gsm0710muxd self:global_capability_class_set { chown fowner setuid };
allow gsm0710muxd gsm0710muxd_devpts:chr_file setattr;

allow gsm0710muxd mtk_gsm0710mux_device:chr_file rw_file_perms;
allow gsm0710muxd mtk_radio_mux_device:dir {
    read write getattr open search add_name remove_name
};
allow gsm0710muxd mtk_radio_mux_device:lnk_file { create getattr read unlink };

allow gsm0710muxd sysfs_mtk_ccci:dir r_dir_perms;
allow gsm0710muxd sysfs_mtk_ccci:file r_file_perms;

# set_prop(gsm0710muxd, ctl_mtkrild_prop) was dead and is gone. The binary does
# carry a ctl.stop, but the only service name beside it is the bare legacy
# "ril-daemon" -- which init would check as ctl.ril-daemon, not as
# ctl.vendor.ril-daemon-mtk (the sole property ctl_mtkrild_prop labels), and
# which is not a service on this device anyway. The "ril-daemon-mtk started!"
# string nearby is a log format, not a ctl target: the binary contains no
# "vendor.ril-daemon-mtk" literal, unlike ccci_mdinit which does.
set_prop(gsm0710muxd, mtk_ril_mux_prop)
set_prop(gsm0710muxd, mtk_ril_mux_report_prop)
set_prop(gsm0710muxd, mtk_vendor_radio_prop)

# vendor.ril.muxreport is the mux daemon's own run state, and it is the daemon
# that publishes it. Denied at every boot until this was added:
#   avc:  denied  { set } for property=vendor.ril.muxreport.run
#         scontext=u:r:gsm0710muxd:s0
#         tcontext=u:object_r:mtk_muxreport_state_prop:s0 tclass=property_service
# ims.te:41 already gives mtkmal the matching get_prop -- volte_imsm.so reads
# this before starting the three VoLTE daemons, so under enforcing the write
# failing here would leave that read looking at a value nobody ever set.
set_prop(gsm0710muxd, mtk_muxreport_state_prop)
get_prop(gsm0710muxd, mtk_radio_config_prop)
