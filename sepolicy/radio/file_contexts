/(vendor|system/vendor)/bin/ccci_mdinit  u:object_r:ccci_mdinit_exec:s0
/(vendor|system/vendor)/bin/ccci_fsd     u:object_r:ccci_fsd_exec:s0
/(vendor|system/vendor)/bin/ccci_rpcd    u:object_r:ccci_rpcd_exec:s0
/(vendor|system/vendor)/bin/gsm0710muxd  u:object_r:gsm0710muxd_exec:s0
/(vendor|system/vendor)/bin/mtkrild       u:object_r:mtkrild_exec:s0
/(vendor|system/vendor)/bin/muxreport     u:object_r:muxreport_exec:s0
/(vendor|system/vendor)/bin/mtkmal        u:object_r:mtkmal_exec:s0
/(vendor|system/vendor)/bin/volte_imcb    u:object_r:volte_imcb_exec:s0
/(vendor|system/vendor)/bin/volte_stack   u:object_r:volte_stack_exec:s0
/(vendor|system/vendor)/bin/volte_ua      u:object_r:volte_ua_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.mediatek\.hardware\.imsa@1\.0-service u:object_r:mtk_hal_imsa_exec:s0

# rilproxy deliberately remains on the AOSP rild domain through the mapping in
# the device's shared vendor file_contexts.

# Active CCCI channels observed on this MT6755 board.
/dev/ccci_(md1_sta|md3_sta|mdx_sta)      u:object_r:mtk_ccci_status_device:s0
/dev/ccci_monitor                        u:object_r:mtk_ccci_monitor_device:s0
/dev/ccci_fs                             u:object_r:mtk_ccci_fs_device:s0
/dev/ccci_rpc                            u:object_r:mtk_ccci_rpc_device:s0
/dev/ccci_ipc_5                          u:object_r:mtk_ccci_mdinit_device:s0
/dev/ccci_ioctl[0-4]                     u:object_r:mtk_ccci_ioctl_device:s0
/dev/ccci_ims[ac]                        u:object_r:mtk_ccci_ims_device:s0
/dev/ttyC0                               u:object_r:mtk_gsm0710mux_device:s0
/dev/radio(/.*)?                         u:object_r:mtk_radio_mux_device:s0
/dev/devmap                              u:object_r:mtk_devmap_device:s0

# Fixed GPT layout of the captured handset.  Label both the real nodes and the
# stable by-name aliases used by the proprietary libraries.
/dev/block/mmcblk0p17                    u:object_r:mtk_nvram_block_device:s0
/dev/block/mmcblk0p2                     u:object_r:mtk_para_block_device:s0
/dev/block/mmcblk0p8                     u:object_r:mtk_protect_block_device:s0
/dev/block/mmcblk0p9                     u:object_r:mtk_protect_block_device:s0
/dev/block/platform/mtk-msdc\.0/11230000\.msdc0/by-name/nvram    u:object_r:mtk_nvram_block_device:s0
/dev/block/platform/mtk-msdc\.0/11230000\.msdc0/by-name/para     u:object_r:mtk_para_block_device:s0
/dev/block/platform/mtk-msdc\.0/11230000\.msdc0/by-name/protect1 u:object_r:mtk_protect_block_device:s0
/dev/block/platform/mtk-msdc\.0/11230000\.msdc0/by-name/protect2 u:object_r:mtk_protect_block_device:s0

# Modem-owned data only; the rest of nvdata remains outside these domains.
/data/vendor/ccci_cfg(/.*)?              u:object_r:mtk_ccci_cfg_file:s0
/data/vendor/mdlpm(/.*)?                 u:object_r:mtk_ccci_lpm_file:s0
/data/vendor/md3(/.*)?                   u:object_r:mtk_ccci_md3_file:s0
# md3 too. The shipped init.cccimdinit.rc mkdirs /mnt/vendor/nvdata/md3 on
# every boot, and `md(/.*)?` does not match it -- it was falling through to
# AOSP's /mnt/vendor(/.*)? -> mnt_vendor_file, on which ccci_fsd and
# ccci_mdinit hold only `dir search`. MD3 looks inert on this board
# (CONFIG_MTK_MD3_SUPPORT=0 in the live kernel config, no CDMA in
# ro.vendor.mtk_protocol1_rat_config, no md3 property set), so nothing is
# broken today; the label closes the gap rather than leaving it to be
# rediscovered if a modem image ever uses it.
/mnt/vendor/nvdata/md[0-9]*(/.*)?        u:object_r:mtk_modem_nvdata_file:s0
/mnt/vendor/nvdata/md_cmn(/.*)?          u:object_r:mtk_modem_nvdata_file:s0
/mnt/vendor/nvdata/APCFG/APRDCL/MD_SBP  u:object_r:mtk_modem_config_file:s0
/mnt/vendor/protect_f/md(/.*)?           u:object_r:mtk_protect_f_file:s0
/mnt/vendor/protect_s/md(/.*)?           u:object_r:mtk_protect_s_file:s0

# rilproxy connects to the mrild command and SAP-forwarding sockets owned by
# mtkrild.  The remaining sockets are typed separately for later consumers.
/dev/socket/(mrild|mrild2|mrild3|msap_uim_socket[12]) u:object_r:mtk_rild_socket:s0
/dev/socket/rild[234]                    u:object_r:rild_socket:s0
/dev/socket/(rild-oem|rild-mtk-modem)    u:object_r:mtk_ril_oem_socket:s0
/dev/socket/(rild-ims|rild-mal|rild-mal-at|rilproxy-mal) u:object_r:mtk_ril_ims_socket:s0
/dev/socket/(rild-atci|rilproxy-atci)     u:object_r:mtk_ril_atci_socket:s0
/dev/socket/sap_uim_socket[1-4]          u:object_r:mtk_ril_sap_socket:s0
/dev/socket/(rild-mtk-ut|rild-mtk-ut-2|rild-mbim) u:object_r:mtk_ril_test_socket:s0
/dev/socket/(mal_mfi|mal-mfi)            u:object_r:mtk_mal_mfi_socket:s0
/dev/socket/volte_imsm                    u:object_r:mtk_volte_imsm_socket:s0
/dev/socket/volte_imsa[12]                u:object_r:mtk_volte_imsa_socket:s0
/dev/socket/volte_stack                   u:object_r:mtk_volte_stack_socket:s0
/dev/socket/volte_ua                      u:object_r:mtk_volte_ua_socket:s0
