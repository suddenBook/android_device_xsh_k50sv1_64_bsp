# Core-domain access to types declared in this directory.

# /misc is the bootloader control block. rootdir/etc/fstab.mt6755 maps
# by-name/para (mmcblk0p2) to /misc, and libbootloader_message resolves the BCB
# device from exactly that fstab entry -- so uncrypt's "reboot to recovery",
# an OTA package install and vold's wipe all open THIS node.
#
# The partition is deliberately NOT relabelled to misc_block_device, even
# though that is what its contents are:
#   system/sepolicy/public/domain.te:604-617 neverallows misc_block_device
#   outside { fastbootd hal_bootctl_server init uncrypt update_engine
#             vendor_init vendor_misc_writer vold recovery ueventd },
# and that assertion is guarded by userdebug_or_eng(`-domain'). ccci_mdinit and
# mtkrild both hold mtk_para_block_device (MTK stores its boot-mode flags in
# the same partition), so relabelling would fail the build on EVERY tier,
# immediately. Granting the platform's misc consumers on the device type
# instead keeps both halves working with no neverallow risk.
#
# An earlier revision said it "would compile on tier 2 (userdebug) and fail
# sepolicy_neverallows on tier 3 (user) -- exactly the kind of late surprise
# this split is meant to avoid". The decision is right and that reason is not,
# and it invites someone to "just try it on tier 2".
# system/sepolicy/Android.mk:339 pins PRIVATE_TARGET_BUILD_VARIANT := user for
# the neverallow policy.conf unconditionally, so userdebug_or_eng() never
# expands there whatever tier is being built. Proof from this tree's own output:
#   sepolicy_neverallows_intermediates/policy.conf:11922
#       `domain` / "# exclude debuggable builds"     -- guard did NOT expand
#   plat_sepolicy.cil_intermediates/plat_policy.conf:12009
#       `-domain # exclude debuggable builds`        -- real variant, expanded
# Anywhere else in this tree that reasons about tier-dependent neverallows is
# wrong for the same reason.
allow { uncrypt vold recovery } mtk_para_block_device:blk_file w_file_perms;
allow { uncrypt recovery } mtk_para_block_device:blk_file r_file_perms;
allow { uncrypt vold recovery } block_device:dir search;

# Because the node carries a device type rather than misc_block_device, AOSP's
# assertion at public/domain.te:604-617 does not reach it, and this partition
# would otherwise be the one bootloader control block in the image that any new
# vendor domain could be handed write access to without tripping anything.
# Restate the platform's intent locally, over the writers this device actually
# has. ccci_mdinit is the one addition to AOSP's list and it is evidence-based:
# it links libsysenv.so, whose write_env_area writes MTK's boot-mode records
# into this same partition (see ccci_mdinit.te). mtkrild used to hold write
# here too and no longer does -- nothing in its dependency closure can write
# the partition, so it was narrowed to r_file_perms rather than excepted.
neverallow {
    domain -init -vendor_init -ueventd -uncrypt -vold -recovery -fsck
    -ccci_mdinit
} mtk_para_block_device:blk_file { write append };

# rilproxy reads the same CCCI state directory the rest of the modem stack
# does. Stock's compiled policy:
#   (allow rild sysfs_ccci (dir (search)))
#   (allow rild sysfs_ccci (file (getattr ioctl lock map open read)))
#
# REDUNDANT TODAY, kept for the same reason as the ten set_prop(vendor_init, ...)
# rules in gnss/vendor_init.te: the rule is insurance against AOSP narrowing a
# blanket grant. rild is hal_telephony_server
# (system/sepolicy/vendor/rild.te:3, hal_server_domain(rild, hal_telephony)) and
# system/sepolicy/public/hal_telephony.te:39 is
#     r_dir_file(hal_telephony_server, sysfs_type)
# which already covers sysfs_mtk_ccci -- it is `fs_type, sysfs_type` at
# radio/file.te. Confirmed, not inferred: `sepolicy-analyze <policy> dups`
# reports both of these as duplicates of the hal_telephony_server x sysfs_type
# rules. They become load-bearing the moment that blanket grant narrows.
allow rild sysfs_mtk_ccci:dir r_dir_perms;
allow rild sysfs_mtk_ccci:file r_file_perms;

# NOT GRANTED, blocked by DAC rather than by policy -- recorded so the next
# session does not "fix" the SELinux half and wonder why nothing changed:
#
#   proc_mtk_lk_env (/proc/lk_env) -- Stock grants rw to mnld, rild, ccci_fsd
#     and nvram_daemon. The node is 0600 root:root on the handset; mnld runs as
#     gps and rild/mtkrild as radio, so only the root domains could ever open
#     it, and ccci_mdinit/mtkrild already have the rules they need.
#
#   mtk_devmap_device (/dev/devmap) -- Stock grants read to mtk_hal_audio,
#     mediacodec, mtkrild and rild. The node is 0600 root:root and
#     rootdir/vendor/ueventd.rc deliberately leaves it that way ("stock opens
#     these group-system for MTK factory/META tooling that this build does not
#     ship"). ccci_mdinit runs as root and keeps its existing grant.
