type mtkrild, domain;
type mtkrild_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(mtkrild)
net_domain(mtkrild)
wakelock_use(mtkrild)
vndbinder_use(mtkrild)

allow mtkrild self:global_capability_class_set { setuid net_admin net_raw };
allow mtkrild self:netlink_route_socket nlmsg_write;
allowxperm mtkrild self:udp_socket ioctl {
    SIOCDELRT
    SIOCSIFFLAGS
    SIOCSIFADDR
    SIOCKILLADDR
    SIOCDEVPRIVATE
    SIOCDEVPRIVATE_1
};

allow mtkrild mtk_ccci_status_device:chr_file rw_file_perms;
allow mtkrild mtk_ccci_ioctl_device:chr_file rw_file_perms;

# No mtk_radio_mux_device rules here. They used to be, byte-identical to the
# mtkrild half of radio/ims.te, which is the only genuine intra-tree duplicate
# the policy had. They live there because that is where the mtkmal-creates /
# {mtkrild rild}-consumes relationship is documented, and splitting one half of
# it across two files is how it got duplicated in the first place.
allow mtkrild gsm0710muxd_devpts:chr_file rw_file_perms;
allowxperm mtkrild gsm0710muxd_devpts:chr_file ioctl unpriv_tty_ioctls;

allow mtkrild sysfs_mtk_ccci:dir r_dir_perms;
allow mtkrild sysfs_mtk_ccci:file r_file_perms;

allow mtkrild proc_mtk_lk_env:file rw_file_perms;
allow mtkrild block_device:dir search;
allow mtkrild mtk_para_block_device:blk_file rw_file_perms;

set_prop(mtkrild, mtk_ril_active_md_prop)
set_prop(mtkrild, mtk_ril_mux_report_prop)
set_prop(mtkrild, mtk_muxreport_state_prop)
set_prop(mtkrild, ctl_mtk_muxreport_prop)
set_prop(mtkrild, mtk_vendor_radio_prop)
set_prop(mtkrild, mtk_telephony_sensitive_prop)
get_prop(mtkrild, mtk_ril_mux_prop)
get_prop(mtkrild, mtk_ccci_response_prop)
get_prop(mtkrild, mtk_modem_status_prop)
get_prop(mtkrild, mtk_radio_config_prop)

# vendor.cdma.ril.uicc.mccmnc is written on every SIM state change. It was
# landing on vendor_default_prop, which public/domain.te:535 neverallows any
# domain but init/vendor_init from setting, so it is typed instead.
set_prop(mtkrild, mtk_ril_cdma_prop)

# DELIBERATELY LEFT DENIED, so that a future session does not "fix" it:
#   avc:  denied  { set } for property=gsm.version.ril-impl
#         scontext=u:r:mtkrild:s0 tcontext=u:object_r:radio_prop:s0
#         tclass=property_service
# hardware/ril/libril/ril.cpp:72 writes it from RIL_register. AOSP grants
# radio_prop:property_service set only to hal_telephony_server
# (public/hal_telephony.te:23) and radio (public/radio.te:20); mtkrild is
# neither. Closing it would mean either giving a vendor daemon the whole
# radio_prop namespace or promoting mtkrild to hal_telephony_server -- and the
# value is dead either way: frameworks declares it once, at
# TelephonyProperties.java:39 as PROPERTY_RIL_IMPL, and never reads it.
