type mtkrild, domain;
type mtkrild_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(mtkrild)
net_domain(mtkrild)
wakelock_use(mtkrild)
vndbinder_use(mtkrild)

allow mtkrild self:global_capability_class_set { setuid net_admin net_raw };
allow mtkrild self:netlink_route_socket nlmsg_write;
allowxperm mtkrild self:udp_socket ioctl {
    SIOCDELRT
    SIOCSIFFLAGS
    SIOCSIFADDR
    SIOCKILLADDR
    SIOCDEVPRIVATE
    SIOCDEVPRIVATE_1
};

allow mtkrild mtk_ccci_status_device:chr_file rw_file_perms;
allow mtkrild mtk_ccci_ioctl_device:chr_file rw_file_perms;

# No mtk_radio_mux_device rules here. They used to be, byte-identical to the
# mtkrild half of radio/ims.te, which is the only genuine intra-tree duplicate
# the policy had. They live there because that is where the mtkmal-creates /
# {mtkrild rild}-consumes relationship is documented, and splitting one half of
# it across two files is how it got duplicated in the first place.
allow mtkrild gsm0710muxd_devpts:chr_file rw_file_perms;
allowxperm mtkrild gsm0710muxd_devpts:chr_file ioctl unpriv_tty_ioctls;

allow mtkrild sysfs_mtk_ccci:dir r_dir_perms;
allow mtkrild sysfs_mtk_ccci:file r_file_perms;

allow mtkrild proc_mtk_lk_env:file rw_file_perms;
allow mtkrild block_device:dir search;

# READ ONLY on the para partition, which is the bootloader control block:
# rootdir/etc/fstab.mt6755:85 maps by-name/para (mmcblk0p2) to /misc. The write
# half was dropped after looking for a writer and finding none. The only proven
# para writer in this image is libsysenv.so (write_env_area, "write env fail",
# "write env sync fail", assembling /dev/block/by-name + /para at runtime), and
# it is NOT in mtkrild's dependency closure: DT_NEEDED is libcutils, liblog,
# librilmtk, libmtkrilutils, libc++, libc, libm, libdl, and walking those
# transitively (25 libraries) reaches no libsysenv. mtkrild itself contains no
# /dev/block string, no by-name path and no bare "para" token at all.
# ccci_mdinit is the domain that really does write it -- see ccci_mdinit.te.
allow mtkrild mtk_para_block_device:blk_file r_file_perms;

set_prop(mtkrild, mtk_ril_active_md_prop)
set_prop(mtkrild, mtk_ril_mux_report_prop)
set_prop(mtkrild, mtk_muxreport_state_prop)
# set_prop(mtkrild, ctl_mtk_muxreport_prop) was dead and is gone: /vendor/bin/
# mtkrild contains no "ctl." string whatsoever, and no "muxreport-daemon"
# service name either, so it never starts or stops that service. It only
# publishes the mux report STATE properties above, which is a different thing.
set_prop(mtkrild, mtk_vendor_radio_prop)
set_prop(mtkrild, mtk_telephony_sensitive_prop)
get_prop(mtkrild, mtk_ril_mux_prop)
get_prop(mtkrild, mtk_ccci_response_prop)
get_prop(mtkrild, mtk_modem_status_prop)
get_prop(mtkrild, mtk_radio_config_prop)

# vendor.cdma.ril.uicc.mccmnc is written on every SIM state change. It was
# landing on AOSP's `vendor.` -> vendor_default_prop catch-all and denied, so
# it is typed instead. public/domain.te:535 is NOT what forces that -- it is
# compatible_property_only() and does not compile on this product; the type is
# least privilege over one prefix, and the same labelling discipline is what
# keeps unnamespaced properties clear of the default_prop neverallow at
# domain.te:525, which does compile. See sepolicy/vendor/property.te.
set_prop(mtkrild, mtk_ril_cdma_prop)

# The modem library's implementation-version diagnostic is rewritten by
# extract-files.sh to vendor.ril.impl, covered by mtk_vendor_radio_prop above.
# The framework-facing RIL proxy still owns gsm.version.ril-impl. Do not grant
# this vendor modem daemon the broad AOSP radio_prop namespace for diagnostics.
