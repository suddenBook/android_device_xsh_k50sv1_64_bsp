# com.android.phone consumes the public telephony state exported by the vendor
# RIL.  Sensitive ICCID/IMSI values stay limited to the radio app and the
# platform system server rather than Stock's all-domain property attribute.
get_prop(radio, mtk_vendor_radio_prop)
get_prop(radio, mtk_ril_active_md_prop)
get_prop(radio, mtk_modem_status_prop)
get_prop(radio, mtk_telephony_sensitive_prop)
get_prop(radio, mtk_radio_config_prop)
get_prop(radio, mtk_ims_prop)
set_prop(radio, mtk_ims_feature_prop)
hal_client_domain(radio, hal_mtk_imsa)

# com.android.phone is the only consumer of rilproxy's MtkRadioEx extension
# (lshal shows vendor.mediatek.hardware.mtkradioex@1.0-1.9::IMtkRadioEx with
# mtkSlot/imsSlot/mtkCap/mtkEm/mtkRcs/mtkSe/mtkAssist instances per SIM slot).
hal_client_domain(radio, hal_mtk_radioex)

get_prop(system_server, mtk_telephony_sensitive_prop)
