# Control properties are split per service so ccci_mdinit cannot control
# unrelated vendor daemons.
type ctl_mtk_ccci_fsd_prop, property_type;
type ctl_mtk_ccci3_fsd_prop, property_type;
type ctl_mtk_ccci_rpcd_prop, property_type;
type ctl_mtk_gsm0710muxd_prop, property_type;
type ctl_mtkrild_prop, property_type;
type ctl_mtk_rilproxy_prop, property_type;
type ctl_mtk_muxreport_prop, property_type;

type mtk_ril_mux_prop, property_type;
type mtk_ril_mux_report_prop, property_type;
type mtk_muxreport_state_prop, property_type;
type mtk_ril_active_md_prop, property_type;
type mtk_modem_status_prop, property_type;
type mtk_ccci_response_prop, property_type;
type mtk_vendor_radio_prop, property_type;

# Two more prefixes the modem stack writes that were landing on
# vendor_default_prop and being denied at every boot:
#   vendor.net.handover.thlte    from mtkmal   (LTE<->WiFi handover threshold)
#   vendor.cdma.ril.uicc.mccmnc  from mtkrild  (UICC operator, CDMA namespace)
# public/domain.te:535 is
#   neverallow { domain -init -vendor_init } vendor_default_prop:property_service set;
# so an allow rule cannot close these -- the only correct fix is to give them a
# device type, which is the pattern vendor/property.te already documents.
type mtk_ril_handover_prop, property_type;
type mtk_ril_cdma_prop, property_type;
type mtk_telephony_sensitive_prop, property_type;
type mtk_radio_config_prop, property_type;
type mtk_ccci_config_prop, property_type;
type mtk_nvram_ready_prop, property_type;

# Voice IMS configuration is read by the phone-UID APK. Runtime service
# control remains split per daemon and writable only by the MAL coordinator.
type mtk_ims_prop, property_type;
type mtk_ims_feature_prop, property_type;
type mtk_volte_runtime_prop, property_type;
type ctl_mtk_volte_imcb_prop, property_type;
type ctl_mtk_volte_stack_prop, property_type;
type ctl_mtk_volte_ua_prop, property_type;

# vendor.net.ims.* -- written by volte_stack, which links libipsec_ims_shr.so.
# Observed live on the first image where the IMS stack got far enough to
# publish anything:
#   avc: denied { set } for property=vendor.net.ims.volte.pid
#        scontext=u:r:volte_stack:s0 tcontext=u:object_r:vendor_default_prop:s0
# Unlabelled it falls to vendor_default_prop, which volte_stack cannot set, so
# under enforcing the IMS stack would silently lose its own state publication.
# Stock labels the whole `vendor.net.` prefix mtk_network_prop and grants its
# rcs_volte_stack `set` on it; this tree scopes the type to the one subtree a
# shipped daemon actually writes. The other reader that will matter is
# ipsec_mon, which reads vendor.net.ims.ipsec.version -- see WI-018.
type mtk_ims_net_prop, property_type;
