# rilproxy is intentionally kept in AOSP's rild/hal_telephony_server domain.
vndbinder_use(rild)

# The modem keeps the AP awake across an incoming call setup. AOSP's
# vendor/rild.te grants no wakelock; Stock's compiled policy has
#   (allow rild sysfs_wake_lock (file (ioctl read write getattr lock append map open)))
wakelock_use(rild)
hal_client_domain(rild, hal_audio)

# rilproxy publishes the vendor extension in addition to the standard Android
# radio HIDL services already covered by the platform telephony attributes.
# Registered through the dedicated hal_mtk_radioex attribute (radio/hwservice.te)
# rather than by widening hal_telephony, which would also expose it to the
# bluetooth domain.
hal_server_domain(rild, hal_mtk_radioex)

# Proxy requests are forwarded to the proprietary mtkrild command sockets.
allow rild mtk_rild_socket:sock_file write;
allow rild mtkrild:unix_stream_socket connectto;

# This chassis exposes two physical SIM slots and no virtual/external SIM
# feature, so rilproxy's VSIM probe must fail -- but it is left AUDIBLE rather
# than dontaudit'ed:
#   avc: denied { write } for comm="rilproxy" name="rild-vsim"
#        tcontext=u:object_r:mtk_ril_vsim_socket:s0 tclass=sock_file
# The real fix is to drop the three
#   socket rild-vsim{,2,3} stream 660 root radio
# lines from the blob /vendor/etc/init/mtkrild.rc (proprietary-files.txt:494);
# with no socket file the probe fails at connect() with ENOENT and emits no
# AVC. That rc is regenerated by extract-files.sh, so the edit belongs in
# blob_fixup() (extract-files.sh:154) -- hand-editing the extracted copy under
# vendor/xsh/k50sv1_64_bsp is silently reverted on the next extraction. Until
# that is done the denial stands, visible rather than filtered.

set_prop(rild, mtk_ril_mux_report_prop)
set_prop(rild, mtk_vendor_radio_prop)
set_prop(rild, mtk_telephony_sensitive_prop)
# rilproxy publishes the selected modem and the mux configuration, it does not
# only read them. Stock's compiled policy has
#   (allow rild ril_active_md_prop (property_service (set)))
#   (allow rild gsm0710muxd_prop (property_service (set)))
# which are vendor.ril.active.md and the vendor.ril.mux. namespace here.
set_prop(rild, mtk_ril_active_md_prop)
set_prop(rild, mtk_ril_mux_prop)
get_prop(rild, mtk_muxreport_state_prop)
get_prop(rild, mtk_modem_status_prop)
get_prop(rild, mtk_radio_config_prop)

# librilproxy reads only the carrier-express selection record directly.
allow rild mnt_vendor_file:dir search;
allow rild mtk_modem_config_file:file r_file_perms;

# rild reads the CDMA-namespace UICC keys mtkrild publishes. Typing
# vendor.cdma.ril. off vendor_default_prop (radio/property.te) closed the write
# and exposed the matching read:
#   avc: denied { getattr } comm="RIL Proxy Main"
#        path="/dev/__properties__/u:object_r:mtk_ril_cdma_prop:s0"
#        scontext=u:r:rild:s0 tcontext=u:object_r:mtk_ril_cdma_prop:s0
get_prop(rild, mtk_ril_cdma_prop)
