type ccci_mdinit, domain;
type ccci_mdinit_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(ccci_mdinit)
wakelock_use(ccci_mdinit)

# Start only services present in this device's production init configuration.
set_prop(ccci_mdinit, ctl_mtk_ccci_fsd_prop)
set_prop(ccci_mdinit, ctl_mtk_ccci3_fsd_prop)
set_prop(ccci_mdinit, ctl_mtk_ccci_rpcd_prop)
set_prop(ccci_mdinit, ctl_mtk_gsm0710muxd_prop)
set_prop(ccci_mdinit, ctl_mtkrild_prop)
set_prop(ccci_mdinit, ctl_mtk_rilproxy_prop)

set_prop(ccci_mdinit, mtk_ril_active_md_prop)
set_prop(ccci_mdinit, mtk_ril_mux_report_prop)
set_prop(ccci_mdinit, mtk_modem_status_prop)
set_prop(ccci_mdinit, mtk_ccci_response_prop)

get_prop(ccci_mdinit, mtk_radio_config_prop)
get_prop(ccci_mdinit, mtk_ccci_config_prop)
get_prop(ccci_mdinit, mtk_nvram_ready_prop)

allow ccci_mdinit mtk_ccci_monitor_device:chr_file rw_file_perms;
allow ccci_mdinit mtk_ccci_status_device:chr_file rw_file_perms;
allow ccci_mdinit mtk_ccci_mdinit_device:chr_file rw_file_perms;
allow ccci_mdinit mtk_ccci_ioctl_device:chr_file rw_file_perms;
allow ccci_mdinit mtk_devmap_device:chr_file r_file_perms;

allow ccci_mdinit mtk_ccci_cfg_file:dir create_dir_perms;
allow ccci_mdinit mtk_ccci_cfg_file:file create_file_perms;
allow ccci_mdinit mtk_modem_config_file:file r_file_perms;
allow ccci_mdinit mnt_vendor_file:dir search;

allow ccci_mdinit sysfs_mtk_ccci:dir r_dir_perms;
allow ccci_mdinit sysfs_mtk_ccci:file r_file_perms;
allow ccci_mdinit sysfs_mtk_ccci_boot:file rw_file_perms;
allow ccci_mdinit sysfs_mtk_boot_mode:file r_file_perms;
allow ccci_mdinit sysfs_dt_firmware_android:dir search;

allow ccci_mdinit proc_mtk_bootprof:file rw_file_perms;
allow ccci_mdinit proc_mtk_lk_env:file rw_file_perms;
allow ccci_mdinit proc_cmdline:file r_file_perms;

allow ccci_mdinit block_device:dir search;
allow ccci_mdinit mtk_para_block_device:blk_file rw_file_perms;
