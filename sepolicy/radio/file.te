# CCCI device nodes are separated by function instead of inheriting Stock's
# single catch-all label for every modem, logging and diagnostic channel.
type mtk_ccci_status_device, dev_type;
type mtk_ccci_monitor_device, dev_type;
type mtk_ccci_fs_device, dev_type;
type mtk_ccci_rpc_device, dev_type;
type mtk_ccci_mdinit_device, dev_type;
type mtk_ccci_ioctl_device, dev_type;
# The voice IMS control channel volte_imcb actually opens is /dev/ccci_imsc
# (232,9) -- confirmed as fd 9 of the running volte_imcb on the handset. It is
# covered together with /dev/ccci_imsa (232,10), the application channel the
# IMSA HIDL service is named for, which was already labelled here.
# /dev/ccci_imsdc (232,11), /dev/ccci_imsem (232,21) and /dev/ccci_imsv (232,8)
# are the data-control, EM and video channels: they exist as nodes but this
# no-video voice-MMTEL build never opens them and they produced no denial, so they are
# deliberately left unlabelled rather than covered speculatively.
type mtk_ccci_ims_device, dev_type;
type mtk_gsm0710mux_device, dev_type;
type mtk_radio_mux_device, dev_type;
type mtk_devmap_device, dev_type;

# Persistent modem partitions used by the NVRAM and sysenv libraries.
type mtk_nvram_block_device, dev_type;
type mtk_para_block_device, dev_type;

# protect1/protect2 back /mnt/vendor/protect_f and /mnt/vendor/protect_s
# (rootdir/etc/fstab.mt6755:17-18). One type for the pair: no domain ever
# distinguishes them at the block layer -- only the mounted contents are
# separated, by mtk_protect_f_file / mtk_protect_s_file.
type mtk_protect_block_device, dev_type;

# Runtime and persistent modem data.
type mtk_ccci_cfg_file, file_type, data_file_type;
type mtk_ccci_lpm_file, file_type, data_file_type;
type mtk_modem_nvdata_file, file_type, data_file_type, mtk_nvram_storage_file, mtk_nvram_identity_file;
type mtk_modem_config_file, file_type, data_file_type, mtk_nvram_storage_file, mtk_nvram_identity_file;
type mtk_protect_f_file, file_type, data_file_type, mtk_nvram_storage_file, mtk_nvram_identity_file;
type mtk_protect_s_file, file_type, data_file_type, mtk_nvram_storage_file, mtk_nvram_identity_file;

# Narrow procfs/sysfs resources used during modem initialization.
type proc_mtk_bootprof, fs_type, proc_type;
type proc_mtk_lk_env, fs_type, proc_type;
type sysfs_mtk_ccci, fs_type, sysfs_type;
type sysfs_mtk_ccci_boot, fs_type, sysfs_type;
type sysfs_mtk_boot_mode, fs_type, sysfs_type;

# Local sockets created by init for the two-stage MTK RIL architecture.
type mtk_rild_socket, file_type;
type mtk_ril_oem_socket, file_type;
type mtk_ril_ims_socket, file_type;
# ATCI and the MBIM/UT test channels (mtkrild.rc:9,10,12,18 and rilproxy.rc:7).
# Labelled so they are not socket_device, and left with no writer: neither is a
# shipped feature here. Same deliberate refusal as mtk_ril_sap_socket below.
type mtk_ril_atci_socket, file_type;
type mtk_ril_vsim_socket, file_type;
# No domain is granted write on these three. They are created by the blob
# rc files (rilproxy.rc: sap_uim_socket1..4; mtkrild.rc: rild-atci,
# rild-mtk-ut{,-2}, rild-mbim) but the corresponding features are not shipped:
# BT SIM Access Profile is deliberately not offered, and ATCI / MBIM / the
# mtk-ut test channels are factory interfaces. Keeping a dedicated dead type
# (rather than letting them fall back to socket_device) documents the decision
# and makes any future attempt to use them show up as a named AVC.
# If the sockets themselves should go away, delete the "socket" lines in
# blob_fixup() (extract-files.sh:154) -- those rc files are regenerated by
# extract-files.sh, so hand-editing the extracted copies does not survive.
#
# mtk_ril_sap_socket specifically LOOKS like a loose end and is not one. Do not
# try to wire Bluetooth SAP up to it. /dev/socket/sap_uim_socket[1-4] are created
# for rilproxy (vendor/etc/init/rilproxy.rc:9-12, mode 660 bluetooth:bluetooth)
# and rilproxy runs in the AOSP rild domain, so a SAP consumer in the bluetooth
# domain would need
#     allow bluetooth rild:unix_stream_socket connectto;
# system/sepolicy/public/domain.te:723-733 forbids exactly that:
#     full_treble_only(`
#       neverallow_establish_socket_comms({ coredomain -init -adbd },
#                                         { domain -coredomain
#                                           -socket_between_core_and_vendor_violators });
#     ')
# and system/sepolicy/public/neverallow_macros:12-15 expands that into
#     neverallow $1 $2:socket_class_set { connect sendto };
#     neverallow $1 $2:unix_stream_socket connectto;
# bluetooth is a coredomain (system/sepolicy/private/bluetooth.te:1), rild and
# mtkrild are not, this is a full-Treble Q build so full_treble_only() expands,
# and socket_between_core_and_vendor_violators has no members in this policy --
# the compiled policy.conf declares the attribute and never assigns it. So the
# rule is unconditional here and it fails at BUILD time under checkpolicy, not as
# a runtime AVC that could be relabelled away. The same applies to
# /dev/socket/msap_uim_socket[12] (mtk_rild_socket) on the mtkrild side.
#
# On full Treble the only sanctioned core<->vendor transport is (hw)binder, so a
# real SAP feature would mean a HIDL interface, not a socket grant. SAP is not
# offered on this product in any case (see the block above), so this stays a dead
# type and the neverallow is never reached.
# /dev/socket/sap_uim_socket[1-4], declared by rilproxy.rc:9-12 as
# bluetooth:bluetooth 0660 -- the Bluetooth SIM Access Profile channel. NO
# writer is granted: rSAP is not in scope for this device and nothing in the
# shipped Bluetooth stack opens it, so under enforcing an rSAP pairing fails
# with a denial that looks like a policy bug rather than a decision. It is a
# decision. Enabling rSAP needs exactly two rules:
#     allow hal_bluetooth_default mtk_ril_sap_socket:sock_file write;
#     allow hal_bluetooth_default rild:unix_stream_socket connectto;
# and one pairing test to prove them.
type mtk_ril_sap_socket, file_type;
type mtk_ril_test_socket, file_type;

# Voice IMS sockets created by init. Keep each process boundary distinct so
# the MAL coordinator cannot connect to unrelated vendor daemons.
type mtk_mal_mfi_socket, file_type;
# volte_imcb owns /dev/socket/volte_imsa1 (init.volte_imcb.rc), not a socket
# named volte_imcb; there is no mtk_volte_imcb_socket type.
type mtk_volte_imsm_socket, file_type;
type mtk_volte_imsa_socket, file_type;
type mtk_volte_stack_socket, file_type;
type mtk_volte_ua_socket, file_type;
