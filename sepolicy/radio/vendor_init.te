# vendor_init property writes.
#
# /vendor/build.prop -- which the build appends device/xsh/k50sv1_64_bsp/vendor.prop
# to (build/make/core/Makefile:489) -- and every setprop in a /vendor rc file are
# evaluated in the vendor_init context, not init:
#   system/core/init/subcontext.cpp:56-58   {"/vendor", kVendorContext="u:r:vendor_init:s0"}
#   system/core/init/property_service.cpp:656-663, 726
#       LoadProperties() picks that context by path prefix and then calls
#       CheckPermissions(), which is a real selinux_check_access() on
#       <type>:property_service:set.
# system/sepolicy/public/vendor_init.te:220-246 grants vendor_init a fixed list
# of PLATFORM property types only, so a device-defined type needs its own rule
# or the assignment is dropped with
#   init: Do not have permissions to set <key> ... in property file /vendor/build.prop
# Stock does exactly this: its vendor_init_29_0 carries property_service set on
# ~90 MTK property types.

# vendor.prop AND rootdir/etc/init/hw/init.mt6755.rc "on property:
# ro.persistent_properties.ready=true" both assign these, so they are denied
# twice over without this rule:
#   persist.vendor.{ims,mims,volte,vilte,viwifi,mtk_wfc,mtk_rcs_ua,mtk_rtt}_support
#   persist.vendor.mtk_dynamic_ims_switch, persist.vendor.wfc.sys_wfc_support
#   ro.vendor.mtk_telephony_add_on_policy, ro.vendor.md_auto_setup_ims,
#   ro.vendor.md_mims_support
set_prop(vendor_init, mtk_ims_prop)

#   persist.vendor.mtk.{volte,vilte,viwifi,wfc,ims.video}.enable
set_prop(vendor_init, mtk_ims_feature_prop)

# vendor.prop: ro.vendor.md_prop_ver, ro.vendor.mtk_ril_mode,
#              ro.vendor.mtk_md1_support
set_prop(vendor_init, mtk_radio_config_prop)

# vendor.prop: the six persist.vendor.radio.* topology and fast-dormancy keys
#   persist.vendor.radio.mtk_ps2_rat, .mtk_dsbp_support,
#   .fd.counter, .fd.off.counter, .fd.off.r8.counter, .fd.r8.counter
#
# property_contexts in this same directory maps the prefix
# persist.vendor.radio. to mtk_vendor_radio_prop, and that 21-character prefix
# beats AOSP's persist.vendor. -> vendor_default_prop (private/property_contexts:174)
# under longest-prefix matching, so these do NOT fall into a type vendor_init
# already holds.
#
# Without this rule all six are silently dropped from /vendor/build.prop the
# moment the build stops being permissive -- one "Do not have permissions to
# set" line per key in the init log and nothing else. mtk_ps2_rat is the one
# that would hurt: it is what tells the RIL that protocol stack 2 is W/G, and
# it is a required regression against stock (E-058). Tier 1 cannot show this
# because avc_has_perm returns 0 in permissive mode, so it would first appear
# as an unexplained radio regression on the first Tier 2 boot (WI-023).
set_prop(vendor_init, mtk_vendor_radio_prop)
