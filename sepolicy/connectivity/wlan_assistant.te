type wlan_assistant, domain;
type wlan_assistant_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(wlan_assistant)

# The daemon waits for the WMT Wi-Fi node, monitors it with inotify, and writes
# the complete calibration payload when the device is available.
allow wlan_assistant mtk_wmt_wifi_device:chr_file { getattr open read write };

# Traverse the mounted vendor tree but read only the board's verified WLAN
# calibration file.  No access is granted to the rest of nvdata.
allow wlan_assistant mnt_vendor_file:dir search;
allow wlan_assistant mtk_wlan_nvram_file:file { getattr open read };

set_prop(wlan_assistant, mtk_wlan_nvram_ready_prop)

# /dev/wmtWifi is the WLAN function's power switch on the combo chip: a write
# turns the function on or off. Keep it to the real Wi-Fi HAL and to this
# calibration loader. sepolicy/power/hal_power_default.te previously wrote it
# from the Power HAL for a scheduling hint; that grant is gone and this
# assertion is what stops it coming back.
# init and ueventd are excluded because ueventd creates and labels the node.
neverallow {
    domain
    -init
    -ueventd
    -hal_wifi_default
    -wlan_assistant
} mtk_wmt_wifi_device:chr_file { append ioctl open read write };
