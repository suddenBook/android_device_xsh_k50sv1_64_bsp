/mnt/vendor/nvdata/APCFG/APRDEB/WIFI      u:object_r:mtk_wlan_nvram_file:s0

# AOSP only labels /data/vendor/wifi/wpa. This port's wpa_supplicant -O and
# the MAL rewrite share /data/vendor/wifi/sock.
#
# This line covers only the init-created directory. wpa_supplicant deletes and
# recreates it on every Wi-Fi off/on cycle, and a runtime-created directory
# takes its parent's type rather than file_contexts -- see the named
# type_transition in hal_wifi_supplicant_default.te, which is the half that
# survives a cycle. Both are needed; neither alone is enough.
/data/vendor/wifi/sock(/.*)?              u:object_r:wpa_data_file:s0
