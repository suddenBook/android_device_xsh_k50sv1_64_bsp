# Rules whose subject is a core boot domain (init, fsck, kernel) but whose
# object is a board-specific type declared in this directory set. They must be
# compiled together with the type declarations, so they stay in vendor policy;
# see sepolicy/private/ for rules that are core-on-core.

# rootdir/etc/fstab.mt6755 mounts nvdata, protect_f and protect_s under
# /mnt/vendor; init performs the mkdir + mounton for "mount_all" in
# init.mt6755.rc:10.
allow init mnt_vendor_file:dir create_dir_perms;
allow init mnt_vendor_file:dir mounton;
allow init mtk_nvdata_file:dir create_dir_perms;
allow init mtk_nvdata_file:dir mounton;

# Those fstab entries carry "check", so init forks e2fsck against each of the
# three: nvdata (mmcblk0p6, nvram/vendor/file_contexts) and protect1/protect2
# (mmcblk0p8/p9, radio/file_contexts). Without the protect labels e2fsck fell
# back to the generic block_device type:
#   avc: denied { ioctl open read write } for comm="e2fsck"
#        scontext=u:r:fsck:s0 tcontext=u:object_r:block_device:s0 tclass=blk_file
# vold needs no matching rule: none of the three fstab lines is voldmanaged, so
# init's mount_all owns them end to end, and no vold denial was observed.
allow fsck mtk_nvdata_block_device:blk_file rw_file_perms;
allow fsck mtk_protect_block_device:blk_file rw_file_perms;

# The flasher deliberately erases /cache. Because its fstab entry is
# formattable, fs_mgr formats the wiped block device with /system/bin/mke2fs,
# which transitions to e2fs (not fsck). AOSP gives this exact formatter access
# to userdata/metadata/dm but not cache; mirror its narrow ext4 contract here.
allow e2fs cache_block_device:blk_file rw_file_perms;
allowxperm e2fs cache_block_device:blk_file ioctl {
    BLKSECDISCARD
    BLKDISCARD
    BLKPBSZGET
    BLKDISCARDZEROES
    BLKROGET
};

# No metadata_block_device ioctl grant here, deliberately. It used to exist
# because forcefdeorfbe=<metadata> made fs_mgr open the external cryptfs key
# partition as init and wipe_block_device() issue BLKSECDISCARD/BLKDISCARD on
# it (fs_mgr.cpp:1247-1255, reachable only when is_encryptable() is true and
# key_loc != KEY_IN_FOOTER). userdata is no longer encrypted
# (rootdir/etc/fstab.mt6755 says why), so that branch is unreachable and the
# rule was dead. Nothing else in this configuration opens `metadata` at boot:
# fs_mgr's other key_dir uses are should_use_metadata_encryption() and the GSI
# suffix, first_stage_mount mounts it only if the fstab has an entry (it does
# not), and vold's /metadata/vold/checkpoint is behind isCheckpointing(), which
# needs a `checkpoint=` flag this fstab does not carry.
#
# The metadata_block_device LABEL in sepolicy/vendor/file_contexts stays. It is
# inert, it costs nothing, and it means restoring FDE is this one rule again:
#   allowxperm init metadata_block_device:blk_file ioctl { BLKSECDISCARD BLKDISCARD };

# init x sysfs_mtk_io_scheduler. An earlier revision REMOVED this rule, reasoning
# that AOSP's init.rc never touches /sys/block/*/queue/* and that the only writer
# is init.mt6755.rc, which installs to /vendor/etc/init/hw/ and therefore runs as
# vendor_init. Both halves of that are true and the conclusion is still wrong:
# LineageOS ships its own
#   vendor/lineage/prebuilt/common/etc/init/lineage-iosched.rc
# which installs to /SYSTEM/etc/init/, so its `on boot` block runs as init:
#   restorecon --recursive /sys/block/mmcblk0/queue
#   chown system system /sys/block/mmcblk0/queue/scheduler   <- setattr
#   chmod 0664 /sys/block/mmcblk0/queue/scheduler            <- setattr
# and its `on property:sys.io.scheduler=*` action writes the node.
#
# The denial is audit serial 4, ~3 s into every boot. Under enforcing the node
# would stay root:root 0644 -- so the scheduler stops being settable at runtime
# at all, and a shipped rc action becomes a permanent silent no-op. Ship the
# whole mechanism or none of it; half of it is the worst option.
#
# The boot-time choice of `deadline` is unaffected either way: that write is
# init.mt6755.rc's and runs as vendor_init.
allow init sysfs_mtk_io_scheduler:file { setattr w_file_perms };

# AOSP init.rc:713-722 "chown system system /sys/devices/system/cpu/cpufreq/
# interactive/min_sample_time" and siblings. This one IS needed: public/init.te
# grants setattr only on sysfs_devices_system_cpu, and these nodes are not that
# type any more.
allow init sysfs_mtk_power_cpu_control:file setattr;

# The in-kernel MTK connectivity worker (mtk_wmtd_worker) direct-loads the
# combo-chip firmware from /vendor/firmware, labelled mtk_firmware_file by
# vendor/file_contexts. system/sepolicy/public/domain.te exempts kernel from
# the "no vendor_file for coredomain" rule precisely for firmware loading.
r_dir_file(kernel, mtk_firmware_file)

# NOT GRANTED, deliberately. Still firing on the flashed build (boot capture
# work/k50sv1-bringup/evidence/tier1-avc-20260823-boot), and confirmed harmless there --
# Wi-Fi and BT both come up:
#   avc: denied { dac_override } for comm="mtk_wmtd_worker"
#        scontext=u:r:kernel:s0 tcontext=u:r:kernel:s0 tclass=capability
# system/sepolicy/public/kernel.te:130 is
#   neverallow kernel self:global_capability_class_set { dac_override dac_read_search };
# so an allow here would fail sepolicy_neverallows in an enforcing build. The
# firmware load succeeds anyway (Wi-Fi and BT come up); the denial is left
# visible rather than dontaudit'ed so it is not mistaken for a policy gap.

# ALSO NOT GRANTED, and not dontaudit'ed. Still firing once per boot on the
# flashed build; the /dev/{stune,cpuset,memcg,cg2_bpf} cleanup in
# rootdir/etc/init/hw/init.mt6755.rc removes the *directories* but cannot stop
# init's earlier mount attempt, which is what raises this:
#   avc: denied { module_request } for comm="init" kmod="fs-cgroup2"
#        scontext=u:r:init:s0 tcontext=u:r:kernel:s0 tclass=system
# init requests the cgroup2 filesystem module because /system/etc/cgroups.json
# carries a "Cgroups2" block, but this 3.18 kernel has no cgroup2 and module
# autoloading is disabled. The fix is to drop that block, which lives in
# system/core/libprocessgroup/profiles/cgroups.json; /vendor/etc/cgroups.json
# can override a controller's path but cannot delete an entry
# (system/core/libprocessgroup/setup/cgroup_map_write.cpp:176-183 merges by
# controller name). Nothing inside the device tree can suppress it, so the
# single boot-time denial is left visible rather than filtered.
