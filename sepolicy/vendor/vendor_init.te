allow vendor_init sysfs_mtk_accelerometer:file setattr;

# Mount points are created from the device-owned root rc in the platform init
# domain; the vendor script only performs mount_all.  These are the storage
# operations observed during boot.
allow init mnt_vendor_file:dir create_dir_perms;
allow init mnt_vendor_file:dir mounton;
allow init mtk_nvdata_file:dir create_dir_perms;
allow init mtk_nvdata_file:dir mounton;
allow fsck mtk_nvdata_block_device:blk_file rw_file_perms;

# /mnt is tmpfs, but the legacy /mnt/sdcard symlink is part of the rootfs API.
# A named transition fixes only that init-created object.
type_transition init tmpfs:lnk_file rootfs "sdcard";

allow vendor_init proc_mtk_vm_swappiness:file w_file_perms;

allow init {
    sysfs_mtk_power_cpu_control
}:file setattr;

allow init sysfs_mtk_io_scheduler:file { getattr open read setattr write };

r_dir_file(kernel, mtk_firmware_file)

# Generic init probes cgroup2 once even though this pinned 3.18 kernel has no
# cgroup2 support and module autoloading is deliberately disabled.
dontaudit init kernel:system module_request;

# ueventd attempts to normalize an inherited nice value; failure is harmless
# and does not affect device-node creation.
dontaudit ueventd self:global_capability_class_set sys_nice;
