# Rules whose subject is vendor_init. Rules for init/fsck/kernel live in
# sepolicy/vendor/init.te so the file name matches the domain it constrains.

# rootdir/etc/init/init.sensors.rc:5-14 chown/chmod the MIR3DA accelerometer
# attributes under /sys/class/sensor/m_acc_misc -> (symlink)
# /sys/devices/virtual/sensor/m_acc_misc, labelled by vendor/genfs_contexts:1.
# A /vendor rc runs its chown/chmod in vendor_init, not init.
allow vendor_init sysfs_mtk_accelerometer:file setattr;

# rootdir/etc/init/hw/init.mt6755.rc:45 "write /proc/sys/vm/swappiness 100".
allow vendor_init proc_mtk_vm_swappiness:file w_file_perms;

# rootdir/etc/init/hw/init.mt6755.rc "on post-fs" creates and then removes the
# /mnt/vendor mount points and the dead cgroup roots. AOSP grants vendor_init
# dev_type:dir create_dir_perms (public/vendor_init.te:117, which includes
# rmdir/write/remove_name) but gives it nothing on tmpfs:dir beyond
# { getattr search } from public/domain.te:61.
allow vendor_init tmpfs:dir { create getattr open read search setattr write add_name remove_name };
allow vendor_init mnt_vendor_file:dir create_dir_perms;

# The "rm /dev/{stune,cpuset}/*/tasks" lines that precede the rmdirs in that
# same post-fs block. This is the other half of a permission vendor_init
# already holds: system/sepolicy/public/vendor_init.te:117 grants
# dev_type:dir create_dir_perms, whose rw_dir_perms already includes
# remove_name -- so vendor_init may already unlink the directory ENTRY and is
# only missing unlink on the inode itself. Scoped to the generic "device" type
# (the label those stray tmpfs files inherit), not to all of dev_type. The only
# device:file neverallow in the platform is public/domain.te:468, which covers
# properties_device.
allow vendor_init device:file unlink;

# NOT GRANTED: sys_module + vendor_file:system module_load.
#
# An earlier revision granted both, with a comment explaining that the rc uses
# init's `insmod` builtin and that the narrower shape -- exec'ing
# /vendor/bin/insmod so it transitions to AOSP's vendor_modprobe domain -- "was
# not made here". It had already been made. init.connectivity.modules.rc loads
# all five modules as
#     exec u:r:vendor_modprobe:s0 -- /vendor/bin/insmod /vendor/lib/modules/*.ko
# and `grep -rE '^\s*insmod' rootdir/` returns nothing. /vendor/bin/insmod is a
# symlink to toybox_vendor (vendor_toolbox_exec) and
# system/sepolicy/vendor/vendor_modprobe.te:4 already supplies
# domain_trans(init, vendor_toolbox_exec, vendor_modprobe); `exec` runs as init,
# not vendor_init. There are no vendor_init module denials in any capture.
#
# So the grant let the single most privileged domain on the device load any .ko
# anywhere on /vendor, for a code path that no longer exists.

# rootdir/etc/init/hw/init.mt6755.rc "on post-fs" hands the PPM, HPS and
# perfmgr control nodes to the system UID so the Power HAL can use them.
# libpowerhal runs in hal_power_default as user system (see
# rootdir/etc/init/vendor.mediatek.hardware.mtkpower@1.0-service.rc), and every
# one of these procfs nodes is created root:root 0664 or 0644 by the kernel, so
# without this the SELinux rules in sepolicy/power were the only half of the
# permission that was in place and every boost silently failed at open(2).
# AOSP's public/vendor_init.te:29 documents that chown/chmod need open+read as
# well as setattr; it grants that pair for the file types it knows about and
# has no rule for proc_type, so grant it here for exactly these five.
allow vendor_init {
    proc_mtk_power_ppm
    proc_mtk_power_hps
    proc_mtk_power_perfmgr
    proc_mtk_power_perf_ioctl
    proc_mtk_power_info
}:file { getattr open read setattr };

# The same rc file's "on early-init" pins both clusters through
# /proc/ppm/policy/userlimit_min_cpu_{freq,core} for the duration of boot and
# releases them at sys.boot_completed. That is a write, not a chmod.
allow vendor_init proc_mtk_power_ppm:file write;

# rootdir/etc/init/hw/init.mt6755.rc "on post-fs-data" ends with
#   setprop vold.post_fs_data_done 1
# A /vendor rc file's setprop runs in the vendor_init context
# (system/core/init/subcontext.cpp:57), and vold.post_fs_data_done resolves to
# vold_prop (system/sepolicy/private/property_contexts:99). AOSP's fixed
# vendor_init property list (public/vendor_init.te:220-246) does not include
# vold_prop, so without this the assignment is refused and /data never reports
# post-fs-data completion. There is no neverallow on vold_prop.
#
# Both operands are core types, but the rule exists only because this board's
# rc issues that setprop, so by the criterion in BoardConfig.mk it belongs here
# rather than in sepolicy/private.
set_prop(vendor_init, vold_prop)
