vndbinder_use(hal_camera_default)

allow hal_camera_default mtk_cmdq_device:chr_file { ioctl open read };
allow hal_camera_default mtk_smi_device:chr_file r_file_perms;
allow hal_camera_default self:global_capability_class_set sys_nice;

# camerahalserver holds a wakelock for the duration of a capture request.
# AOSP's vendor/hal_camera_default.te grants none; Stock's compiled policy has
#   (allow mtk_hal_camera sysfs_wake_lock (file (ioctl read write getattr lock append map open)))
wakelock_use(hal_camera_default)

# The MTK camera provider allocates its own graphics buffers rather than going
# through the mapper alone: CamClient@RecordStream binds
# android.hardware.graphics.allocator::IAllocator directly. AOSP's
# public/hal_camera.te grants `hal_graphics_allocator:fd use` and nothing more,
# and hal_attribute_hwservice() neverallows a bare `find` from any domain that
# is not a declared client -- so the macro is the only correct form here, not an
# allow rule. Denied, video recording loses its allocation path.
hal_client_domain(hal_camera_default, hal_graphics_allocator)
# (public/hal_graphics_allocator.te:5 gives every hal_graphics_allocator_client
# hal_graphics_mapper_hwservice:find, so the standalone rule that used to be
# here is now redundant.)

# FeaturePipeGpuN performs EGL processing inside the camera provider. The
# WI-023 preview/video sweep opens /dev/mali0 and submits Mali version/memory
# ioctls (0x8000, 0x8005, 0x8007); GPU buffers also need mmap access.
allow hal_camera_default gpu_device:chr_file { getattr ioctl map open read write };

# AOSP EGL initialization reads ISurfaceFlingerConfigs::hasWideColorDisplay
# and hasHDRDisplay (frameworks/native/opengl/libs/EGL/egl_display.cpp).
# Declare the client so the configstore policy supplies discovery and Binder
# access; the same FeaturePipeGpuN path produced the live Binder denial.
hal_client_domain(hal_camera_default, hal_configstore)

# MTK's Mtkcam@SensorProvider feeds accelerometer data to 3A and to the
# rotation/EIS metadata path through android.frameworks.sensorservice@1.0::
# ISensorManager, which system_server serves. AOSP's vendor/hal_camera_default.te
# already grants the hwservice find -- which is why no `find` denial appears --
# but supplies neither half of the binder pair. Denied, the provider gets a HIDL
# error it swallows: worse stabilisation and possibly wrong orientation
# metadata, with nothing logged at the framework. Same shape as mnld, gnss/mnld.te.
binder_call(hal_camera_default, system_server)
binder_call(system_server, hal_camera_default)

# The 3A thread walks /sys/class/power_supply to gate high-current flash on
# battery level. Only the directory search has ever been observed; do not widen
# to :file until a named file denial appears. public/domain.te's
# sysfs_batteryinfo neverallow is full_treble_only and scoped to coredomain, so
# a vendor domain is not covered by it.
allow hal_camera_default sysfs_batteryinfo:dir search;

# The shared MTK JPEG bridge is used by both the HAL1 camera provider and MMS.
allow hal_camera_default proc_mtk_jpeg:file r_file_perms;
allowxperm hal_camera_default proc_mtk_jpeg:file ioctl { 0x780b-0x780f };

# /data/vendor itself stays vendor_data_file and needs no rule: public/
# domain.te:228 already grants every domain vendor_data_file:dir
# { getattr search }. Only the dedicated dump type is granted here. Do not
# grant vendor_data_file create/write.
allow hal_camera_default mtk_camera_dump_file:dir create_dir_perms;
allow hal_camera_default mtk_camera_dump_file:file create_file_perms;

# NOT GRANTED: camera properties. Stock's camerahalserver sets three property
# groups this tree does not define at all --
#   (allow mtk_hal_camera mtk_camera_prop (property_service (set)))     vendor.camera.*
#   (allow mtk_hal_camera mediatek_prop (property_service (set)))       vendor.debug.camera.*
#   (allow mtk_hal_camera vendor_logmuch_prop (property_service (set))) vendor.logmuch.*
# Every key behind them is a debug/log-verbosity switch. Unlabelled, they land
# on AOSP's vendor_default_prop, the write is refused, and libmtkcam falls back
# to its compiled-in default -- which is the wanted behaviour for a shipping
# build. Add a device property type only if a real capture feature turns out to
# depend on one.
