# com.mediatek.ims (ImsService.apk, sharedUserId android.uid.phone, so the
# radio domain) registers "mtkIms" ->
# com.mediatek.ims.internal.IMtkImsService. Confirmed live: `service list`
# on the handset shows it at index 4.
#
# It used to be labelled radio_service, which is a shared bucket that AOSP
# hands to essentially everything:
#   system/sepolicy/private/untrusted_app_all.te:99  allow untrusted_app_all radio_service:service_manager find;
#   .../priv_app.te:49  .../platform_app.te:64  .../ephemeral_app.te:46
# i.e. any installed app could getService("mtkIms") and start poking a vendor
# IMS control interface. Its own type keeps the client set to the two domains
# that actually use it: the phone process that owns it, and the telephony
# framework in system_server.
#
# Both operands are core platform types, so this belongs in plat_private per
# the rule in BoardConfig.mk. Declared in private (not public) because nothing
# outside the platform image needs the symbol.
type mtk_ims_service, service_manager_type;

# add_service() also emits `neverallow { domain -radio } mtk_ims_service:
# service_manager add;`, which is the half that stops another process
# impersonating the IMS service.
add_service(radio, mtk_ims_service)
allow system_server mtk_ims_service:service_manager find;

# The same process also registers "wfo" -> com.mediatek.wfo.IWifiOffloadService,
# from WfoService.makeWfoService() called by ImsService.<init>. Stock labels it
# radio_service (plat_service_contexts:260), which is the shared bucket
# untrusted_app_all, priv_app, platform_app and ephemeral_app can all `find` --
# so on Stock any installed app can getService("wfo"). WifiOffloadService's
# binder methods do no permission checks of their own, so the label IS the
# access control. Its own type, same as mtk_ims_service above.
#
# Without a service_contexts entry "wfo" falls to the catch-all
# `* u:object_r:default_android_service:s0`, and
# system/sepolicy/public/domain.te makes adding to default_android_service a
# neverallow -- which no allow rule can work around. The pair is mandatory.
type mtk_wfo_service, service_manager_type;
add_service(radio, mtk_wfo_service)
allow system_server mtk_wfo_service:service_manager find;
