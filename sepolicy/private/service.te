# ImsService.apk hosts mtkIms and wfo in the radio domain (android.uid.phone).
# Dedicated service types avoid the broad radio_service discovery grants for
# ordinary/privileged app domains. AOSP's wider system_app, shell and dumpstate
# discovery grants still apply; a device rule cannot subtract those allows.
#
# Both concrete service implementations check remote Binder transactions:
# READ_PRIVILEGED_PHONE_STATE for state/observer APIs and MODIFY_PHONE_STATE for
# control APIs, including mtkIms getters that return controller Binders. See
# patch_ims_apk() and patch_wfo_jar() in extract-files.sh. Android's system UID
# and explicitly granted callers, including Shell, retain their privileges.
# This entry check does not audit every subsequently returned Binder interface.
#
# Both service owners/callers are core platform types, so keep these declarations
# in plat_private. add_service also prevents other domains registering the name.
type mtk_ims_service, service_manager_type;
add_service(radio, mtk_ims_service)
allow system_server mtk_ims_service:service_manager find;

# Each name also needs a service_contexts entry; the default_android_service
# fallback forbids registration.
type mtk_wfo_service, service_manager_type;
add_service(radio, mtk_wfo_service)
allow system_server mtk_wfo_service:service_manager find;
