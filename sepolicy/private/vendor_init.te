# rootdir/etc/init/hw/init.mt6755.rc "on post-fs-data" ends with
#   setprop vold.post_fs_data_done 1
# A /vendor rc file's setprop runs in the vendor_init context
# (system/core/init/subcontext.cpp:57), and vold.post_fs_data_done resolves to
# vold_prop (system/sepolicy/private/property_contexts:99). AOSP grants
# vendor_init a fixed property list in public/vendor_init.te:220-246 that does
# not include vold_prop, so the assignment is refused in enforcing and
# /data never reports post-fs-data completion.
#
# Both vendor_init and vold_prop are core platform types, so by the rule stated
# in BoardConfig.mk this belongs in plat_private, not in a vendor directory.
# There is no neverallow on vold_prop:property_service set.
set_prop(vendor_init, vold_prop)
