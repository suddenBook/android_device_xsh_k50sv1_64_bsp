# Forked children reopen ART's inherited executable fd. Q also calls
# disableExecuteOnly() for the child zygote's target SDK 0, changing the
# inherited app_process text mapping to RX. Linux 3.18 checks execute again
# for this mprotect; a live trace confirms the call and corresponding AVC.
# Keep execute_no_trans excluded: Q's rx_file_perms includes it, and the
# platform correctly forbids executing a new program in this domain.
allow webview_zygote zygote_exec:file { r_file_perms execute };

# ART reads its runtime DeviceConfig flags in this zygote too.
get_prop(webview_zygote, device_config_runtime_native_prop)
get_prop(webview_zygote, device_config_runtime_native_boot_prop)
