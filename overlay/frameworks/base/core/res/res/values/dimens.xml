<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Portrait: 40dp is 80px at the product density of 320, which clears the
         measured 70px cutout bottom with 10px to spare. DisplayPolicy already
         raises the status bar to the cutout's safe inset on its own
         (getStatusBarHeight takes the max of the two), so this dimen only adds
         the margin above it. It also stays at or below the 48dp
         quick_qs_offset_height default, so the Quick Settings header needs no
         matching change. Stock reserved the same 40dp; this value is now
         derived from the measurement rather than copied. -->
    <dimen name="status_bar_height_portrait">45dp</dimen>

    <!-- Landscape deliberately keeps the AOSP default. Rotating the device
         moves the hole to a *side* edge, so there is nothing above the content
         to clear; Stock's 40dp landscape bar just wastes 40dp of a 720px-tall
         viewport. AOSP defaults this to @dimen/status_bar_height_portrait,
         which would inherit the 40dp above, so restate the 24dp default. -->
    <dimen name="status_bar_height_landscape">25dp</dimen>
</resources>
