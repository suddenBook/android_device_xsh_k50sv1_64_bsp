<?xml version="1.0" encoding="utf-8"?>
<!-- Privileged-permission whitelist for the preinstalled Huawei payload.

     MUST be installed to /product/etc/permissions, not /system. The whitelist
     is selected by partition: PermissionManagerService asks pkg.isProduct()
     first and then reads SystemConfig.getProductPrivAppPermissions(), a map
     SystemConfig only fills from files under Environment.getProductDirectory()
     (SystemConfig.java:874). Both APKs install to /product/priv-app, so a copy
     under /system/etc/permissions parses into mPrivAppPermissions instead and
     would never be consulted for them.

     Contents are every signature|privileged permission each APK actually
     requests, taken from its own uses-permission list and classified against
     the protectionLevel in frameworks/base/core/res/AndroidManifest.xml for
     this platform. Nothing speculative is listed.

     What is deliberately NOT here, because a whitelist cannot grant it:

       * Plain signature permissions. HMS Core asks for MANAGE_APPOPS,
         MANAGE_DEVICE_ADMINS, MANAGE_NETWORK_POLICY, CREATE_USERS,
         INTERNAL_SYSTEM_WINDOW, SET_ACTIVITY_WATCHER, STATUS_BAR_SERVICE and
         BROADCAST_PACKAGE_REMOVED; AppGallery adds READ_FRAME_BUFFER,
         INTERACT_ACROSS_USERS_FULL, SET_HARMFUL_APP_WARNINGS and
         HIDE_NON_SYSTEM_OVERLAY_WINDOWS. Only the platform signature grants
         those, and re-signing is not available here: both APKs carry APK
         Signature Scheme v2 blocks (HMS Core v3 as well), which sign the whole
         file, so any re-sign invalidates what Huawei's own integrity checks
         verify.

       * SYSTEM_ALERT_WINDOW and WRITE_SETTINGS, which need no entry at all.
         Their protectionLevel carries preinstalled, so shipping on the system
         image already grants them.

     ro.control_privapp_permissions is set to log on this product, so a
     permission that is requested but missing from this file is logged by
     PermissionManagerService and denied, and does not affect boot.
-->
<permissions>
    <!-- HMS Core 6.16.2.342 - 22 privileged permissions -->
    <privapp-permissions package="com.huawei.hwid">
        <permission name="android.permission.BLUETOOTH_PRIVILEGED" />
        <permission name="android.permission.CHANGE_COMPONENT_ENABLED_STATE" />
        <permission name="android.permission.DISPATCH_PROVISIONING_MESSAGE" />
        <permission name="android.permission.FORCE_STOP_PACKAGES" />
        <permission name="android.permission.INSTALL_PACKAGES" />
        <permission name="android.permission.INTERACT_ACROSS_USERS" />
        <permission name="android.permission.LOCAL_MAC_ADDRESS" />
        <permission name="android.permission.MANAGE_FINGERPRINT" />
        <permission name="android.permission.MANAGE_USERS" />
        <permission name="android.permission.MASTER_CLEAR" />
        <permission name="android.permission.MODIFY_PHONE_STATE" />
        <permission name="android.permission.PACKAGE_USAGE_STATS" />
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
        <permission name="android.permission.READ_SEARCH_INDEXABLES" />
        <permission name="android.permission.READ_WIFI_CREDENTIAL" />
        <permission name="android.permission.REAL_GET_TASKS" />
        <permission name="android.permission.STATUS_BAR" />
        <permission name="android.permission.STOP_APP_SWITCHES" />
        <permission name="android.permission.SUBSTITUTE_NOTIFICATION_APP_NAME" />
        <permission name="android.permission.UPDATE_APP_OPS_STATS" />
        <permission name="android.permission.UPDATE_DEVICE_STATS" />
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
    </privapp-permissions>

    <!-- AppGallery 16.5.1.301 - 16 privileged permissions -->
    <privapp-permissions package="com.huawei.appmarket">
        <permission name="android.permission.ALLOCATE_AGGRESSIVE" />
        <permission name="android.permission.DELETE_PACKAGES" />
        <permission name="android.permission.GET_APP_OPS_STATS" />
        <permission name="android.permission.INSTALL_PACKAGES" />
        <permission name="android.permission.INTERACT_ACROSS_USERS" />
        <permission name="android.permission.MANAGE_USERS" />
        <permission name="android.permission.PACKAGE_USAGE_STATS" />
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
        <permission name="android.permission.READ_RUNTIME_PROFILES" />
        <permission name="android.permission.REAL_GET_TASKS" />
        <permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
        <permission name="android.permission.STATUS_BAR" />
        <permission name="android.permission.STOP_APP_SWITCHES" />
        <permission name="android.permission.WRITE_APN_SETTINGS" />
        <permission name="android.permission.WRITE_MEDIA_STORAGE" />
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
    </privapp-permissions>
</permissions>
