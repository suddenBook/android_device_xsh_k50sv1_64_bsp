<?xml version="1.0" encoding="utf-8"?>
<preferred-activities>
    <!-- Settings.applyDefaultPreferredAppsLPw seeds the initial preference.
         It queries the installed HOME candidates to construct the match set.
         A regular preferred activity can be changed by the user later. -->
    <item name="com.android.launcher3/com.android.launcher3.lineage.LineageLauncher" always="true">
        <filter>
            <action name="android.intent.action.MAIN" />
            <cat name="android.intent.category.HOME" />
            <cat name="android.intent.category.DEFAULT" />
        </filter>
    </item>
</preferred-activities>
