<?xml version="1.0" encoding="UTF-8"?>
<!--
  MTK PowerHAL scenario table for k50sv1_64_bsp.

  libpowerhal.so parses this file at perfLibpowerInit() and, for each power
  hint it receives over android.hardware.power@1.x::IPower, acquires a PPM
  PERF_SERV lock holding the listed resources. An unknown <data cmd> is
  skipped with "cmdSetting - unknown cmd", so a stray entry costs a log line,
  not a boot.

  WHY THIS FILE IS NOT THE STOCK BLOB
  ===================================
  Stock's /vendor/etc/powerscntbl.xml asks for
      PERF_RES_CPUFREQ_MIN_CLUSTER_0 = 1144000
      PERF_RES_CPUFREQ_MIN_CLUSTER_1 = 1950000
  Neither frequency exists on this part. Measured on the handset:

      /proc/ppm/dump_cluster_0_dvfs_table   (cpu0-3, "LITTLE")
          1001000 910000 819000 689000 598000 494000 338000 156000
      /proc/ppm/dump_cluster_1_dvfs_table   (cpu4-7, "big")
          1508000 1430000 1352000 1196000 1027000 871000 663000 286000

  1144000/1950000 are the OPPs of the full-speed MT6755 bin (4x1.95 GHz +
  4x1.144 GHz). This chassis ships a down-binned part at 1.508/1.001 GHz, and
  the vendor shipped the other SKU's table unchanged, so every boost stock
  declares is out of range. The same SKU error is in powercontable.xml
  (hispeed_freq MaxValue 1950000) and in power_whitelist_cfg.xml.

  Every value below is an OPP that exists in the tables above.

  WHICH HINTS ACTUALLY ARRIVE
  ===========================
  LineageOS ships pure AOSP framework jars, so MTK's own hints
  (MTKPOWER_HINT_*) are never sent; nothing calls libpowerhalwrap_jni. They
  are kept anyway: they cost nothing, they document the platform contract, and
  they become live if MTK's framework is ever added. The hints that do arrive
  on this build, all verified against the Q sources in this tree, are:

    LAUNCH        RootActivityContainer.java:2294/2302 (data 1 = start,
                  0 = stop) on every activity cold start
    INTERACTION   PowerManagerService.java:1500 (user activity),
                  DisplayRotation.java:942, DisplayPolicy.java:539,
                  SurfaceAnimationRunner.java:242, and
                  com_android_server_power_PowerManagerService.cpp:200 when
                  the display is turned back on
    LOW_POWER     BatterySaverController.java:456
    SUSTAINED_PERFORMANCE, VR_MODE  PowerManagerService
    VIDEO_*, AUDIO_*, CAMERA_*, EXPENSIVE_RENDERING  media/camera/SurfaceFlinger

  INTERACTION is therefore the "the screen is on and the owner is using it"
  signal, and it is deliberately given the full-throttle allocation: 4+4 cores,
  both clusters at their top OPP. Screen-off needs no entry: no interaction
  arrives, the lock expires, and the kernel's own PPM_POLICY_LCM_OFF (priority
  7, above PERF_SERV at 8) drops cluster 0 to 156 MHz. That was measured:
  scaling_min_freq falls 598000 -> 156000 within 8 s of blanking.

  A permanent pin THROUGH USER_LIMIT was considered and rejected.
  /proc/ppm/policy/userlimit_* does hold 8 cores at 1.508/1.001 GHz (confirmed
  on the handset), but USER_LIMIT sits at priority 6, above LCM_OFF, so a
  boot-time pin would keep all eight cores at maximum with the screen off.

  A screen-on pin WAS shipped, by a different route: perfd/k50sv1_perfd.c
  drives PERF_SERV's own /proc/ppm/policy/perfserv_perf_idx and follows the
  panel backlight, so it releases on blank. Read that file's header before
  changing anything here; the two are one design. It also has nowhere to go
  when PPM_POLICY_THERMAL starts cutting: on a 28 nm part 8xA53 at 1.5 GHz is
  ~4-5 W and throttles within minutes, which is slower under sustained load
  than letting the governor and the hints work.
-->
<SCNTABLE>
    <!-- ============ AOSP hints (these are the ones that fire) ============ -->

    <!-- Activity cold start. The single largest perceived-latency item on an
         8xA53: everything from dex2oat-less class loading through the first
         frame is CPU-bound. -->
    <scenario powerhint="LAUNCH">
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_0" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_0" param1="1001000"></data>
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_1" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_1" param1="1508000"></data>
        <data cmd="PERF_RES_POWER_HINT_HOLD_TIME" param1="5000"></data>
    </scenario>

    <!-- Touch, scroll, window animation, rotation, and display-on.
         PERF_RES_POWER_HINT_HOLD_TIME is set to 5000 ms for parity with the
         value stock uses and because libpowerhal echoes it back from
         updateCusScnTable, so a wrong value here would be visible in the log.
         It does NOT govern how long the lock is held. That was measured: the
         lock is released 235-705 ms after the hint regardless, and raising this
         from 5000 to 20000 changed nothing (E-031, and perfd/k50sv1_perfd.c:14-19,
         where the same measurement is the entire justification for perfd
         existing). An earlier version of this comment claimed the opposite and
         offered a verification recipe for it; the recipe was never going to
         show what it promised.

         Sustained screen-on residency comes from perfd, not from this value.
         Watch the thermal policy either way - PPM_POLICY_THERMAL outranks
         PERF_SERV, so sustained load will still be cut back rather than
         cooking the part.
         Deliberately NOT combined with PERF_RES_POWERHAL_SCREEN_OFF_STATE: that
         command's default (0) is what drops the lock when the panel blanks, and
         setting it to 1 would keep the boost alive with the screen off. -->
    <scenario powerhint="INTERACTION">
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_0" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_0" param1="1001000"></data>
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_1" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_1" param1="1508000"></data>
        <data cmd="PERF_RES_POWER_HINT_HOLD_TIME" param1="5000"></data>
    </scenario>

    <!-- SurfaceFlinger raises this while a frame costs more than the budget.
         CPU only. PERF_RES_GPU_FREQ_MIN is in libpowerhal's command list and
         targets /d/ged/hal/custom_boost_gpu_freq. Debugfs is now mounted for
         kernel-wakelock accounting, but the GED node and the blob command have
         not yet been validated together on the rebuilt image. Keep this hint
         honest and CPU-only until that post-flash check succeeds. The
         Mali-T860 MP2 runs 676/520/351 MHz
         (/proc/gpufreq/gpufreq_opp_dump) under its own governor. -->
    <scenario powerhint="EXPENSIVE_RENDERING">
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_0" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_0" param1="1001000"></data>
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_1" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_1" param1="1508000"></data>
    </scenario>

    <!-- Camera. Launch and capture are latency-bound and get everything;
         streaming is a sustained load and is held one step below the top OPP
         on each cluster so the thermal policy has somewhere to cut before it
         starts dropping frames. -->
    <scenario powerhint="CAMERA_LAUNCH">
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_0" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_0" param1="1001000"></data>
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_1" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_1" param1="1508000"></data>
    </scenario>
    <scenario powerhint="CAMERA_SHOT">
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_0" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_0" param1="1001000"></data>
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_1" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_1" param1="1508000"></data>
    </scenario>
    <scenario powerhint="CAMERA_STREAMING">
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_0" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_0" param1="819000"></data>
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_1" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_1" param1="1196000"></data>
    </scenario>

    <!-- Media. The MT6755 has hardware codecs, so the CPU cost is buffer
         handling and the container/network path, not the codec itself. A
         floor on the LITTLE cluster is enough; pinning the big cluster for a
         two-hour video would only cost battery. -->
    <scenario powerhint="VIDEO_DECODE">
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_0" param1="2"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_0" param1="689000"></data>
    </scenario>
    <scenario powerhint="VIDEO_ENCODE">
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_0" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_0" param1="819000"></data>
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_1" param1="2"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_1" param1="1027000"></data>
    </scenario>

    <!-- Audio. An underrun is audible, so hold a real floor on the LITTLE
         cluster; the big cluster is not needed for a PCM path. -->
    <scenario powerhint="AUDIO_LOW_LATENCY">
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_0" param1="2"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_0" param1="819000"></data>
    </scenario>
    <scenario powerhint="AUDIO_STREAMING">
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_0" param1="2"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_0" param1="494000"></data>
    </scenario>

    <!-- Caps, not floors. SUSTAINED_PERFORMANCE exists so an app can ask for a
         level it can hold indefinitely, and LOW_POWER is battery saver; both
         are held until the framework sends the matching release. -->
    <scenario powerhint="SUSTAINED_PERFORMANCE">
        <data cmd="PERF_RES_CPUFREQ_MAX_CLUSTER_0" param1="819000"></data>
        <data cmd="PERF_RES_CPUFREQ_MAX_CLUSTER_1" param1="1196000"></data>
    </scenario>
    <scenario powerhint="LOW_POWER">
        <data cmd="PERF_RES_CPUFREQ_MAX_CLUSTER_0" param1="819000"></data>
        <data cmd="PERF_RES_CPUCORE_MAX_CLUSTER_1" param1="2"></data>
        <data cmd="PERF_RES_CPUFREQ_MAX_CLUSTER_1" param1="1027000"></data>
    </scenario>

    <!-- ==== MTK hints: inert on a pure-AOSP framework, correct if it ever
             is not. Same allocation as their AOSP equivalents. ==== -->

    <scenario powerhint="MTKPOWER_HINT_APP_TOUCH">
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_0" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_0" param1="1001000"></data>
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_1" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_1" param1="1508000"></data>
    </scenario>
    <scenario powerhint="MTKPOWER_HINT_ACT_SWITCH">
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_0" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_0" param1="1001000"></data>
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_1" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_1" param1="1508000"></data>
    </scenario>
    <scenario powerhint="MTKPOWER_HINT_PACK_SWITCH">
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_0" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_0" param1="1001000"></data>
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_1" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_1" param1="1508000"></data>
    </scenario>
    <scenario powerhint="MTKPOWER_HINT_PROCESS_CREATE">
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_0" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_0" param1="1001000"></data>
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_1" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_1" param1="1508000"></data>
    </scenario>
    <scenario powerhint="MTKPOWER_HINT_WHITELIST_LAUNCH">
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_0" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_0" param1="1001000"></data>
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_1" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_1" param1="1508000"></data>
    </scenario>
    <scenario powerhint="MTKPOWER_HINT_APP_ROTATE">
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_0" param1="4"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_0" param1="1001000"></data>
        <data cmd="PERF_RES_CPUCORE_MIN_CLUSTER_1" param1="2"></data>
        <data cmd="PERF_RES_CPUFREQ_MIN_CLUSTER_1" param1="1508000"></data>
    </scenario>
</SCNTABLE>
