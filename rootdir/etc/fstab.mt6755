# Android Q first-stage mounts
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/system    /system               ext4  ro                                          wait,first_stage_mount
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/vendor    /vendor               ext4  ro                                          wait,first_stage_mount

# /data is unencrypted on every tier by owner decision: plaintext at rest,
# with ro.crypto.state=unsupported. Do not add encryption flags to this row.
# Migrating existing encrypted userdata requires a wipe. The owner authorizes
# /data cleanup during bring-up; preserve the identity/calibration stores below.
# F2FS uses periodic vold FITRIM (nodiscard), with flush barriers and recovery.
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/userdata  /data  f2fs  noatime,nosuid,nodev,nodiscard  wait,check,formattable,quota
# /cache retains online discard; it is not an identity/calibration store.
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/cache     /cache                ext4  noatime,nosuid,nodev,noauto_da_alloc,discard  wait,check,formattable

# protect1/protect2/nvdata hold radio identity and calibration: never auto-format
# or discard them. notrim excludes all three from vold idle FITRIM on every tier.
# nofail allows boot to continue on a mount failure; diagnose and restore from
# a verified backup instead of replacing an unreadable store with empty data.
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/protect1  /mnt/vendor/protect_f ext4  noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc  wait,check,nofail,notrim
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/protect2  /mnt/vendor/protect_s ext4  noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc  wait,check,nofail,notrim
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvdata    /mnt/vendor/nvdata    ext4  noatime,nosuid,nodev,noauto_da_alloc,commit=1             wait,check,nofail,notrim

# Removable storage
/devices/mtk-msdc.0/11240000.msdc1*                             auto                  auto  defaults                                    voldmanaged=sdcard1:auto,encryptable=userdata
/devices/soc/11270000.usb3_xhci*                                auto                  auto  defaults                                    voldmanaged=usbotg:auto

# Recovery-visible raw partitions
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/frp       /persistent           emmc  defaults                                    defaults
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/para      /misc                 emmc  defaults                                    defaults
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/boot      /boot                 emmc  defaults                                    defaults
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/recovery  /recovery             emmc  defaults                                    defaults
