# Sensors 2.0 FMQ wake-up events require both the wakelock group and
# BLOCK_SUSPEND capability; the board SELinux rule grants wakelock_use().
service vendor.sensors-hal-2-0 /vendor/bin/hw/android.hardware.sensors@2.0-service
    class hal
    user system
    group system wakelock
    capabilities BLOCK_SUSPEND
    rlimit rtprio 10 10
