# wmt_drv creates /dev/wmtdetect and /dev/stpwmt. The early_hal
# wmt_loader waits for these nodes, initializes the chip, then publishes
# vendor.connsys.driver.ready. wmt_launcher also waits for that property
# before opening its control session.
on boot
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/insmod /vendor/lib/modules/wmt_drv.ko

# Load the dependent modules after wmt_loader has initialized WMT.
# Node creation by ueventd can lag behind insmod completion. wlan_assistant
# starts with class main and waits for /dev/wmtWifi and factory WIFI
# calibration itself; init.wmt.rc retains automatic service restart.
on property:vendor.connsys.driver.ready=yes
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/insmod /vendor/lib/modules/wmt_chrdev_wifi.ko
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/insmod /vendor/lib/modules/wlan_drv_${ro.vendor.wlan.gen}.ko
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/insmod /vendor/lib/modules/bt_drv.ko
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/insmod /vendor/lib/modules/gps_drv.ko
