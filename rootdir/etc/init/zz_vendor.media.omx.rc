# Parsed after the AOSP service definition. The MTK Vcodec node is deliberately
# group-readable rather than world-accessible, so mediacodec needs the system
# supplementary group used by the verified Stock OMX service.
service vendor.media.omx /vendor/bin/hw/android.hardware.media.omx@1.0-service
    class main
    user mediacodec
    group camera drmrpc mediadrm system
    ioprio rt 4
    writepid /dev/cpuset/foreground/tasks
    override
