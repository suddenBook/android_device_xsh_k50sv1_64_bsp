service wmt_loader /vendor/bin/wmt_loader
    class early_hal
    user system
    group system
    oneshot

service wmt_launcher /vendor/bin/wmt_launcher -p /vendor/firmware/ -o 1
    class early_hal
    user system
    group system

# NOT `disabled`, deliberately, and this is the one place stock had it right.
#
# wlan_assistant pushes the factory WIFI record from
# /mnt/vendor/nvdata/APCFG/APRDEB/WIFI into the WLAN driver through
# /dev/wmtWifi. That record carries the MAC and the 5 GHz band-enable and
# power tables; without it the driver takes a random MAC, loses the whole
# 5 GHz band, and its SSID string field reads "NVRAM WARNING: Err = 0x01".
#
# The binary is SELF-SYNCHRONISING. Disassembled: it polls
# access("/dev/wmtWifi", F_OK) in an unbounded sleep(1) loop, and then polls
# access(<record>, R_OK) in a second unbounded sleep(1) loop. Started too
# early it sleeps; it does not fail. It also reads no properties at all --
# `property_set` is the only property symbol it imports -- so it cannot be
# gated on one, and `vendor.mtk.nvram.ready` is its OUTPUT, not its input.
#
# Adding `disabled` here converted that self-synchronising daemon into a
# single-shot one whose only start point was a property trigger, which made
# boot ordering load-bearing where it had not been. That is what turned an
# unrelated timing change into a silently missing Wi-Fi band (E-047, which
# corrects E-045's account of the same failure). Stock's
# vendor/etc/init/wlan_assistant.rc has no `disabled`; neither does this.
#
# Not `oneshot` either, also matching stock: init restarts a non-oneshot
# service that exits, so even the one real fast-exit path the binary has --
# /dev/wmtWifi absent or not a character device at stat() time -- self-heals.
service wlan_assistant /vendor/bin/wlan_assistant
    class main
    user wifi
    group system gps inet

# `-O` is not cosmetic and it is not Stock's. Without it wpa_supplicant creates
# NO per-interface control socket at all, anywhere -- measured live on this
# handset with Wi-Fi up: both /data/misc/wifi/sockets and
# /data/vendor/wifi/wpa/sockets were empty.
#
# The mechanism is ctrl_iface_unix.c:718-752. When the global control interface
# is "@android:wpa_wlan0" it takes the text after the '_' -- "wlan0" -- and
# compares it with conf->ctrl_interface, which /vendor/etc/wifi/wpa_supplicant.conf
# sets to exactly "wlan0". They match, so `same` is 1 and the function returns
# early with "global ctrl interface %s matches ctrl interface %s - do not open
# per-interface ctrl interface". Stock has the same defect; it is a latent
# MediaTek bug that shipped, on a non-fatal error path.
#
# It matters here because three MAL entity libraries open that socket by
# absolute path -- libmal_epdga.so (the ePDG one), libmal_rds.so and
# libmal_nwmngr.so, each also binding its own {ea,rds,nwmngr}_ctrlconn beside
# it -- and log "Can't connect to wpa server side" forever without it. All
# three send only STATUS, SIGNAL_POLL and BSS <bssid>: read-only queries that
# cannot fight WifiService for control of the supplicant.
#
# -O sets conf->ctrl_interface to a PATH, which no longer equals "wlan0", so
# `same` becomes 0 and the socket is created. The VENDOR directory is chosen
# deliberately over the /data/misc/wifi/sockets that the blobs actually name:
# that path is wpa_socket, a core_data_file_type, and letting a vendor HAL
# create files there is the Treble violation AOSP removed in
# device/google/marlin 66da37914e91. /data/vendor/wifi/wpa is wpa_data_file, a
# vendor type the supplicant is already allowed to write
# (system/sepolicy/vendor/hal_wifi_supplicant_default.te:19-21), and
# init.mt6755.rc bind-mounts it onto the legacy path so the blobs find it.
#
# Side effect worth knowing: update_config=1 means a later config save writes
# this path into /data/vendor/wifi/wpa/wpa_supplicant.conf as ctrl_interface.
# Harmless -- -O overrides it on every start, and /data is wiped on every flash.
service wpa_supplicant /vendor/bin/hw/wpa_supplicant -O/data/vendor/wifi/wpa/sockets -g@android:wpa_wlan0
    interface android.hardware.wifi.supplicant@1.0::ISupplicant default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant default
    interface android.hardware.wifi.supplicant@1.2::ISupplicant default
    # manifest.xml declares this one too, and wpa_supplicant really registers
    # it, but without an `interface` line here it can never be lazily started.
    # On a lookup miss hwservicemanager fires ctl.interface_start <fqName>/<inst>
    # (ServiceManager.cpp:246-256) and init resolves it by EXACT STRING MATCH
    # against the set built from these lines (service.cpp:516-545). With no
    # match nothing starts and the caller spins, because the manifest says
    # hwbinder so vintfHwbinder is true and getService()'s retry loop
    # (ServiceManagement.cpp:774) only breaks on !retry. Latent while only AOSP
    # code asks -- an AOSP getService starts the process, which then registers
    # all four -- but the declaration is a promise and this makes it true.
    interface vendor.mediatek.hardware.wifi.supplicant@2.0::ISupplicant default
    socket wpa_wlan0 dgram 660 wifi wifi
    class main
    user wifi
    group wifi inet net_raw net_admin
    capabilities NET_ADMIN NET_RAW
    disabled
    oneshot
