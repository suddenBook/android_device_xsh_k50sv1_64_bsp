service wmt_loader /vendor/bin/wmt_loader
    class early_hal
    user system
    group system
    oneshot

service wmt_launcher /vendor/bin/wmt_launcher -p /vendor/firmware/ -o 1
    class early_hal
    user system
    group system

# Push the existing factory WIFI calibration through /dev/wmtWifi.
# The source loader waits for both paths. Keep class startup and automatic
# restart so module/node recreation or a transient read failure recovers.
service wlan_assistant /vendor/bin/wlan_assistant
    class main
    user wifi
    group system

# `-O` forces a real per-interface socket; Stock's global-name/config match
# suppresses it. MAL's extracted binaries have their legacy core-data paths
# rewritten to this device-owned wpa_data_file directory, avoiding both the
# old Treble violation and a bind mount onto /data/misc/wifi/sockets.
service wpa_supplicant /vendor/bin/hw/wpa_supplicant -O/data/vendor/wifi/sock -g@android:wpa_wlan0
    interface android.hardware.wifi.supplicant@1.0::ISupplicant default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant default
    interface android.hardware.wifi.supplicant@1.2::ISupplicant default
    # manifest.xml declares this one too, and wpa_supplicant really registers
    # it, but without an `interface` line here it can never be lazily started.
    # On a lookup miss hwservicemanager fires ctl.interface_start <fqName>/<inst>
    # (ServiceManager.cpp:246-256) and init resolves it by EXACT STRING MATCH
    # against the set built from these lines (service.cpp:516-545). With no
    # match nothing starts and the caller spins, because the manifest says
    # hwbinder so vintfHwbinder is true and getService()'s retry loop
    # (ServiceManagement.cpp:774) only breaks on !retry. Latent while only AOSP
    # code asks -- an AOSP getService starts the process, which then registers
    # all four -- but the declaration is a promise and this makes it true.
    interface vendor.mediatek.hardware.wifi.supplicant@2.0::ISupplicant default
    socket wpa_wlan0 dgram 660 wifi wifi
    class main
    user wifi
    group wifi inet net_raw net_admin
    capabilities NET_ADMIN NET_RAW
    disabled
    oneshot
