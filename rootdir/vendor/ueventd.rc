# Required physical partitions
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/boot      0640  root  system
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/recovery  0640  root  system
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/secro     0640  root  system
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/seccfg    0660  root  system
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/proinfo   0600  root  root
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvram     0660  root  system
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvdata    0600  root  root
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/para      0660  root  system
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/frp       0660  root  system
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/md1img    0660  root  system
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/md1dsp    0660  root  system
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/md1arm7   0660  root  system

# NOT repeated as numeric rules. An earlier revision listed
# /dev/block/mmcblk0p{2,6,12,17} here on the premise that "the by-name entries
# above are symlink aliases" and only a numeric rule sets the real node's DAC.
# That is false: DeviceHandler::GetDevicePermissions() matches the node path AND
# every by-name link. Proven on the handset -- mmcblk0p4 has no numeric rule at
# all, only the by-name/frp rule above, and it comes out root:system 0660.
#
# They were also a latent hazard, because the match runs in REVERSE order so the
# LAST matching rule wins: if the GPT ever shifted, a stale numeric rule would
# silently override the by-name rule it was meant to reinforce.

# MTK connectivity
/dev/stpwmt       0660  system     system
/dev/wmtdetect    0660  system     system
/dev/stpbt        0660  bluetooth  bluetooth
/dev/btif         0600  system     system
/dev/stpgps       0660  gps        gps
/dev/wmtWifi      0660  wifi       wifi

# NOT declared: /dev/ttyMT1. Stock's vendor/ueventd.rc has no ttyMT rule
# either; this port added one and nothing on the device opens it.
# wmt_launcher, wmt_loader and wlan_assistant open only /dev/stpwmt,
# /dev/wmtdetect and /dev/wmtWifi, and the combo chip's UART is bound in the
# kernel by the STP driver. The rule handed group `system` read/write on a raw
# UART for no consumer, so it is removed rather than kept "for symmetry".

# NOT declared: /dev/fm. The FM radio driver is deliberately not loaded (its
# firmware was never extracted either), so the node never appears and the rule
# only described hardware this build does not bring up.

# NOT declared: /dev/accdet, and this one was measured with the accessory
# actually inserted rather than argued from a string.
#
# audio.primary.mt6755.so contains the literal `/dev/accdet` and runs as
# `audioserver`, while the node is 0600 root:root -- the same shape as
# /dev/mtk_sched, which four camera libraries name and the camera never opens
# (E-144). With the owner's USB-C headset plugged in and routing working:
#
#   dumpsys input                SwitchValues: 94
#     = SW_HEADPHONE_INSERT | SW_MICROPHONE_INSERT | SW_JACK_PHYSICAL_INSERT
#   /proc/*/fd across every pid  nobody holds /dev/accdet
#   logcat                       one line, from the KERNEL:
#     [Accdet]ACC EINT 33 func :plug-in, cur_eint_state = 1  (kworker/u16:4)
#   no Permission denied, no accdet error anywhere
#   dumpsys media.audio_policy   `Wired Headset Mic` / AUDIO_DEVICE_IN_WIRED_HEADSET
#                                / name h2w becomes AVAILABLE
#   dumpsys audio                Devices: headset, and the owner confirms the
#                                speaker goes silent on insertion
#
# So detection is entirely kernel-side: an EINT handler raises the switch and
# publishes it on the ACCDET input device, which is what the framework reads
# through config_useDevInputEventForAudioJack. The HAL's own accdet handle is on
# no path this device uses. Do not add a rule from the string.

# Modem and telephony audio
/dev/ccci*        0660  radio  radio
/dev/ttyC*        0660  radio  radio
/dev/ccci_aud     0660  audio  audio

# Active graphics allocator/GPU ABI.
#
# These two are NOT one decision, and stock's identical 0666 hid that.
#
# /dev/mali0 keeps 0666 because AOSP grants it: public/app.te:212 is
# `allow { appdomain -isolated_app } gpu_device:chr_file rw_file_perms`, i.e.
# every app really does get read AND write.
#
# /dev/ion is 0664. AOSP's matching rule, public/app.te:302, is r_file_perms --
# read only -- and no path on this image needs more. Measured rather than
# assumed: exactly one shipped vendor ELF contains the literal "/dev/ion"
# (hwcomposer.mt6755.so) and all five of its open sites are
# `mov w1, wzr; bl __open_2`, i.e. flags 0 = O_RDONLY. Every other consumer
# (gralloc.mt6755.so, libion_mtk.so, libgralloc_extra.so, all 32+64) imports
# AOSP libion's ion_open, which is open(O_RDONLY|O_CLOEXEC) at
# system/core/libion/ion.c:57. All 20 live /dev/ion fds on the handset report
# flags=02400000, which on arm64 is O_CLOEXEC|O_LARGEFILE with access mode 0 --
# across 8 app processes and every graphics/media server. ION_IOC_ALLOC works
# on a read-only fd; an app is not in `graphics` and takes the other-read bit.
/dev/mali0         0666  system  graphics
/dev/ion           0664  system  graphics
/dev/mtk_disp_mgr  0660  system  graphics
# 0660, not stock's 0644. This is the CVE-2020-0069 / MTK-su entry point, and
# every SELinux grant in this tree is { ioctl open read } to three confined
# domains -- hal_camera_default, the graphics stack and mtk_hal_mms -- none of
# which needs the world-read bit. On the permissive diagnostic tiers the DAC bit
# is the ONLY thing between an installed app and the node.
/dev/mtk_cmdq      0660  system  system
/dev/MTK_SMI       0660  media   media
/dev/Vcodec        0660  media   system
/dev/sw_sync       0664  system  graphics

# Camera nodes present on this board. "Present" means the node exists, which is
# weaker than it looks: MediaTek's kd_camera_hw creates MAINAF and SUBAF
# unconditionally, so /dev/SUBAF is not evidence that the front camera has a
# focus motor -- a punch-hole selfie module is usually fixed-focus, and the HAL1
# parameter string advertises the identical focus-mode-values for both devices,
# so that is not evidence either. Labelling a node that turns out to be inert
# costs nothing; asserting the hardware from it would be wrong.
/dev/CAM_CAL_DRV1          0660  system  camera
/dev/CAM_CAL_DRV2          0660  system  camera
/dev/MAINAF                0660  system  camera
/dev/SUBAF                 0660  system  camera
/dev/camera-fdvt           0660  system  camera
/dev/camera-isp            0660  system  camera
/dev/kd_camera_flashlight  0660  system  camera
/dev/kd_camera_hw          0660  system  camera
/dev/kd_camera_hw_bus2     0660  system  camera

# Verified MIR3DA accelerometer and touch compatibility node
/dev/gsensor    0660  system  system
/dev/m_acc_misc 0660  system  system
/dev/touch      0660  root    system

# Power/watchdog and MTK GPIO used by radio
/dev/RT_Monitor  0660  system  system
/dev/spm         0660  system  system
/dev/mtgpio      0600  radio   root

# NOT declared: /dev/mtk-adc-cali. 0600 root:root is exactly what ueventd
# already applies to an unmatched node (system/core/init/devices.cpp:250-252
# returns {0600, 0, 0}), so the rule only restated the default.

# Shard ueventd's cold-boot /sys restorecon across the handler subprocesses it
# already forks. ColdBoot::Run() (system/core/init/ueventd.cpp:243-266) walks
# /sys and /sys/devices single-threaded in the parent unless this is set; with
# it, :248-254 hands the two walks to the same subprocesses that are otherwise
# idle, and WaitForSubProcesses() still gates /dev/.coldboot_done, so nothing
# downstream can observe a partially restored /sys. ro.boottime.init.cold_boot_wait
# is 303 ms of this device's 941 ms init on eight A53 cores; measure that pair
# in kmsg ("Coldboot took ...") before and after if it is ever changed back.
parallel_restorecon enabled

# Deliberately NOT given permissions, so they keep ueventd's 0600 root root
# default:
#   /dev/silead_fp, /dev/silead_spi  - the FP driver probes but no fingerprint
#                                      sensor is fitted and no FP HAL is built
#   /dev/mt6605                      - NFC controller node, no NFC hardware
#   /dev/block/mmcblk0*, /dev/misc-sd, /dev/devmap, /dev/emmcrpmb0
#                                    - stock opens these group-system for MTK
#                                      factory/META tooling that this build does
#                                      not ship; nvram_daemon runs as root and
#                                      needs no relaxation.
