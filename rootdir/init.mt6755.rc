# Operations on the root ramdisk must remain in the platform init domain.
# A vendor rc is parsed in vendor_init and cannot safely create mount points
# below the tmpfs-backed /mnt hierarchy on an enforcing boot.
on early-init
    mkdir /mnt/vendor 0755 root root
    mkdir /mnt/vendor/protect_f 0770 system system
    mkdir /mnt/vendor/protect_s 0770 system system
    mkdir /mnt/vendor/nvdata 0771 root system

# This 3.18 kernel has no schedtune controller.  AOSP's generic init.rc still
# creates the directories, and later task-profile writes otherwise turn their
# "tasks" nodes into ordinary tmpfs files.  Remove the empty placeholders
# before zygote starts so scheduling requests fail closed with ENOENT.
on post-fs
    rmdir /dev/stune/foreground
    rmdir /dev/stune/background
    rmdir /dev/stune/top-app
    rmdir /dev/stune/rt
    rmdir /dev/stune

# Persistent Stock properties survive fastboot partition flashes. Normalize
# them only after /data/property has been loaded, otherwise the old WFC/video/
# RCS values would overwrite the voice-only product defaults moments later.
on property:ro.persistent_properties.ready=true
    setprop persist.vendor.ims_support 1
    setprop persist.vendor.mims_support 1
    setprop persist.vendor.mtk_dynamic_ims_switch 0
    setprop persist.vendor.mtk_wfc_support 0
    setprop persist.vendor.mtk.wfc.enable 0
    setprop persist.vendor.vilte_support 0
    setprop persist.vendor.mtk.vilte.enable 0
    setprop persist.vendor.viwifi_support 0
    setprop persist.vendor.mtk.viwifi.enable 0
    setprop persist.vendor.mtk.ims.video.enable 0
    setprop persist.vendor.mtk_rcs_ua_support 0
    setprop persist.vendor.mtk_rtt_support 0
    setprop persist.vendor.volte_support 1
    setprop persist.vendor.wfc.sys_wfc_support 0
