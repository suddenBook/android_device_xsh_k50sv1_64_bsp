<?xml version="1.0" encoding="utf-8"?>
<!-- Icon-pack component map, read by Trebuchet's
     IconPackProvider.parseAppFilter (packages/apps/Trebuchet/src/com/android/
     launcher3/lineage/icon/providers/IconPackProvider.java:159-171), which
     resolves it with getIdentifier("appfilter","xml",pkg). res/xml ONLY;
     assets/appfilter.xml is ignored by this launcher.

     MATCHING IS EXACT ComponentName, not package. IconPack.getIcon looks up
     name.flattenToString() only (IconPack.java:105-107), so the package-only
     key IconPackProvider also stores is dead. An app that renames its launcher
     activity needs a second row here.

     An app with no row keeps its own icon, unmodified: IconPack.getDrawable
     returns null (:113-119) and CustomIconProvider falls back (:38-47). The
     iconback / iconmask / iconupon compose path is unreachable on 17.1 because
     CustomIconProvider passes appIcon == null, so a partly-populated pack looks
     mixed rather than uniformly themed. That is why every launcher activity
     this ROM ships has a row.

     A row for an app that is NOT installed costs nothing and takes effect the
     moment the app appears; the pack is pure data with no build-time dependency
     on the target APK. -->
<resources>
    <!-- Applications this ROM ships. All 20 launcher activities are covered. -->
    <item component="ComponentInfo{com.android.calculator2/com.android.calculator2.Calculator}" drawable="miui_calculator" />
