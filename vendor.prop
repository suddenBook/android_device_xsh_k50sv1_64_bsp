# Android Q automatically appends this device-local file to vendor/build.prop.
# Keep MTK implementation defaults here so their partition ownership is
# explicit and init can consume them before the corresponding HALs start.
persist.vendor.connsys.coredump.mode=0

# Voice-only legacy MTK IMS. AOSP ImsManager owns carrier/user gating; disable
# MTK's independent MCC/MNC resource switch and every WFC/video capability.
persist.vendor.ims_support=1
persist.vendor.mims_support=1
persist.vendor.mtk.volte.enable=1
persist.vendor.mtk.vilte.enable=0
persist.vendor.mtk.viwifi.enable=0
persist.vendor.mtk.wfc.enable=0
persist.vendor.mtk.ims.video.enable=0
persist.vendor.mtk_rcs_ua_support=0
persist.vendor.mtk_rtt_support=0
persist.vendor.mtk_dynamic_ims_switch=0
persist.vendor.mtk_wfc_support=0
persist.vendor.vilte_support=0
persist.vendor.viwifi_support=0
persist.vendor.volte_support=1
persist.vendor.wfc.sys_wfc_support=0
# Skip absent extension/legacy jars and use the APK's built-in base factories.
ro.vendor.mtk_telephony_add_on_policy=1
ro.vendor.md_auto_setup_ims=0
ro.vendor.md_mims_support=1
ro.vendor.md_prop_ver=1

ro.vendor.net.upload.benchmark.default=blocking
ro.vendor.md_apps.load_gencfg=GEN91_USER
ro.vendor.md_apps.load_type=user
ro.vendor.md_apps.load_verno=MOLY.LR11.W1630.MD.MP.V191.4
ro.vendor.md_apps.support=1
ro.vendor.mediatek.platform=MT6755
ro.vendor.mtk_aal_support=1
ro.vendor.mtk_agps_app=1
ro.vendor.mtk_audio_alac_support=1
ro.vendor.mtk_audio_ape_support=1
ro.vendor.mtk_audio_tuning_tool_ver=V2.2
ro.vendor.mtk_besloudness_support=1
ro.vendor.mtk_camera_app_version=1
ro.vendor.mtk_emmc_support=1
ro.vendor.mtk_f2fs_enable=0
ro.vendor.mtk_fd_support=1
ro.vendor.mtk_gps_support=1
ro.vendor.mtk_log_hide_gps=0
ro.vendor.mtk_md1_support=10
ro.vendor.mtk_pq_color_mode=1
ro.vendor.mtk_pq_support=2
ro.vendor.mtk_protocol1_rat_config=Lf/Lt/W/T/G
ro.vendor.mtk_ril_mode=c6m_3rild
ro.vendor.mtk_rild_read_imsi=1
ro.vendor.mtk_zsdhdr_support=1
ro.vendor.radio.max.multisim=dsds
ro.vendor.wlan.gen=gen2

# Hardware facts that describe this chassis, kept on /vendor so a system-only
# OTA or a GSI boot cannot contradict them. Moved here from device.mk's
# PRODUCT_SYSTEM_DEFAULT_PROPERTIES, which put them on /system.
#
# ro.hardware.egl names the vendor GL driver loaded from /vendor/lib*/egl/.
# ro.frp.pst is a vendor block-device path.
# ro.opengles.version 196610 = ES 3.2, corroborated by GL_ANDROID_extension_pack_es31a
#   in the live GL extension string.
# The four telephony keys are modem topology: two physical SIM slots, DSDS,
# LTE-preferred on both, and IWLAN in legacy mode (see the long note in
# device.mk for why the last one is stated rather than inherited).
ro.hardware.egl=mali
ro.frp.pst=/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/frp
ro.opengles.version=196610
persist.radio.multisim.config=dsds
ro.telephony.sim.count=2
ro.telephony.default_network=9,9,9,9
ro.telephony.iwlan_operation_mode=legacy
