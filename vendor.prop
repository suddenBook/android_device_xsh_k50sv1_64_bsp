# Android Q automatically appends this device-local file to vendor/build.prop.
# Keep MTK implementation defaults here so their partition ownership is
# explicit and init can consume them before the corresponding HALs start.
#
# persist.vendor.connsys.coredump.mode=0 was the first line of this file and is
# DELETED. It had no reader on this build, and by this file's own rule a
# property with no reader is decoration.
#   * Zero occurrences of the string anywhere under
#     vendor/xsh/k50sv1_64_bsp/proprietary -- searched raw across every file,
#     and again inside all ten unzipped jars/apks and their disassembled dex.
#     The `coredump mode` concept exists in vendor/lib/modules/wmt_drv.ko, but
#     as driver-internal state and printk text, not an Android property.
#   * Stock's only consumer is /vendor/etc/init/init_connectivity.rc, whose
#     `on property:persist.vendor.connsys.coredump.mode=...` blocks write
#     /proc/driver/wmt_dbg. This tree does not ship init_connectivity.rc.
#   * Stock does not set it in any of its nine prop files either, so removing
#     it is also a move TOWARDS stock parity, not away from it.
# It is also the one persist.* key here that could never be re-asserted after a
# stale /data, which is how it was found -- see the block at the end of this
# file. Deleting beat guarding.
# NOTE for whoever owns sepolicy: sepolicy/safety/property_contexts:5 and
# sepolicy/safety/vendor_init.te:18 both name this key in comments. The
# set_prop(vendor_init, mtk_wmt_prop) rule itself is still right for the rest of
# the persist.vendor.connsys.* namespace; only the example is now stale.

# Legacy MTK IMS. AOSP ImsManager owns the user setting, CarrierConfig owns
# carrier availability, and the MediaTek WFO/ePDG data plane is shipped. Video
# remains disabled; WFC starts off until the user enables it.
persist.vendor.ims_support=1
persist.vendor.mims_support=1
persist.vendor.mtk.volte.enable=1
persist.vendor.mtk.vilte.enable=0
persist.vendor.mtk.viwifi.enable=0
# The USER-FACING Wi-Fi calling switch. 0 here is the INITIAL value only -- the
# value used when /data carries none -- so WFC is off until the owner turns it
# on in Settings, and their choice then survives in /data.
#
# Deliberately NOT re-asserted in init.mt6755.rc's
# `on property:ro.persistent_properties.ready` block, which is the one exception
# to that block's rule. Re-asserting it zeroed the switch 13.7 s before
# WifiOffloadService's constructor -- the only thing that ever reads it -- and
# WFC could never turn on. The measurement is in the rc file's comment.
persist.vendor.mtk.wfc.enable=0
persist.vendor.mtk.ims.video.enable=0
persist.vendor.mtk_rcs_ua_support=0
persist.vendor.mtk_rtt_support=0
# persist.vendor.mtk_ct_volte_support=1, exactly as stock sets it
# (vendor/build.prop:135). It is ADDED here, reversing an explicit earlier
# exclusion, and the reversal is the point: the old justification was that the
# key "selects China-Telecom-specific IMS code and is irrelevant to the
# open-market/KPN control". That is a reading of the NAME. It is the same move
# that broke VoLTE twice already on persist.vendor.mtk_wfc_support and
# persist.vendor.wfc.sys_wfc_support (trap 25), and it is wrong for the same
# reason: the decisive consumer is not in the Java layer the name suggests.
#
# mtk-ril.so's imsInit reads it and passes it STRAIGHT TO THE MODEM, on every
# SIM, with no operator gate at all (aarch64, vaddr of the key is 0x2b703):
#
#   0x000bf070  bl  property_get      ; "persist.vendor.mtk_ct_volte_support", "0"
#   0x000bf078  bl  atoi
#   0x000bf07c  cmp w0, #1
#   0x000bf080  b.ne 0xbf0ac
#   0x000bf094  bl  at_send_command   ; AT+ECFGSET="mtk_ct_volte_support","1"
#                                     ; logs 'VoLTE over IMS is support[ed] and
#                                     ;       AT+ECFGSET=...,1'
#   0x000bf0bc  bl  at_send_command   ; AT+ECFGSET="mtk_ct_volte_support","0"
#                                     ; logs 'VoLTE over IMS is supported and
#                                     ;       AT+ECFGSET=...,0'
#
# So this is not a framework switch at all: it is the AP->modem transport for a
# modem config item of the same name, written during IMS init. Stock sends "1"
# to this exact modem build (MOLY.LR11.W1630.MD.MP.V191.4, which
# ro.vendor.md_apps.load_verno above already pins), so "1" is known-good on this
# hardware. Unset, the RIL takes the default "0" and tells the modem the
# opposite of what stock tells it -- inside the one code path this port is
# actively trying to fix.
#
# The four other shipped consumers ARE operator-gated, which is where the
# China-Telecom reading came from, and on this device's SIMs they are no-ops
# either way (OP09 is MediaTek's China Telecom operator id):
#   mtk-rilproxy.so           RpFeatureOptionUtils::isCtVolteSupport() @0x14a520
#   ImsService.apk            OperatorUtils.isCTVolteDisabled():  requires
#                             dynamic_ims_switch==1 && this==0 && isMatched(OP09)
#   ImsService.apk            ImsService.updateUtCapabilityChange(): reads it
#                             only inside `if (isMatched(OP09, phoneId))`
#   ImsService.apk            MtkSuppServExt$2.onReceive(): only inside
#                             `if (isOp(OP09))`
#   mediatek-ims-common.jar   MtkImsManager.factoryReset(): NOT operator-gated,
#                             but only reachable on a factory reset and only
#                             through MTK telephony injection, which this port
#                             does not wire up (E-081)
#
# HONEST LIMIT: this is static evidence -- disassembly and dex -- not a
# measurement. The tier-1 handset was not reflashed to compare, and the modem
# side of AT+ECFGSET is not observable from here. What is certain is that
# leaving it unset is an unconditional, silent divergence from stock in imsInit.
# TO REVERT: delete this line; the RIL falls back to "0", i.e. today's behaviour.
persist.vendor.mtk_ct_volte_support=1
# persist.vendor.mtk_dynamic_ims_switch is 1, as stock sets it
# (vendor/build.prop:119). An earlier revision set it to 0 to 'disable MTK's
# independent MCC/MNC resource switch'. That description is right and the
# choice was wrong: with the property not equal to "1",
# ImsConfigManager.updateImsResrouceCapability() takes its short branch and
# only calls updateImsServiceConfig, so IMtkImsConfig.setImsResCapability()
# is never called and the RIL is never asked to re-push IMS config to the
# modem for the SIM's MCC/MNC. Measured on the handset: with 0 the only
# lines are 'updateImsServiceConfig after SIM event'; with 1 the full path
# runs per slot,
#
#   ImsConfigManager: DYNAMIC_IMS_SWITCH_TRIGGER phoneId:0, simState:LOADED
#   ImsConfigManager: get MtkImsConfigImpl of phone 0
#   ImsConfigManager: Set res capability: volte = 1, vilte = 0, wfc = 0
#   ImsConfigManager: DYNAMIC_IMS_SWITCH_COMPLETE phoneId:0, simState:LOADED
#
# It did NOT by itself make IMS register (+CIREGU stayed 0), so this is a
# parity repair, not the VoLTE fix. It is kept because the path it enables
# is the one stock uses and because leaving it off silently skips the only
# per-operator IMS configuration this stack has.
persist.vendor.mtk_dynamic_ims_switch=1
# persist.vendor.mtk_wfc_support MUST be 1, exactly as stock sets it
# (vendor/build.prop:121). It reads like the WiFi-calling feature switch and it
# is not: it is MediaTek's ePDG-capable RIL build flag, and the AP-driven IMS
# PDN path is behind it. libmtkconfig.so's mtkGetFeatureByOs() maps feature id 6
# to this property; libmtkrilutils.so's isEpdgSupport() is literally
# `mtkGetFeature(6) == "1"`; and mtk-ril.so guards 36 sites on it, including the
# first two instructions of responseUnsolDataCallRspToMal (0xa9fe0), the ONLY
# function in the RIL that calls mal_datamngr_set_data_call_info{,_tlv}:
#
#   0x000aa010  bl  isEpdgSupport
#   0x000aa014  cbz w0, <epilogue>     ; MAL is never told the PDN went active
#
# With this at 0, AOSP's DcTracker brings the IMS PDN up correctly on ccmni4
# with the operator's P-CSCF pair, MAL never hears about it, and
# dm_get_ims_pdn_req refuses with "sim_id 0 interface id 4 for IMS in wrong
# state 1" -> IMSA_IMCB_PDN_ACT_REJ_RSP cause 31 -> IMCB retries every 12 s
# forever -> +CIREGU never leaves 0. Measured both ways on the handset (E-087):
# flipping this one bit takes that error from 130 occurrences per boot to 0 and
# gets the PDN to MSG_ID_WRAP_IMSM_IMSPA_PDN_ACT_COMPLETED.
#
# An earlier revision set it to 0 on the reasoning that VoWiFi was deferred so
# every WFC capability should be off. The reasoning was never checked against a
# reader. Do not "restore" the 0.
#
# The USER-FACING WiFi-calling switch is persist.vendor.mtk.wfc.enable, and it
# stays off. persist.vendor.wfc.sys_wfc_support is NOT that switch -- see below.
persist.vendor.mtk_wfc_support=1
persist.vendor.vilte_support=0
persist.vendor.viwifi_support=0
persist.vendor.volte_support=1
# persist.vendor.wfc.sys_wfc_support MUST be 1, exactly as stock sets it
# (system/etc/prop.default:45). This is the second half of trap 25 and it cost
# this project as much as the first: the name says "system WFC support" and the
# thing it actually gates is the ONLY producer of the IMS PDN's RAT.
#
# mtk-ril.so's queryEpdgRat (0x95028) is called from every requestSetupDataCall*
# variant. Its second gate is:
#
#   0x000950bc  bl  property_get      ; "persist.vendor.wfc.sys_wfc_support", "0"
#   0x000950c4  bl  atoi
#   0x000950c8  cbz w0, 0x952a8       ; -> "[queryEpdgRat] EPDG is not supported"
#
# and the bail-out returns 0 for both isHandOver and eran_type. The caller
# (requestSetupDataCallOverIPv6, with configEpdg's body inlined at 0x909b8)
# copies eran_type into the SETUP_DATA_CALL response struct, and
# responseUnsolDataCallRspToMal hands that to mal_datamngr_set_data_call_info_tlv.
# MAL's IMSM then reads eran_type == 0 out of the bearer record and refuses the
# PDN activation confirm:
#
#   MAL-IMSM: pdn cnt = 1, eran_type = 0, if_name = ccmni4  (imsm_handler.c:3978)
#   MAL-IMSM: rat error!!                                   (imsm_handler.c:4085)
#   MAL-IMSM: get cell info fail, need retry, ret = 0, nw_cell_info.status = 1
#                                                           (imsm_handler.c:4141)
#
# ...and that last line is an UNBOUNDED retry loop: ~42 iterations per second,
# ~640 log lines per second, forever. It wraps a 16 MiB logcat ring in about
# 90 s, which is why every post-hoc `logcat -d` diagnosis of this bug was
# reading a window that no longer contained the cause.
#
# Measured on the handset, one variable, nothing else changed (E-091):
#
#   sys_wfc_support=0  ->  queryEpdgRat: "EPDG is not supported"
#                          epdgConfig, isHandOver: 0, eran_type: 0
#                          rat error!! x3835 in 89 s, +CIREGU: 0
#
#   sys_wfc_support=1  ->  queryEpdgRat: rsp status: 0, rsp rat: 1, request rat: 0
#                          queryEpdgRat: setup thru mobile, islteonly:1
#                          epdgConfig, isHandOver: 0, eran_type: 1
#                          responseUnsolDataCallRspToMal eran_type:1, cause:0
#                          Call mal_datamngr_set_data_call_info_tlv success
#                          rat error!! stops
#                          AT< +CIREGU: 1,5          <-- IMS REGISTERED
#
# VoLTE on this platform cannot be had without the ePDG feature enabled. The
# data plane and framework WFC gates now ship; actual IWLAN selection still
# depends on the user's setting, an IWLAN-capable IMS APN, and carrier ePDG
# provisioning (E-101).
persist.vendor.wfc.sys_wfc_support=1
# ro.vendor.mtk_telephony_add_on_policy MUST be 0, exactly as stock sets it in
# /system/etc/prop.default. An earlier revision set it to 1 with the comment "skip
# absent extension/legacy jars and use the APK's built-in base factories",
# which is a fair description of what it does and a fatal choice, because the
# built-in base factory does not implement anything:
#
#   MtkMmTelFeature.getUt()
#     -> supportMdAutoSetupIms() is false (md_auto_setup_ims=0)
#     -> ExtensionFactory.makeLegacyComponentFactory(): with add_on_policy != 0
#        the PathClassLoader("/system/framework/mediatek-ims-legacy.jar") branch
#        is skipped entirely, so it returns a LegacyComponentFactoryBase
#     -> LegacyComponentFactoryBase.makeImsUt() is literally `return null`
#     -> MtkMmTelFeature.getUtInterface() returns null
#     -> ImsManager.getSupplementaryServiceConfiguration() throws
#        CODE_UT_NOT_SUPPORTED (801)
#     -> ImsPhoneCallTracker.startListeningForCalls() throws at `mUtInterface =
#        getUtInterface()`, so updateImsServiceConfig(true) and
#        sendImsServiceStateIntent(ACTION_IMS_SERVICE_UP) below it never run
#     -> ImsManager.Connector.notifyReady() rethrows -> notifyNotReady() ->
#        stopListeningForCalls() -> retryGetImsService(), forever.
#
# CAPABILITY_TYPE_VOICE is therefore never enabled on the MmTelFeature and the
# MTK stack is never told to register. Observed on the handset as
# startListeningForCalls immediately followed by stopListeningForCalls and
# isVolteEnabled=false, repeating on both slots for the whole uptime -- with two
# SIMs LOADED. No amount of carrier config or signal can rescue it.
#
# The legacy jar and stock extension plugin are now shipped with their complete
# six-boot-jar MTK type closure (proprietary-files.txt, `ims` section). The old
# four-class UT/XCAP gap is gone. wwop-common remains deliberately absent until
# its radio_op native HAL is evaluated as one unit; loading half that reflected
# path would be worse than using DefaultOpImsRIL.
#
# TO REVERT if com.android.phone misbehaves: set this back to 1. That restores
# exactly today's behaviour (no VoLTE, but a stable phone process) in one line.
#
# md_auto_setup_ims stays 0. Setting it to 1 would also fix getUt(), and is the
# wrong lever: it is read at 42 other sites in the APK plus GbaManager, and
# switches the whole stack to the Gen93 modem-driven IMS setup path on a Gen91
# MT6755.
ro.vendor.mtk_telephony_add_on_policy=0
ro.vendor.md_auto_setup_ims=0
# ro.vendor.md_mims_support=1 used to be the next line. It is DELETED, because
# setting it here inverts a runtime data flow and permanently wedges it.
#
# The property is in NONE of stock's nine prop files, and yet stock's runtime
# getprop reads [ro.vendor.md_mims_support]: [1]. Something publishes it. That
# something is mtk-rilproxy.so, which contains the string FOUR times and every
# one of them is a WRITE (aarch64, key at vaddr 0x97ae0):
#
#   RpImsController::onInit()        0x00184e40  bl property_set
#   RpImsController::sync_mims_capa()0x001853f4  bl property_set
#
# (each is a two-way value select converging on one call; there is no
# property_get of this key anywhere in the blob). The consumer is on the
# framework side: ImsService.apk, com/mediatek/ims/ImsService, reads it with
# SystemProperties.getInt as ImsConstants.PROPERTY_MD_MULTI_IMS_SUPPORT.
# Producer -> consumer, RIL -> IMS APK.
#
# ro.* is write-once on Q: property_service.cpp:197-202 returns
# PROP_ERROR_READ_ONLY_PROPERTY, "Read-only property was already set", for any
# second set. /vendor/build.prop is loaded in PropertyLoadBootDefaults
# (property_service.cpp:910), long before rild starts, so with this line present
# BOTH of the RIL's writes fail -- including sync_mims_capa(), whose whole job
# is to re-publish the value when the modem's multi-IMS capability CHANGES.
# ImsService would then read a permanently frozen number.
#
# It has produced a visible artefact once already: E-035 records
#   avc:  denied  { set } for property=ro.vendor.md_mims_support
#         scontext=u:r:rild:s0 tcontext=u:object_r:mtk_ims_prop:s0
# i.e. the RIL really does attempt this write on this build. That denial is
# closed in sepolicy now, so the write reaches property_service -- and is
# rejected by the read-only check instead.
#
# No symptom today only because the value the RIL derives happens to equal the 1
# that was hardcoded. Deleting restores stock's arrangement exactly, and the
# boot-order worry is stock's own: RpImsController::onInit() runs at RIL proxy
# init, well before ImsService binds, which is why stock reads back 1.
#
# END of the md_mims_support note. The property below is unrelated to it.

# ro.vendor.md_prop_ver (vendor/build.prop:60). The modem property-table
# revision, and not a cosmetic version string: eight shipped binaries carry the
# name -- vendor/bin/{mtkmal,epdg_wod} and vendor/lib{,64}/{libmal,libmdfx,
# libmal_rds}.so -- and epdg_wod is on that list, which is why it matters to
# the ePDG stack and not only to MAL.
ro.vendor.md_prop_ver=1

ro.vendor.net.upload.benchmark.default=blocking
ro.vendor.md_apps.load_gencfg=GEN91_USER
ro.vendor.md_apps.load_type=user
ro.vendor.md_apps.load_verno=MOLY.LR11.W1630.MD.MP.V191.4
ro.vendor.md_apps.support=1
# ro.vendor.md_log_memdump_wait=15, exactly as stock sets it
# (vendor/build.prop:394). Sole consumer, and it is a shipped one:
# vendor/bin/ccci_mdinit, the modem bring-up daemon, which imports both
# property_get and property_set. The value is a seconds budget for waiting on a
# modem memory dump; unset, ccci_mdinit takes its built-in default instead of
# stock's, on a platform whose modem is the active problem. Added under this
# file's own rule -- a stock property with a shipped consumer is not decoration.
ro.vendor.md_log_memdump_wait=15
ro.vendor.mediatek.platform=MT6755
ro.vendor.mtk_aal_support=1
ro.vendor.mtk_agps_app=1
ro.vendor.mtk_audio_alac_support=1
ro.vendor.mtk_audio_ape_support=1
ro.vendor.mtk_audio_tuning_tool_ver=V2.2
ro.vendor.mtk_besloudness_support=1
ro.vendor.mtk_camera_app_version=1
# The next three are stock values this tree had dropped. Each is here because a
# shipped blob reads it, named below; none is here because stock happens to set
# it. Consumers were established with `readelf -W --dyn-syms` for the property
# accessor plus a raw string search -- note that the string search must be a
# BINARY-safe grep (ugrep skips binary files by default and returns nothing) and
# must unzip jars/apks, because ImsService.apk stores its classes.dex DEFLATED
# and no raw grep can see inside it.
#
# ro.vendor.mtk_config_max_dram_size (vendor/build.prop:55) sizes codec buffers.
# Four consumers, three native and one that a raw grep cannot see:
#   vendor/lib/libMtkOmxVdecEx.so   UND property_get
#   vendor/lib/libMtkOmxVenc.so     UND property_get
#   vendor/lib/libvcodecdrv.so      UND property_get
#   ImsService.apk                  ImsVTProviderUtil, SystemProperties.get with
#                                   a hardcoded fallback of "0x40000000" -- a
#                                   thirty-second of the real value, so the
#                                   video-call path was sizing against 1 GiB.
ro.vendor.mtk_config_max_dram_size=0x800000000
# ro.vendor.mtk_eccci_c2k (vendor/build.prop:61). Read by libcustom_nvram.so --
# BOTH ABIs, vendor/lib and vendor/lib64, each UND property_get, neither with
# any property_set. It selects the C2K ECCCI NVRAM layout.
ro.vendor.mtk_eccci_c2k=1
# ro.vendor.mtk_embms_support (vendor/build.prop:371). Exactly one consumer, and
# it is loaded on this build: mtk-rilproxy.so, which the RIL shim dlopens. Two
# call sites, both a plain read compared against the literal "1":
#   RpEmbmsAtController::isEmbmsSupported()  0x00188510 -> property_get
#   RpEmbmsUtils::isEmbmsSupport()           0x0018c680 -> property_get
# Unlike ro.vendor.mtk_modem_monitor_support, which stays out because its only
# reader (EngineerMode.apk) is not shipped, this reader IS shipped and running.
# No eMBMS middleware ships, so nothing will call the API and the controller
# simply reports the modem's real capability instead of a false negative.
ro.vendor.mtk_embms_support=1
ro.vendor.mtk_emmc_support=1
ro.vendor.mtk_f2fs_enable=0
ro.vendor.mtk_fd_support=1
ro.vendor.mtk_gps_support=1
ro.vendor.mtk_log_hide_gps=0
ro.vendor.mtk_md1_support=10
ro.vendor.mtk_pq_color_mode=1
ro.vendor.mtk_pq_support=2
ro.vendor.mtk_protocol1_rat_config=Lf/Lt/W/T/G
ro.vendor.mtk_ril_mode=c6m_3rild
ro.vendor.mtk_zsdhdr_support=1
ro.vendor.radio.max.multisim=dsds
ro.vendor.wlan.gen=gen2

# Hardware facts that describe this chassis, kept on /vendor so a system-only
# OTA or a GSI boot cannot contradict them. Moved here from device.mk's
# PRODUCT_SYSTEM_DEFAULT_PROPERTIES, which put them on /system.
#
# ro.hardware.egl names the vendor GL driver loaded from /vendor/lib*/egl/.
# ro.frp.pst is a vendor block-device path.
# ro.opengles.version 196610 = ES 3.2, corroborated by GL_ANDROID_extension_pack_es31a
#   in the live GL extension string.
# The four telephony keys are modem topology: two physical SIM slots, DSDS,
# LTE/GSM/WCDMA on protocol stack 1, GSM/WCDMA (WCDMA preferred) on fixed
# protocol stack 2, and IWLAN in legacy mode. The RIL shim publishes the same
# per-socket capability split and absorbs AOSP's impossible request to swap it.
ro.hardware.egl=mali
ro.frp.pst=/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/frp
ro.opengles.version=196610
persist.radio.multisim.config=dsds
# Not decoration and not redundant with the line above: epdg_wod reads THIS one
# to size a per-SIM array, and it reads it before mtk-ril.so writes it. See the
# long block further down for the crash that costs. Same value, by construction.
persist.vendor.radio.msimmode=dsds
# ro.telephony.sim.count is deliberately NOT set. It is declared once at
# TelephonyProperties.java and read by nothing in frameworks/ or packages/;
# TelephonyManager.getPhoneCount() goes through persist.radio.multisim.config
# above. Setting it made the slot count look like it had two sources.
ro.telephony.default_network=9,0
ro.telephony.iwlan_operation_mode=legacy

# MediaTek RIL topology that stock sets and this tree had dropped.
#
# These values were injected at runtime on the two non-roaming Chinese SIMs and
# did not make those subscriptions register; the changed AT+EMSR reply proves
# they reached the blob. That experiment did NOT exercise the Dutch SIM's
# failing slot-1 max-RAF transfer, so their boot-time effect there is unproven.
# They remain required regressions against stock with real consumers. See E-058.
#
# Only the eleven with a consumer in the shipped blob set are here. Four that
# stock also sets are deliberately omitted, but NOT all for the same reason,
# and an earlier revision of this comment got two of them wrong by grepping
# the blobs with a method that cannot see compressed dex:
#
#   ro.vendor.num_md_protocol           genuinely has no reader anywhere.
#   ro.vendor.mtk_modem_monitor_support  only EngineerMode.apk reads it, which
#                                        this build does not ship, and setting
#                                        it would advertise an md_monitor that
#                                        is also not shipped.
#   persist.vendor.mtk_sim_switch_policy DOES have a reader:
#                                        MtkTelephonyComponentFactory's
#                                        datasub.CapabilitySwitch reads it in
#                                        mediatek-telephony-common.jar, which
#                                        this ROM ships AND boot-classpaths.
#   ro.vendor.sim_refresh_reset_by_modem DOES have a reader: MtkSIMRecords
#                                        .handleRefresh() in the same jar.
#
# The last two stay out anyway, for a reason worth stating once: those classes
# are only reachable through MediaTek's telephony framework, which this port
# does not wire up (E-081: 'Total components injected: 0'), so they are dead on
# this image. If MTK telephony injection is ever added, revisit both.
# The rule itself is unchanged -- a property with no reader is decoration --
# but the SEARCH for a reader must unzip jars and apks and strings the dex, not
# grep the file. Two further method notes, both of which cost real time here:
# the search must use a BINARY-safe grep (ugrep, which `grep` resolves to on the
# build host, skips binary files by default and reports nothing at all), and
# unzipping is not optional for ImsService.apk specifically -- it is the one
# archive of ten whose classes.dex is DEFLATED rather than stored, so it is
# invisible to a raw scan of the blob tree even when the other nine are not.
#
# persist.vendor.mtk_ct_volte_support used to be listed here as a third
# deliberate omission. It is NOT omitted any more -- see its own block near the
# top of this file, and the reason it was wrong to omit it.
#
# persist.vendor.radio.msimmode WAS excluded explicitly, and that was WRONG.
# It is set now, beside persist.radio.multisim.config, and this block is kept
# because the reasoning below is still correct about who writes it and the trap
# it teaches is still worth having. What it missed is the one question nobody
# asked: not "does anything read it" but "does anything read it BEFORE the
# writer runs".
#
# Something does, and it crashes. epdg_wod's wo_get_sim_count() (0x9b58) reads
# ro.vendor.md_prop_ver, sees 1, and therefore reads
# persist.vendor.radio.msimmode -- NOT persist.radio.multisim.config -- to size
# a per-SIM client array with one malloc'd element per slot. On a first boot
# after a userdata wipe the persisted store is empty, and the writer described
# below (mtk-ril.so's RIL_Init) does not run until vendor.ril-daemon-mtk starts,
# which is 3.3 s AFTER vendor.epdg_wod's `class late_start`. Measured here:
#
#   09:03:26.637  starting service 'vendor.epdg_wod'       <- msimmode empty, N=1
#   09:03:29.943  starting service 'vendor.ril-daemon-mtk' <- writes msimmode
#   09:06:47.186  MAL-EPDGA send to ePDGd: wosbp=1,6,460,00    <- slot 1
#   09:06:47.188  F libc: Fatal signal 11 ... fault addr 0x7062736f77
#
# 0x7062736f77 is the five ASCII bytes "wosbp": epdg_wod indexes
# ctx->clients[slot] with the slot number straight off the wire and NO bounds
# check (0xcde0; ctx->count at ctx+0x70 is never consulted), so clients[1] on a
# one-element array reads the adjacent jemalloc region -- which happens to be
# the message's own strdup'd type string. It then strcmp()s it.
#
# The daemon self-heals: init restarts it, and the restarted instance reads
# msimmode=dsds and logs `[CFG] Reset settings[0]` AND `[1]`. But it costs a
# tombstone and ~1.3 s of downtime on every wipe-flash, deterministically, and
# the missing bounds check is in the blob where nothing can reach it. Setting
# the property at build time is the only lever this device has over that count.
# Verify after a wipe-flash by finding `Reset  settings[1] to default` in
# epdg_wod's FIRST startup log.
#
# It cannot diverge from the runtime value: the call sites below derive it from
# persist.radio.multisim.config (dsds), and both second-stage selectors
# (ro.boot.opt_sim_count, persist.vendor.radio.multisimslot) are empty here, so
# only the first property_set runs and writes the same dsds.
#
# The old text: "the five shipped blobs that name it (libmal.so 32/64,
# libmal_rds.so, libmal_simmngr.so, libmtkrilutils.so, mtk-ril.so) import
# property_get and never property_set". Three of those can write properties:
#
#   readelf -W --dyn-syms vendor/lib/libmal_rds.so
#     151: UND property_set          (and it exports legacy_rds_property_set,
#                                     rds_property_set of its own)
#   readelf -W --dyn-syms vendor/lib64/mtk-ril.so
#      67: UND property_set          126: UND setMSimProperty
#                                    127: UND setMSimPropertyThreadSafe
#   readelf -W --dyn-syms vendor/lib64/libmtkrilutils.so
#      35: UND mtk_property_set      183: DEF setMSimProperty
#      11: UND mtk_property_get       69: DEF setMSimPropertyThreadSafe
#
# THE CONCLUSION SURVIVES AND IS NOW PROVEN RATHER THAN INFERRED. mtk-ril.so is
# the writer, and it derives the value from the key immediately above:
#
#   RIL_Init, vendor/lib64/mtk-ril.so (aarch64)
#     0x00054fd0  bl property_get   ; "persist.radio.multisim.config", def "dsds"
#     0x00054fe0  bl property_set   ; "persist.vendor.radio.msimmode" <- that value
#     0x00054ff4  bl memcmp         ; == "dsda" ? done
#     0x00055010  bl property_get   ; "ro.boot.opt_sim_count", def "0"
#     0x00055034  bl property_get   ; "persist.vendor.radio.multisimslot", def "0"
#     0x0005505c  br x10            ; 4-way table -> "ss"/"dsds"/"tsts"/"qsqs"
#     0x000550ac  bl property_set   ; "persist.vendor.radio.msimmode" <- literal
#
# and libmtkrilutils.so is a reader: one reference to the string, inside
# getSimCount at 0xae24, feeding mtk_property_get. On this handset both
# selectors are unset (ro.boot.opt_sim_count and
# persist.vendor.radio.multisimslot are empty), so the second stage is skipped
# and only the first property_set runs -- which is exactly why the measured
# value tracks persist.radio.multisim.config=dsds. It is also present in
# /data/property/persistent_properties, i.e. written after boot by a process,
# not loaded from build.prop, which independently confirms the write.
#
# THE GENERALISABLE TRAP, corrected. The audit that found this said an
# `nm -D | grep property_set` sweep would miss libmtkrilutils.so because the
# symbol is mtk_property_set. It would not -- grep is a substring match and
# matches it fine; only `grep -w property_set` (or an anchored pattern) misses
# it, which is verifiable in one line. The real traps are two others:
#   1. MediaTek wraps property access under its own names -- mtk_property_set,
#      rds_property_set, legacy_rds_property_set, setMSimProperty,
#      setMSimPropertyThreadSafe -- so an EXACT-symbol sweep sees nothing.
#   2. More important: the symbol table cannot tell a reader from a writer at
#      all. Every blob above imports property_get; five of six also touch a
#      setter. Only the CALL SITE settles it. String-presence plus
#      symbol-import is a way to build a candidate list, never a conclusion.
#
# The consumer of each, from a grep of the vendor blob set:
#   mtk_ps1_rat             thermal, libratconfig.so, audio.primary.mt6755.so
#   mtk_ps2_rat             mtk-ril.so, mtk-rilproxy.so, libmtkrilutils.so
#   mtk_lte_support         libmtkrilutils.so
#   mtk_md_world_mode_support  mtk-ril.so, mtk-rilproxy.so
#   mtk_world_phone_policy  mtk-ril.so
#   mtk_flight_mode_power_off_md  mtk_agpsd, mtk-ril.so
#   mtk_dsbp_support        libmal_nwmngr.so, mtk-ril.so, libmtkrilutils.so
#   mtk_c2k_lte_mode        mtk-rilproxy.so, libmtkrilutils.so
#   mtk_external_sim_only_slots  libmtkrilutils.so
#   sim_me_lock_mode        mtk-rilproxy.so, mtk-ril.so
#   radio.fd.*              mtk-ril.so
#
# mtk_ps2_rat is the one with a visible consequence today: slot 1 comes up
# GSM-only (the modem reports rcRil.raf=65536, HAL bit 16), so the second SIM
# cannot use 3G at all. That is MediaTek's DSDS capability split and slot 1 is
# never getting LTE, but W/G is what stock gives it and G is what it has now.
#
# mtk_flight_mode_power_off_md is the other one worth naming: it decides whether
# flight mode powers the modem down, and this build has a report of flight mode
# not taking effect while a call was wedged.
ro.vendor.mtk_ps1_rat=Lf/Lt/W/T/G
persist.vendor.radio.mtk_ps2_rat=W/G
ro.vendor.mtk_lte_support=1
ro.vendor.mtk_md_world_mode_support=1
ro.vendor.mtk_world_phone_policy=0
ro.vendor.mtk_flight_mode_power_off_md=1
persist.vendor.radio.mtk_dsbp_support=1
ro.vendor.mtk_c2k_lte_mode=0
ro.vendor.mtk_external_sim_only_slots=0
ro.vendor.sim_me_lock_mode=0
persist.vendor.radio.fd.counter=150
persist.vendor.radio.fd.off.counter=50
persist.vendor.radio.fd.off.r8.counter=50
persist.vendor.radio.fd.r8.counter=150
