<?xml version="1.0" encoding="utf-8"?>
<compatibility-matrix version="1.0" type="device">
    <hal format="hidl" optional="false">
        <name>android.frameworks.schedulerservice</name>
        <version>1.0</version>
    </hal>
    <hal format="hidl" optional="false">
        <name>android.frameworks.sensorservice</name>
        <version>1.0</version>
    </hal>
    <hal format="hidl" optional="false">
        <name>android.hidl.allocator</name>
        <version>1.0</version>
    </hal>
    <hal format="hidl" optional="false">
        <name>android.hidl.manager</name>
        <version>1.0</version>
        <!-- The <interface> block is what makes this a real requirement.
             MatrixHal.cpp:118-127: when a matrix HAL yields no instance,
             libvintf degrades the check to "compatibility matrix doesn't
             specify any instances. Check versions only." AOSP's own
             device_compatibility_matrix.default.xml carries it, so dropping it
             here made this device matrix WEAKER than the default it replaces.
             Every other entry below is a genuine version-presence requirement
             under that same rule and needs no instance. -->
        <interface>
            <name>IServiceManager</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="false">
        <name>android.hidl.memory</name>
        <version>1.0</version>
    </hal>
    <hal format="hidl" optional="false">
        <name>android.hidl.token</name>
        <version>1.0</version>
    </hal>
    <hal format="hidl" optional="false">
        <name>android.system.wifi.keystore</name>
        <version>1.0</version>
    </hal>
    <!-- No <vendor-ndk> and no <system-sdk> here on purpose.

         assemble_vintf injects both from the board configuration:
         system/libhidl/vintfdata/Android.mk:55-62 passes REQUIRED_VNDK_VERSION
         (from BOARD_VNDK_VERSION) and BOARD_SYSTEMSDK_VERSIONS, and AOSP's own
         device_compatibility_matrix.default.xml declares neither.

         Hardcoding them is not symmetric. AssembleVintf.cpp:520-536 HARD-ERRORS
         if <vendor-ndk> disagrees with REQUIRED_VNDK_VERSION, but merges
         <system-sdk> into a std::set: a UNION, with no check. So a hardcoded
         <system-sdk>28 left behind after someone bumps BOARD_SYSTEMSDK_VERSIONS
         to 29 silently ships a matrix demanding BOTH, with no diagnostic
         anywhere. BoardConfig.mk is the single source for both. -->
</compatibility-matrix>
