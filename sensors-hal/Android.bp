// SPDX-License-Identifier: Apache-2.0
cc_binary {
    name: "android.hardware.sensors@2.0-service",
    defaults: ["hidl_defaults"],
    vendor: true,
    relative_install_path: "hw",
    compile_multilib: "64",
    srcs: [
        "SensorsSubHal.cpp",
        "multihal/service.cpp",
        "multihal/HalProxy.cpp",
        "multihal/ScopedWakelock.cpp",
    ],
    local_include_dirs: ["multihal/include"],
    cflags: ["-DLOG_TAG=\"SensorsLegacyMultiHal\"", "-Wall", "-Werror"],
    shared_libs: [
        "android.hardware.sensors@1.0",
        "android.hardware.sensors@2.0",
        "libbase",
        "libcutils",
        "libfmq",
        "libhardware",
        "libhidlbase",
        "libhidltransport",
        "liblog",
        "libpower",
        "libutils",
    ],
    static_libs: ["android.hardware.sensors@1.0-convert"],
}
